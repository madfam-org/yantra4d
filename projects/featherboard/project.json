  "parameter_groups": [
    {
      "id": "fingers",
      "label": {
        "en": "Feather Fingers",
        "es": "Dedos del Peine"
      }
    },
    {
      "id": "body",
      "label": {
        "en": "Body",
        "es": "Cuerpo"
      }
    }
  ],
  "parameters": [
    {
      "id": "feather_n",
      "type": "slider",
      "default": 12,
      "min": 5,
      "max": 24,
      "step": 1,
      "group": "fingers",
      "modes": [
        "tslot_feather",
        "miter_feather",
        "clamp_feather"
      ],
      "label": {
        "en": "Finger Count",
        "es": "Número de Dedos"
      },
      "tooltip": {
        "en": "Number of flexible fingers in the bank",
        "es": "Número de dedos flexibles del banco"
      }
    },
    {
      "id": "kerf",
      "type": "slider",
      "default": 1.6,
      "min": 0.8,
      "max": 4.0,
      "step": 0.1,
      "group": "fingers",
      "modes": [
        "tslot_feather",
        "miter_feather",
        "clamp_feather"
      ],
      "label": {
        "en": "Finger Kerf / Gap (mm)",
        "es": "Kerf / Hueco entre Dedos (mm)"
      },
      "tooltip": {
        "en": "Slot width between fingers — controls flex",
        "es": "Ancho de ranura entre dedos — controla la flexión"
      }
    },
    {
      "id": "finger_ang",
      "type": "slider",
      "default": 30.0,
      "min": 10.0,
      "max": 50.0,
      "step": 1.0,
      "group": "fingers",
      "modes": [
        "tslot_feather",
        "miter_feather",
        "clamp_feather"
      ],
      "label": {
        "en": "Rake Angle (deg)",
        "es": "Ángulo de Ataque (°)"
      },
      "tooltip": {
        "en": "Finger lean — the one-way grip direction",
        "es": "Inclinación de los dedos — la dirección de agarre unidireccional"
      }
    },
    {
      "id": "finger_len",
      "type": "slider",
      "default": 35.0,
      "min": 20.0,
      "max": 60.0,
      "step": 1.0,
      "group": "fingers",
      "modes": [
        "tslot_feather",
        "miter_feather",
        "clamp_feather"
      ],
      "label": {
        "en": "Finger Length (mm)",
        "es": "Largo de los Dedos (mm)"
      },
      "tooltip": {
        "en": "Length of the flexing fingers",
        "es": "Largo de los dedos que flexan"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "y",
        "scale_factor": 1.0
      }
    },
    {
      "id": "body_w",
      "type": "slider",
      "default": 90.0,
      "min": 50.0,
      "max": 150.0,
      "step": 1.0,
      "group": "body",
      "modes": [
        "tslot_feather",
        "miter_feather",
        "clamp_feather"
      ],
      "label": {
        "en": "Bank Width (mm)",
        "es": "Ancho del Banco (mm)"
      },
      "tooltip": {
        "en": "Overall width of the feather bank",
        "es": "Ancho total del banco de dedos"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "x",
        "scale_factor": 1.0
      }
    },
    {
      "id": "body_len",
      "type": "slider",
      "default": 70.0,
      "min": 40.0,
      "max": 120.0,
      "step": 1.0,
      "group": "body",
      "modes": [
        "tslot_feather",
        "miter_feather",
        "clamp_feather"
      ],
      "label": {
        "en": "Body Length (mm)",
        "es": "Largo del Cuerpo (mm)"
      },
      "tooltip": {
        "en": "Length of the mounting body behind the fingers",
        "es": "Largo del cuerpo de montaje detrás de los dedos"
      }
    },
    {
      "id": "thick",
      "type": "slider",
      "default": 9.0,
      "min": 5.0,
      "max": 18.0,
      "step": 0.5,
      "group": "body",
      "modes": [
        "tslot_feather",
        "miter_feather",
        "clamp_feather"
      ],
      "label": {
        "en": "Board Thickness (mm)",
        "es": "Grosor de la Tabla (mm)"
      },
      "tooltip": {
        "en": "Thickness of the featherboard",
        "es": "Grosor del peine"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "z",
        "scale_factor": 1.0
      }
    }
  ],
  "presets": [
    {
      "id": "table_saw_tslot",
      "mode": "tslot_feather",
      "label": {
        "en": "Table-Saw Fence (T-Slot)",
        "es": "Tope de Sierra (Ranura en T)"
      },
      "values": {
        "feather_n": 12,
        "kerf": 1.6,
        "finger_ang": 30.0,
        "body_w": 90.0
      }
    },
    {
      "id": "router_miter",
      "mode": "miter_feather",
      "label": {
        "en": "Router Table Miter Bar",
        "es": "Barra de Inglete para Router"
      },
      "values": {
        "feather_n": 14,
        "kerf": 1.4,
        "finger_ang": 25.0,
        "body_w": 100.0
      }
    },
    {
      "id": "bandsaw_clamp",
      "mode": "clamp_feather",
      "label": {
        "en": "Band-Saw Clamp-On",
        "es": "Sujeción para Sierra de Cinta"
      },
      "values": {
        "feather_n": 10,
        "kerf": 2.0,
        "finger_ang": 35.0,
        "body_w": 80.0
      }
    }
  ],
  "constraints": [
    {
      "expression": "kerf < body_w / feather_n",
      "severity": "error",
      "message": {
        "en": "Kerf is too wide — no material left for fingers",
        "es": "El kerf es demasiado ancho — no queda material para los dedos"
      }
    },
    {
      "expression": "finger_ang <= 45",
      "severity": "warning",
      "message": {
        "en": "Very steep rake may bind the workpiece",
        "es": "Un ángulo de ataque muy pronunciado puede atascar la pieza"
      }
    }
  ],
