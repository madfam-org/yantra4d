      "label": { "en": "Mini Pockets", "es": "Bolsillos Mini" },
      "tooltip": { "en": "Number of Mini (APM/ATM) blade-fuse pockets (body 10.9 mm, pitch 5.1 mm)", "es": "Número de bolsillos de fusible Mini (APM/ATM) (cuerpo 10.9 mm, paso 5.1 mm)" }
    },
    {
      "id": "screw_d", "type": "slider", "default": 4.2, "min": 2.5, "max": 8.0, "step": 0.1,
      "group": "mount", "modes": ["dongle_holder", "obd_bracket"],
      "label": { "en": "Screw Hole (mm)", "es": "Orificio de Tornillo (mm)" },
      "tooltip": { "en": "Mounting screw clearance (M4 ~4.2 mm)", "es": "Holgura de tornillo de montaje (M4 ~4.2 mm)" }
    }
