  "hyperobject": {
    "domain": "medical",
    "cdg_interfaces": [
      {
        "id": "card_page_groove",
        "label": {
          "en": "Card / Page Groove",
          "es": "Ranura de Carta / Página"
        },
        "geometry_type": "profile",
        "standard": "playing card 63x88mm",
        "parameters": [
          "card_t",
          "groove_gap",
          "groove_ang"
        ],
        "compatible_with": [
          "deck-box"
        ]
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "Fanning and holding a hand of cards, or keeping a book or recipe open, are small pleasures and daily tasks that arthritis, tremor, hemiplegia, or a missing hand can take away. A holder sized to standard cards and common books lets someone play, read, and cook one-handed and unaided — a low-cost restoration of leisure and independence that can be reprinted and re-shared freely.",
      "es": "Abanicar y sostener una mano de cartas, o mantener un libro o receta abiertos, son pequeños placeres y tareas diarias que la artritis, el temblor, la hemiplejía o la falta de una mano pueden quitar. Un soporte dimensionado a cartas estándar y libros comunes permite jugar, leer y cocinar con una sola mano y sin ayuda — una restauración de bajo costo del ocio y la independencia que puede reimprimirse y recompartirse libremente."
    },
