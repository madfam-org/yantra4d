{
  "project": {
    "name": "Tool Holder (CNC / Lathe)",
    "slug": "tool-holder",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A shop organizer that holds cutting tools by their shank. A block carries an array of correctly-sized bores or pockets for the selected tool family — straight-shank end mills, ER collets, indexable lathe inserts, or a graduated drill index — and can be freestanding, wall-mounted, or dropped into a drawer as a low tray.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Un organizador de taller que sujeta herramientas de corte por su vástago. Un bloque lleva un arreglo de orificios o cavidades del tamaño correcto para la familia de herramienta seleccionada — fresas de vástago recto, boquillas ER, insertos de torno o un índice graduado de brocas — y puede ser independiente, montado en pared o colocado en un cajón como bandeja baja.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/tool-holder.webp",
    "difficulty": "intermediate",
    "tags": ["tool-holder", "cnc", "lathe", "end-mill", "er-collet", "drill-index", "shop-organization", "industrial", "hyperobject", "commons"],
