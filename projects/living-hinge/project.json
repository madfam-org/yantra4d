      "id": "panels",
      "label": {
        "en": "Panels",
        "es": "Paneles"
      }
    },
    {
      "id": "hinge",
      "label": {
        "en": "Hinge",
        "es": "Bisagra"
      }
    },
    {
      "id": "segmented",
      "label": {
        "en": "Segmented Options",
        "es": "Opciones Segmentadas"
      }
    }
  ],
  "parameters": [
    {
      "id": "hinge_type",
      "type": "select",
      "default": "thin_web",
      "group": "hinge",
      "modes": [
        "web_hinge",
        "segmented_hinge",
        "box_corner"
      ],
      "label": {
        "en": "Hinge Type",
        "es": "Tipo de Bisagra"
      },
      "tooltip": {
        "en": "Thin web (a continuous flexing membrane), segmented (alternating cut slots that curl), or coiled (a rolled knuckle)",
        "es": "Membrana delgada (una película continua que flexiona), segmentada (ranuras alternas que se enrollan) o enrollada (un nudo)"
      },
      "options": [
        {
          "value": "thin_web",
          "label": {
            "en": "Thin Web",
            "es": "Membrana Delgada"
          }
        },
        {
          "value": "segmented",
          "label": {
            "en": "Segmented",
            "es": "Segmentada"
          }
        },
        {
          "value": "coiled",
          "label": {
            "en": "Coiled Knuckle",
            "es": "Nudo Enrollado"
          }
        }
      ]
    },
    {
      "id": "panel_w",
      "type": "slider",
      "default": 60,
      "min": 15,
      "max": 200,
      "step": 1,
      "group": "panels",
      "modes": [
        "web_hinge",
        "segmented_hinge",
        "box_corner"
      ],
      "label": {
        "en": "Panel Width (mm)",
        "es": "Ancho del Panel (mm)"
      },
      "tooltip": {
        "en": "Length of the fold line (Y span shared by both panels)",
        "es": "Longitud de la línea de doblez (span Y compartido por ambos paneles)"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "y",
        "scale_factor": 1.0
      }
    },
    {
      "id": "panel_len",
      "type": "slider",
      "default": 40,
      "min": 10,
      "max": 150,
      "step": 1,
      "group": "panels",
      "modes": [
        "web_hinge",
        "segmented_hinge",
        "box_corner"
      ],
      "label": {
        "en": "Panel Length each (mm)",
        "es": "Longitud de cada Panel (mm)"
      },
      "tooltip": {
        "en": "Length of each panel on either side of the hinge",
        "es": "Longitud de cada panel a cada lado de la bisagra"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "x",
        "scale_factor": 1.0
      }
    },
    {
      "id": "panel_thick",
      "type": "slider",
      "default": 3.0,
      "min": 1.0,
      "max": 8.0,
      "step": 0.2,
      "group": "panels",
      "modes": [
        "web_hinge",
        "segmented_hinge",
        "box_corner"
      ],
      "label": {
        "en": "Panel Thickness (mm)",
        "es": "Grosor del Panel (mm)"
      },
      "tooltip": {
        "en": "Thickness of the rigid panels",
        "es": "Grosor de los paneles rígidos"
      }
    },
    {
      "id": "web_thick",
      "type": "slider",
      "default": 0.5,
      "min": 0.2,
      "max": 1.2,
      "step": 0.05,
      "group": "hinge",
      "modes": [
        "web_hinge",
        "box_corner"
      ],
      "label": {
        "en": "Web Thickness (mm)",
        "es": "Grosor de Membrana (mm)"
      },
      "tooltip": {
        "en": "Thickness of the flexing membrane (0.4-0.6 mm flexes best in PLA/PETG)",
        "es": "Grosor de la película que flexiona (0.4-0.6 mm flexiona mejor en PLA/PETG)"
      }
    },
    {
      "id": "hinge_len",
      "type": "slider",
      "default": 8.0,
      "min": 2.0,
      "max": 30.0,
      "step": 0.5,
      "group": "hinge",
      "modes": [
        "web_hinge",
        "segmented_hinge",
        "box_corner"
      ],
      "label": {
        "en": "Hinge Length (mm)",
        "es": "Longitud de Bisagra (mm)"
      },
      "tooltip": {
        "en": "Length of the flexing zone along the fold direction",
        "es": "Longitud de la zona de flexión en la dirección del doblez"
      }
    },
    {
      "id": "seg_count",
      "type": "slider",
      "default": 6,
      "min": 1,
      "max": 20,
      "step": 1,
      "group": "segmented",
      "modes": [
        "segmented_hinge"
      ],
      "label": {
        "en": "Slot Rows",
        "es": "Filas de Ranuras"
      },
      "tooltip": {
        "en": "Number of cut slots across the segmented hinge",
        "es": "Número de ranuras cortadas en la bisagra segmentada"
      }
    },
    {
      "id": "seg_gap",
      "type": "slider",
      "default": 1.2,
      "min": 0.4,
      "max": 3.0,
      "step": 0.1,
      "group": "segmented",
      "modes": [
        "segmented_hinge"
      ],
      "advanced": true,
      "label": {
        "en": "Slot Width (mm)",
        "es": "Ancho de Ranura (mm)"
      },
      "tooltip": {
        "en": "Width of each cut slot; wider = more flexible, weaker",
        "es": "Ancho de cada ranura; más ancho = más flexible, más débil"
      }
    }
  ],
  "presets": [
    {
      "id": "lid_web",
      "mode": "web_hinge",
      "label": {
        "en": "Snap-Lid Web (0.5 mm)",
        "es": "Membrana de Tapa (0.5 mm)"
      },
