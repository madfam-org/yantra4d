      "options": [
        { "value": "A/13", "label": { "en": "V-Belt A / 13 mm (40°)", "es": "Banda en V A / 13 mm (40°)" } },
        { "value": "roundbelt", "label": { "en": "Round Belt / O-Ring", "es": "Banda Redonda / Anillo O" } }
      ]
    },
    {
      "id": "outer_dia", "type": "slider", "default": 60.0, "min": 16.0, "max": 160.0, "step": 1.0,
