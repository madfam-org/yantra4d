      "parts": ["under_desk_hook"],
      "estimate": { "base_time": 8, "per_unit": 2, "per_part": 10 }
    },
    {
      "id": "wall_hook",
      "label": { "en": "Wall Hook", "es": "Gancho de Pared" },
