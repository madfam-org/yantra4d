{
  "project": {
    "name": "Living-Hinge Panel",
    "slug": "living-hinge",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A print-in-place flexure hinge that folds two flat panels without a separate pin. Choose a continuous thin web, a segmented slot lattice, or a coiled knuckle — for boxes, lids, cases, and folding parts.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Una bisagra de flexión impresa en el sitio que dobla dos paneles planos sin un pasador aparte. Elija una membrana delgada continua, una retícula de ranuras segmentadas o un nudo enrollado — para cajas, tapas, estuches y piezas plegables.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/living-hinge.webp",
    "difficulty": "intermediate",
    "tags": [
      "hinge",
      "flexure",
      "living-hinge",
      "fold",
      "box",
      "lid",
      "print-in-place",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
