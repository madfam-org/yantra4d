      }
    },
    {
      "id": "cap",
      "label": {
        "en": "Tip Cap",
        "es": "Tope de punta"
      }
    }
  ],
  "parameters": [
    {
      "id": "cup_width",
      "type": "slider",
      "default": 120.0,
      "min": 80.0,
      "max": 160.0,
      "step": 2.0,
      "group": "wire",
      "modes": [
        "set",
        "wire"
      ],
      "label": {
        "en": "Cup width / wire span (mm)",
        "es": "Ancho de copa / luz de la varilla (mm)"
      },
      "tooltip": {
        "en": "Straight-line span between the wire ends (mm) — the arc diameter. Driven by the finished cup width.",
        "es": "Distancia en línea recta entre las puntas de la varilla (mm) — el diámetro del arco. La determina el ancho terminado de la copa."
      }
    },
    {
      "id": "wire_d",
      "type": "slider",
      "default": 2.5,
      "min": 1.5,
      "max": 4.0,
      "step": 0.1,
      "group": "wire",
      "modes": [
        "set",
        "wire",
        "tip_cap"
      ],
      "label": {
        "en": "Wire diameter (mm)",
        "es": "Diámetro de la varilla (mm)"
      },
      "tooltip": {
        "en": "Round section diameter of the wire (mm). Also sets the tip cap bore, so both parts stay a matched pair.",
        "es": "Diámetro de la sección redonda de la varilla (mm). También define el barreno del tope, para que ambas piezas casen."
      }
    },
    {
      "id": "sweep_deg",
      "type": "slider",
      "default": 180.0,
      "min": 150.0,
      "max": 210.0,
      "step": 5.0,
      "group": "wire",
      "modes": [
        "set",
        "wire"
      ],
      "label": {
        "en": "Arc sweep (degrees)",
        "es": "Barrido del arco (grados)"
      },
      "tooltip": {
        "en": "Angular span of the arc in degrees. Under 180 gives a shallow open wire; over 180 wraps further under the cup.",
        "es": "Amplitud angular del arco en grados. Menos de 180 da una varilla abierta y baja; más de 180 abraza más bajo la copa."
      }
    },
    {
      "id": "cap_len",
      "type": "slider",
      "default": 8.0,
      "min": 5.0,
      "max": 12.0,
      "step": 0.5,
      "group": "cap",
      "modes": [
        "set",
        "tip_cap"
      ],
      "label": {
        "en": "Tip cap length (mm)",
        "es": "Largo del tope (mm)"
      },
      "tooltip": {
        "en": "Overall length of the tip cap (mm). Longer caps spread the end load over more of the channel.",
        "es": "Largo total del tope (mm). Un tope más largo reparte la carga de la punta sobre más túnel."
      }
    },
    {
      "id": "cap_wall",
      "type": "slider",
      "default": 1.2,
      "min": 0.8,
      "max": 2.0,
      "step": 0.1,
      "group": "cap",
      "modes": [
        "set",
        "tip_cap"
      ],
      "label": {
        "en": "Tip cap wall (mm)",
        "es": "Pared del tope (mm)"
      },
      "tooltip": {
        "en": "Wall thickness of the tip cap (mm), including the rounded closed end.",
        "es": "Espesor de pared del tope (mm), incluida la punta cerrada redondeada."
      }
    }
  ],
