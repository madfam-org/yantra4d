      "tooltip": { "en": "Port opening height along Z", "es": "Altura de la abertura del puerto en Z" }
    },
    {
      "id": "port_z", "type": "slider", "default": 4.0, "min": 0.0, "max": 60.0, "step": 0.5,
      "group": "ports", "modes": ["base"], "advanced": true,
