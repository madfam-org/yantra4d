  "constraints": [
    {
      "expression": "finger_gap >= finger_thick",
      "severity": "warning",
      "message": {
        "en": "GoPro fingers interleave best when the gap is at least the finger thickness",
        "es": "Los dedos GoPro se entrelazan mejor cuando la separación es al menos el grosor del dedo"
      }
    },
    {
      "expression": "flank_ang >= 35",
      "severity": "warning",
      "message": {
        "en": "Shallow flank angles reduce the Arca dovetail's holding security",
        "es": "Ángulos de flanco poco profundos reducen la seguridad de sujeción de la cola de milano Arca"
      }
    }
