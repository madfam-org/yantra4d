      "label": {
        "en": "Mounting Flange",
        "es": "Brida de Montaje"
      },
      "tooltip": {
        "en": "Add an outer flange with a bolt-hole circle to bolt the hub to a face",
        "es": "Añade una brida exterior con círculo de pernos para atornillar el cubo a una cara"
      }
    },
    {
      "id": "flange_bolts",
      "type": "slider",
      "default": 4,
      "min": 2,
      "max": 12,
      "step": 1,
      "group": "flange",
