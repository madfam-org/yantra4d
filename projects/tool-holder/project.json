    {
      "id": "block_h", "type": "slider", "default": 30.0, "min": 8.0, "max": 120.0, "step": 1.0,
      "group": "block", "modes": ["block", "wall_rack", "drawer_insert"],
      "label": { "en": "Block Height (mm)", "es": "Altura del Bloque (mm)" },
      "tooltip": { "en": "Overall block height (tray is capped lower)", "es": "Altura total del bloque (la bandeja se limita más baja)" },
      "preview_hint": { "type": "axis_scale", "axis": "z", "scale_factor": 1.0 }
    },
    {
      "id": "margin", "type": "slider", "default": 12.0, "min": 4.0, "max": 40.0, "step": 1.0,
      "group": "block", "modes": ["block", "wall_rack", "drawer_insert"], "advanced": true,
      "label": { "en": "Edge Margin (mm)", "es": "Margen de Borde (mm)" },
      "tooltip": { "en": "Material around the array", "es": "Material alrededor del arreglo" }
