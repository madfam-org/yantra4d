  "constraints": [
    {
      "expression": "shaft_dia <= knob_dia - 4",
      "severity": "error",
      "message": {
        "en": "Shaft bore leaves too thin a wall — increase knob diameter",
        "es": "El barreno deja una pared muy delgada — aumenta el diámetro de la perilla"
      }
    },
    {
      "expression": "flat_depth <= shaft_dia / 2 - 0.6",
      "severity": "warning",
      "message": {
        "en": "D-flat depth is close to the shaft centre",
        "es": "La profundidad del D plano se acerca al centro del eje"
      }
    }
  ],
