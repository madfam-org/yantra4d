  "constraints": [
    {
      "expression": "slot_fit_clearance <= 0.6",
      "severity": "warning",
      "message": {
        "en": "Large clearance may leave the part loose in the slot",
        "es": "Una holgura grande puede dejar la pieza floja en la ranura"
      }
    },
    {
      "expression": "bracket_thick >= 3",
      "severity": "warning",
      "message": {
        "en": "Brackets thinner than 3 mm may flex under load",
        "es": "Escuadras de menos de 3 mm pueden flexionarse bajo carga"
      }
    }
  ],
