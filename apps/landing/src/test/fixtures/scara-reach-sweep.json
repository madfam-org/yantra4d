        "es": "Longitud Eslabón Hombro — L1 (mm)"
      }
    },
    {
      "id": "link2_length",
      "type": "slider",
      "default": 150,
      "min": 80,
      "max": 350,
      "step": 5,
      "label": {
        "en": "Elbow Link Length — L2 (mm)",
        "es": "Longitud Eslabón Codo — L2 (mm)"
      }
    }
  ]
