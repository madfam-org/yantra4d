  "constraints": [
    {
      "expression": "finger_gap >= finger_thick",
      "severity": "error",
      "message": {
        "en": "Finger gap must be >= finger thickness, or a mating prong cannot interleave",
        "es": "La separación de dedos debe ser >= grosor, o una horquilla no puede acoplar"
      }
    },
    {
      "expression": "bolt_hole_d <= knuckle_d - 2.4",
      "severity": "warning",
      "message": {
        "en": "Bolt hole is large relative to the knuckle; the pivot wall gets thin",
        "es": "El orificio del perno es grande respecto al nudillo; la pared del pivote queda delgada"
      }
    }
  ],
