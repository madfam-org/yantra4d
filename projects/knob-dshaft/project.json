      "label": {
        "en": "Bore Depth (mm)",
        "es": "Profundidad del Barreno (mm)"
      },
      "tooltip": {
        "en": "How deep the shaft socket goes (auto-clamped to keep a closed top cap)",
        "es": "Qué tan profundo entra el eje (limitado para mantener una tapa superior cerrada)"
