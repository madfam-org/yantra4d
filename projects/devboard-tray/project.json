  "constraints": [
    {
      "expression": "boss_d >= 4",
      "severity": "warning",
      "message": {
        "en": "Standoffs under 4 mm are fragile",
        "es": "Separadores menores a 4 mm son frágiles"
      }
    },
    {
      "expression": "plate_t >= 2",
      "severity": "error",
      "message": {
        "en": "Plate must be at least 2 mm",
        "es": "La placa debe ser de al menos 2 mm"
      }
    }
  ],
