    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "A slotted desk grommet tidies cable clutter without unplugging anything — cords drop in from the side — and replaces the mismatched plastic ports desks ship with, sized to whatever hole is already drilled.",
      "es": "Un pasacables ranurado ordena el desorden de cables sin desconectar nada — los cables entran desde el lado — y reemplaza los puertos plásticos disparejos que traen los escritorios, dimensionado a cualquier orificio ya perforado."
    },
