    { "id": "mount", "label": { "en": "Mounting", "es": "Montaje" } }
  ],
  "parameters": [
    {
      "id": "fin_len", "type": "slider", "default": 70.0, "min": 40.0, "max": 120.0, "step": 1,
      "group": "finger", "modes": ["finray_jaw", "finray_servo_mount", "finray_finger"],
      "label": { "en": "Finger Length (mm)", "es": "Largo del Dedo (mm)" },
      "tooltip": { "en": "Length from root to tip of the Fin-Ray finger", "es": "Largo de la raiz a la punta del dedo Fin-Ray" },
      "preview_hint": { "type": "axis_scale", "axis": "y", "scale_factor": 1.0 }
    },
    {
      "id": "fin_base", "type": "slider", "default": 34.0, "min": 18.0, "max": 60.0, "step": 1,
      "group": "finger", "modes": ["finray_jaw", "finray_servo_mount", "finray_finger"],
      "label": { "en": "Base Width (mm)", "es": "Ancho de Base (mm)" },
      "tooltip": { "en": "Width of the wedge at the root", "es": "Ancho de la cuna en la raiz" },
      "preview_hint": { "type": "axis_scale", "axis": "x", "scale_factor": 1.0 }
    },
    {
