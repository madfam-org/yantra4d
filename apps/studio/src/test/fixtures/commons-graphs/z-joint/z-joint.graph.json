{
  "version": "1.1.0",
  "units": "mm",
  "meta": {
    "title": "Z Joint (graph twin)",
    "notes": "Golden twin of main.py (graph format 1.1): the same parameters, the same derivations and the same operations in the same order. main.py stays the oracle; y4d-spec --parity compares the two at the defaults and at every preset. Constants keep main.py's names and values, and their sources are main.py's: HIWIN MGN9H (BLOCK_H 10, BLOCK_W 20, BLOCK_L 39.9, HOLE_B 15, HOLE_C 16), the GT2 20T pitch diameter 12.73 (PITCH_R), MISUMI HFS5 2020 (PROFILE 20, SLOT_LIP_T 2, PILOT_D 4.2), ISO 7380-1 M5x10 (SCREW_D 5, SCREW_L 10), ISO 4762 M3 (M3_D 3); the neighbour numbers (13 = belt_offset / idler_offset, 17.5 = belt_plane, CLAMP_WALL, CLAMP_MID, CLAMP_TONGUE, CLAMP_HALF_L, CLAMP_SEAT) are the merged commons cartridges' defaults as main.py states them, and PLATE_T, BACKER_*, PAD_*, NUT_STATION, TAB_W, GROOVE_*, PILOT_DEPTH, HOLE_CLEAR and M3_* are main.py's labelled conventions. Clamps max(lo, min(x, hi)) and pad_y0's min are ternaries, because the expression dialect has no function calls. _cyl('y') is an XZ profile_circle extruded along +Y (the XZ normal is -Y) and _cyl('x') a YZ profile_circle extruded along +X, each built at the origin and turned about its own axis (-90 about y, +90 about x) so the cylinder's seam sits at +Z where makeCylinder puts it, then translated into place; the seam decides where the tessellator puts vertices. The 2x2 M3 loop is unrolled in the script's order. `mirrored` selects the pure YZ reflection of the body, as body.mirror(\"YZ\") does."
  },
  "parameters": {
    "c_inboard": {"default": 21.0},
    "c_end": {"default": 20.0},
    "mirrored": {"default": false}
  },
  "derived": [
    {"id": "BLOCK_H", "expr": "10.0"},
    {"id": "BLOCK_W", "expr": "20.0"},
    {"id": "BLOCK_L", "expr": "39.9"},
    {"id": "HOLE_B", "expr": "15.0"},
    {"id": "HOLE_C", "expr": "16.0"},
    {"id": "PITCH_R", "expr": "12.73 / 2"},
    {"id": "PROFILE", "expr": "20.0"},
    {"id": "SLOT_LIP_T", "expr": "2.0"},
    {"id": "PILOT_D", "expr": "4.2"},
    {"id": "SCREW_D", "expr": "5.0"},
    {"id": "SCREW_L", "expr": "10.0"},
    {"id": "M3_D", "expr": "3.0"},
    {"id": "BELT_AXIS_X", "expr": "-BLOCK_H + 13"},
    {"id": "BELT_X", "expr": "BELT_AXIS_X - PITCH_R"},
    {"id": "BELT_PLANE_Y", "expr": "PROFILE / 2 + 17.5"},
    {"id": "CLAMP_WALL", "expr": "1.2"},
    {"id": "CLAMP_MID", "expr": "8.3"},
    {"id": "CLAMP_TONGUE", "expr": "2.0"},
    {"id": "CLAMP_HALF_L", "expr": "28.07"},
    {"id": "CLAMP_SEAT", "expr": "4.5"},
    {"id": "PLATE_T", "expr": "6.0"},
    {"id": "BACKER_Y0", "expr": "10.5"},
    {"id": "BACKER_X0", "expr": "-BLOCK_H"},
    {"id": "BACKER_HALF_H", "expr": "28.0"},
    {"id": "CLAMP_FACE_Y", "expr": "BELT_PLANE_Y - CLAMP_MID"},
    {"id": "CLAMP_X", "expr": "BELT_X + CLAMP_WALL"},
    {"id": "PAD_T", "expr": "4.5"},
    {"id": "PAD_LEN", "expr": "25.0"},
    {"id": "NUT_STATION", "expr": "10.0"},
    {"id": "TAB_W", "expr": "5.8"},
    {"id": "GROOVE_W", "expr": "6.0"},
    {"id": "GROOVE_D", "expr": "CLAMP_TONGUE + 0.5"},
    {"id": "GROOVE_HALF_L", "expr": "CLAMP_HALF_L - 2 + 0.5"},
    {"id": "PILOT_DEPTH", "expr": "SCREW_L - CLAMP_SEAT + 1.5"},
    {"id": "HOLE_CLEAR", "expr": "0.25"},
    {"id": "M3_CLEAR", "expr": "0.2"},
    {"id": "M3_CB_D", "expr": "6.5"},
    {"id": "M3_CB_T", "expr": "3.5"},
    {"id": "ci_cap", "expr": "c_inboard < 45 ? c_inboard : 45"},
    {"id": "ci", "expr": "21 > ci_cap ? 21 : ci_cap"},
    {"id": "ce_cap", "expr": "c_end < 60 ? c_end : 60"},
    {"id": "ce", "expr": "0 > ce_cap ? 0 : ce_cap"},
    {"id": "c_out", "expr": "ci - PROFILE / 2"},
    {"id": "c_in", "expr": "ci + PROFILE / 2"},
    {"id": "pad_y0", "expr": "ce < BACKER_Y0 ? ce : BACKER_Y0"},
    {"id": "pad_y1", "expr": "ce + PAD_LEN"},
    {"id": "nut_y", "expr": "ce + NUT_STATION"}
  ],
  "nodes": [
    {"id": "plate_blank", "type": "box", "params": {"w": {"expr": "PLATE_T - 0"}, "d": {"expr": "CLAMP_FACE_Y - (-BLOCK_W / 2)"}, "h": {"expr": "BLOCK_L / 2 - (-BLOCK_L / 2)"}}},
    {"id": "plate", "type": "translate", "inputs": {"shape": "plate_blank"}, "params": {"x": {"expr": "(0 + PLATE_T) / 2"}, "y": {"expr": "(-BLOCK_W / 2 + CLAMP_FACE_Y) / 2"}, "z": {"expr": "(-BLOCK_L / 2 + (BLOCK_L / 2)) / 2"}}},
    {"id": "backer_blank", "type": "box", "params": {"w": {"expr": "PLATE_T - BACKER_X0"}, "d": {"expr": "CLAMP_FACE_Y - BACKER_Y0"}, "h": {"expr": "BACKER_HALF_H - -BACKER_HALF_H"}}},
    {"id": "backer", "type": "translate", "inputs": {"shape": "backer_blank"}, "params": {"x": {"expr": "(BACKER_X0 + PLATE_T) / 2"}, "y": {"expr": "(BACKER_Y0 + CLAMP_FACE_Y) / 2"}, "z": {"expr": "(-BACKER_HALF_H + BACKER_HALF_H) / 2"}}},
    {"id": "body_1", "type": "union", "inputs": {"a": "plate", "b": "backer"}},
    {"id": "web_blank", "type": "box", "params": {"w": {"expr": "c_out - 0"}, "d": {"expr": "CLAMP_FACE_Y - BACKER_Y0"}, "h": {"expr": "0 - (-BLOCK_L / 2)"}}},
    {"id": "web", "type": "translate", "inputs": {"shape": "web_blank"}, "params": {"x": {"expr": "(0 + c_out) / 2"}, "y": {"expr": "(BACKER_Y0 + CLAMP_FACE_Y) / 2"}, "z": {"expr": "(-BLOCK_L / 2 + 0) / 2"}}},
    {"id": "body_2", "type": "union", "inputs": {"a": "body_1", "b": "web"}},
    {"id": "pad_blank", "type": "box", "params": {"w": {"expr": "c_in - c_out"}, "d": {"expr": "pad_y1 - pad_y0"}, "h": {"expr": "0 - -PAD_T"}}},
    {"id": "pad", "type": "translate", "inputs": {"shape": "pad_blank"}, "params": {"x": {"expr": "(c_out + c_in) / 2"}, "y": {"expr": "(pad_y0 + pad_y1) / 2"}, "z": {"expr": "(-PAD_T + 0) / 2"}}},
    {"id": "body_3", "type": "union", "inputs": {"a": "body_2", "b": "pad"}},
    {"id": "tongue_blank", "type": "box", "params": {"w": {"expr": "ci + TAB_W / 2 - (ci - TAB_W / 2)"}, "d": {"expr": "pad_y1 - 1 - (pad_y0 + 1)"}, "h": {"expr": "SLOT_LIP_T - 0"}}},
    {"id": "tongue", "type": "translate", "inputs": {"shape": "tongue_blank"}, "params": {"x": {"expr": "(ci - TAB_W / 2 + (ci + TAB_W / 2)) / 2"}, "y": {"expr": "(pad_y0 + 1 + (pad_y1 - 1)) / 2"}, "z": {"expr": "(0 + SLOT_LIP_T) / 2"}}},
    {"id": "body_4", "type": "union", "inputs": {"a": "body_3", "b": "tongue"}},
    {"id": "pad_screw_outline", "type": "profile_circle", "params": {"r": {"expr": "(SCREW_D + 2 * HOLE_CLEAR) / 2"}, "x": {"expr": "ci"}, "y": {"expr": "nut_y"}}},
    {"id": "pad_screw_blank", "type": "extrude", "inputs": {"profile": "pad_screw_outline"}, "params": {"height": {"expr": "SLOT_LIP_T + 1 - (-PAD_T - 1)"}}},
    {"id": "pad_screw", "type": "translate", "inputs": {"shape": "pad_screw_blank"}, "params": {"z": {"expr": "-PAD_T - 1"}}},
    {"id": "body_5", "type": "cut", "inputs": {"a": "body_4", "b": "pad_screw"}},
    {"id": "m3_hole_1_outline", "type": "profile_circle", "params": {"plane": "YZ", "r": {"expr": "(M3_D + 2 * M3_CLEAR) / 2"}}},
    {"id": "m3_hole_1_blank", "type": "extrude", "inputs": {"profile": "m3_hole_1_outline"}, "params": {"height": {"expr": "PLATE_T + 1 - -1"}}},
    {"id": "m3_hole_1_seam", "type": "rotate", "inputs": {"shape": "m3_hole_1_blank"}, "params": {"axis": "x", "angle": 90.0}},
    {"id": "m3_hole_1", "type": "translate", "inputs": {"shape": "m3_hole_1_seam"}, "params": {"x": -1.0, "y": {"expr": "-HOLE_B / 2"}, "z": {"expr": "-HOLE_C / 2"}}},
    {"id": "body_6", "type": "cut", "inputs": {"a": "body_5", "b": "m3_hole_1"}},
    {"id": "m3_cbore_1_outline", "type": "profile_circle", "params": {"plane": "YZ", "r": {"expr": "M3_CB_D / 2"}}},
    {"id": "m3_cbore_1_blank", "type": "extrude", "inputs": {"profile": "m3_cbore_1_outline"}, "params": {"height": {"expr": "PLATE_T + 1 - (PLATE_T - M3_CB_T)"}}},
    {"id": "m3_cbore_1_seam", "type": "rotate", "inputs": {"shape": "m3_cbore_1_blank"}, "params": {"axis": "x", "angle": 90.0}},
    {"id": "m3_cbore_1", "type": "translate", "inputs": {"shape": "m3_cbore_1_seam"}, "params": {"x": {"expr": "PLATE_T - M3_CB_T"}, "y": {"expr": "-HOLE_B / 2"}, "z": {"expr": "-HOLE_C / 2"}}},
    {"id": "body_7", "type": "cut", "inputs": {"a": "body_6", "b": "m3_cbore_1"}},
    {"id": "m3_hole_2_outline", "type": "profile_circle", "params": {"plane": "YZ", "r": {"expr": "(M3_D + 2 * M3_CLEAR) / 2"}}},
    {"id": "m3_hole_2_blank", "type": "extrude", "inputs": {"profile": "m3_hole_2_outline"}, "params": {"height": {"expr": "PLATE_T + 1 - -1"}}},
    {"id": "m3_hole_2_seam", "type": "rotate", "inputs": {"shape": "m3_hole_2_blank"}, "params": {"axis": "x", "angle": 90.0}},
    {"id": "m3_hole_2", "type": "translate", "inputs": {"shape": "m3_hole_2_seam"}, "params": {"x": -1.0, "y": {"expr": "-HOLE_B / 2"}, "z": {"expr": "HOLE_C / 2"}}},
    {"id": "body_8", "type": "cut", "inputs": {"a": "body_7", "b": "m3_hole_2"}},
    {"id": "m3_cbore_2_outline", "type": "profile_circle", "params": {"plane": "YZ", "r": {"expr": "M3_CB_D / 2"}}},
    {"id": "m3_cbore_2_blank", "type": "extrude", "inputs": {"profile": "m3_cbore_2_outline"}, "params": {"height": {"expr": "PLATE_T + 1 - (PLATE_T - M3_CB_T)"}}},
    {"id": "m3_cbore_2_seam", "type": "rotate", "inputs": {"shape": "m3_cbore_2_blank"}, "params": {"axis": "x", "angle": 90.0}},
    {"id": "m3_cbore_2", "type": "translate", "inputs": {"shape": "m3_cbore_2_seam"}, "params": {"x": {"expr": "PLATE_T - M3_CB_T"}, "y": {"expr": "-HOLE_B / 2"}, "z": {"expr": "HOLE_C / 2"}}},
    {"id": "body_9", "type": "cut", "inputs": {"a": "body_8", "b": "m3_cbore_2"}},
    {"id": "m3_hole_3_outline", "type": "profile_circle", "params": {"plane": "YZ", "r": {"expr": "(M3_D + 2 * M3_CLEAR) / 2"}}},
    {"id": "m3_hole_3_blank", "type": "extrude", "inputs": {"profile": "m3_hole_3_outline"}, "params": {"height": {"expr": "PLATE_T + 1 - -1"}}},
    {"id": "m3_hole_3_seam", "type": "rotate", "inputs": {"shape": "m3_hole_3_blank"}, "params": {"axis": "x", "angle": 90.0}},
    {"id": "m3_hole_3", "type": "translate", "inputs": {"shape": "m3_hole_3_seam"}, "params": {"x": -1.0, "y": {"expr": "HOLE_B / 2"}, "z": {"expr": "-HOLE_C / 2"}}},
    {"id": "body_10", "type": "cut", "inputs": {"a": "body_9", "b": "m3_hole_3"}},
    {"id": "m3_cbore_3_outline", "type": "profile_circle", "params": {"plane": "YZ", "r": {"expr": "M3_CB_D / 2"}}},
    {"id": "m3_cbore_3_blank", "type": "extrude", "inputs": {"profile": "m3_cbore_3_outline"}, "params": {"height": {"expr": "PLATE_T + 1 - (PLATE_T - M3_CB_T)"}}},
    {"id": "m3_cbore_3_seam", "type": "rotate", "inputs": {"shape": "m3_cbore_3_blank"}, "params": {"axis": "x", "angle": 90.0}},
    {"id": "m3_cbore_3", "type": "translate", "inputs": {"shape": "m3_cbore_3_seam"}, "params": {"x": {"expr": "PLATE_T - M3_CB_T"}, "y": {"expr": "HOLE_B / 2"}, "z": {"expr": "-HOLE_C / 2"}}},
    {"id": "body_11", "type": "cut", "inputs": {"a": "body_10", "b": "m3_cbore_3"}},
    {"id": "m3_hole_4_outline", "type": "profile_circle", "params": {"plane": "YZ", "r": {"expr": "(M3_D + 2 * M3_CLEAR) / 2"}}},
    {"id": "m3_hole_4_blank", "type": "extrude", "inputs": {"profile": "m3_hole_4_outline"}, "params": {"height": {"expr": "PLATE_T + 1 - -1"}}},
    {"id": "m3_hole_4_seam", "type": "rotate", "inputs": {"shape": "m3_hole_4_blank"}, "params": {"axis": "x", "angle": 90.0}},
    {"id": "m3_hole_4", "type": "translate", "inputs": {"shape": "m3_hole_4_seam"}, "params": {"x": -1.0, "y": {"expr": "HOLE_B / 2"}, "z": {"expr": "HOLE_C / 2"}}},
    {"id": "body_12", "type": "cut", "inputs": {"a": "body_11", "b": "m3_hole_4"}},
    {"id": "m3_cbore_4_outline", "type": "profile_circle", "params": {"plane": "YZ", "r": {"expr": "M3_CB_D / 2"}}},
    {"id": "m3_cbore_4_blank", "type": "extrude", "inputs": {"profile": "m3_cbore_4_outline"}, "params": {"height": {"expr": "PLATE_T + 1 - (PLATE_T - M3_CB_T)"}}},
    {"id": "m3_cbore_4_seam", "type": "rotate", "inputs": {"shape": "m3_cbore_4_blank"}, "params": {"axis": "x", "angle": 90.0}},
    {"id": "m3_cbore_4", "type": "translate", "inputs": {"shape": "m3_cbore_4_seam"}, "params": {"x": {"expr": "PLATE_T - M3_CB_T"}, "y": {"expr": "HOLE_B / 2"}, "z": {"expr": "HOLE_C / 2"}}},
    {"id": "body_13", "type": "cut", "inputs": {"a": "body_12", "b": "m3_cbore_4"}},
    {"id": "clamp_groove_blank", "type": "box", "params": {"w": {"expr": "CLAMP_X + GROOVE_W / 2 - (CLAMP_X - GROOVE_W / 2)"}, "d": {"expr": "CLAMP_FACE_Y + 1 - (CLAMP_FACE_Y - GROOVE_D)"}, "h": {"expr": "GROOVE_HALF_L - -GROOVE_HALF_L"}}},
    {"id": "clamp_groove", "type": "translate", "inputs": {"shape": "clamp_groove_blank"}, "params": {"x": {"expr": "(CLAMP_X - GROOVE_W / 2 + (CLAMP_X + GROOVE_W / 2)) / 2"}, "y": {"expr": "(CLAMP_FACE_Y - GROOVE_D + (CLAMP_FACE_Y + 1)) / 2"}, "z": {"expr": "(-GROOVE_HALF_L + GROOVE_HALF_L) / 2"}}},
    {"id": "body_14", "type": "cut", "inputs": {"a": "body_13", "b": "clamp_groove"}},
    {"id": "clamp_pilot_outline", "type": "profile_circle", "params": {"plane": "XZ", "r": {"expr": "PILOT_D / 2"}}},
    {"id": "clamp_pilot_blank", "type": "extrude", "inputs": {"profile": "clamp_pilot_outline"}, "params": {"height": {"expr": "-(CLAMP_FACE_Y + 1 - (CLAMP_FACE_Y - GROOVE_D - PILOT_DEPTH))"}}},
    {"id": "clamp_pilot_seam", "type": "rotate", "inputs": {"shape": "clamp_pilot_blank"}, "params": {"axis": "y", "angle": -90.0}},
    {"id": "clamp_pilot", "type": "translate", "inputs": {"shape": "clamp_pilot_seam"}, "params": {"x": {"expr": "CLAMP_X"}, "y": {"expr": "CLAMP_FACE_Y - GROOVE_D - PILOT_DEPTH"}}},
    {"id": "body_15", "type": "cut", "inputs": {"a": "body_14", "b": "clamp_pilot"}},
    {"id": "body_mirrored", "type": "reflect", "inputs": {"shape": "body_15"}, "params": {"plane": "YZ"}},
    {"id": "z_joint", "type": "select", "inputs": {"if_true": "body_mirrored", "if_false": "body_15"}, "params": {"when": {"expr": "mirrored"}}}
  ],
  "outputs": {
    "z_joint": "z_joint"
  }
}
