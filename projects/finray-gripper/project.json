      "group": "finger", "modes": ["finray_jaw", "finray_servo_mount", "finray_finger"],
      "label": { "en": "Finger Thickness (mm)", "es": "Grosor del Dedo (mm)" },
      "tooltip": { "en": "Thickness (Z) of the finger", "es": "Grosor (Z) del dedo" },
      "preview_hint": { "type": "axis_scale", "axis": "z", "scale_factor": 1.0 }
    },
    {
