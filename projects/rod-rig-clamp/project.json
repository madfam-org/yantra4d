  "constraints": [
    {
      "expression": "clamp_bolt_d < rod_d + 2 * wall",
      "severity": "error",
      "message": {
        "en": "Pinch bolt hole must fit within the clamp body width",
        "es": "El orificio del perno debe caber dentro del ancho del cuerpo"
      }
    },
    {
      "expression": "rod_spacing >= rod_d + 2 * wall",
      "severity": "warning",
      "message": {
        "en": "Rod spacing is tight relative to the clamp bodies; they may overlap",
        "es": "La separación de varillas es ajustada respecto a los cuerpos; podrían solaparse"
      }
    }
  ],
