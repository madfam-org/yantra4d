      "parts": [
        "T_bracket"
      ],
      "estimate": {
        "base_time": 7,
        "per_unit": 2,
        "per_part": 7
      }
    },
    {
      "id": "gusset_bracket",
      "label": {
        "en": "Gusset Bracket",
        "es": "Ángulo con Refuerzo"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
