        { "value": "lathe_insert", "label": { "en": "Lathe Insert (tray)", "es": "Inserto de Torno (bandeja)" } },
        { "value": "drill_index", "label": { "en": "Drill Index (graduated)", "es": "Índice de Brocas (graduado)" } }
      ]
    },
