      "label": { "en": "Cross-Ribs", "es": "Nervaduras Cruzadas" },
      "tooltip": { "en": "Number of angled cross-ribs — tunes the wrap stiffness", "es": "Numero de nervaduras cruzadas inclinadas — ajusta la rigidez de envoltura" }
    },
    {
      "id": "rib_w", "type": "slider", "default": 2.4, "min": 1.5, "max": 5.0, "step": 0.1,
