  "constraints": [
    {
      "expression": "base_dia >= post_dia * 2.4",
      "message": {
        "en": "A base narrower than about 2.4 post diameters reads as a collar, not a weighted base, and tips over.",
        "es": "Una base más estrecha que unos 2.4 diámetros del poste parece un collar, no una base lastrada, y se vuelca."
      }
    },
    {
      "expression": "neck_dia <= head_girth / 3.6",
      "message": {
        "en": "The head-block neck must stay well inside the dome it carries.",
        "es": "El cuello de la horma debe quedar holgadamente dentro de la cúpula que sostiene."
      }
    }
