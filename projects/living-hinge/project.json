      "values": {
        "hinge_type": "segmented",
        "panel_w": 80,
        "panel_len": 30,
        "panel_thick": 3,
        "hinge_len": 18,
        "seg_count": 10,
        "seg_gap": 1.2
      }
    },
    {
      "id": "folded_case_corner",
      "mode": "box_corner",
      "label": {
        "en": "Folded Case Corner",
        "es": "Esquina de Estuche Plegada"
      },
      "values": {
        "hinge_type": "thin_web",
        "panel_w": 60,
        "panel_len": 45,
        "panel_thick": 3,
        "web_thick": 0.6,
        "hinge_len": 8
      }
    }
  ],
  "constraints": [
    {
      "expression": "web_thick <= panel_thick - 0.2",
      "severity": "warning",
      "message": {
        "en": "Web must be thinner than the panel to flex",
        "es": "La membrana debe ser más delgada que el panel para flexionar"
      }
    },
    {
      "expression": "web_thick >= 0.2",
      "severity": "error",
      "message": {
        "en": "Web must be at least 0.2 mm to print",
        "es": "La membrana debe ser de al menos 0.2 mm para imprimir"
      }
    }
  ],
