      "max": 6.0,
      "step": 0.1,
      "group": "mounting",
      "modes": [
        "base_tray",
        "rail_base"
      ],
      "advanced": true,
      "label": {
        "en": "Ear Screw Bore (mm)",
        "es": "Barreno de Oreja (mm)"
      },
      "tooltip": {
        "en": "Clearance bore in the corner ears (M3=3.4, M4=4.3)",
