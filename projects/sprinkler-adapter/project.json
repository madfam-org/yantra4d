      "label": {
        "en": "GHT Coupler",
        "es": "Acoplador GHT"
      },
      "render_mode": 0,
      "color": "#2f7fb0"
    },
    {
      "id": "nozzle_adapter",
      "label": {
        "en": "Nozzle Adapter",
        "es": "Adaptador de Boquilla"
