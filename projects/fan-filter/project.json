{
  "project": {
    "name": "PC Fan Filter Frame",
    "slug": "fan-filter",
    "version": "1.0.0",
    "engine": "cadquery",
    "force_backend": true,
    "difficulty": "beginner",
    "description": {
      "en": "A snap-in dust filter frame for standard PC / printer fans. It mounts on the fan's intake face using the same 40 / 60 / 80 / 120 / 140 mm corner-hole square the fan uses, holding a cut disc of mesh or foam over the airflow bore behind a printed retaining grille. Choose a screw-mount frame, a screwless magnetic frame, or a two-stage stacked cartridge that captures a pre-filter and a fine filter in one part.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Un marco de filtro antipolvo a presión para ventiladores estándar de PC / impresora. Se monta en la cara de admisión del ventilador usando el mismo cuadro de orificios de esquina de 40 / 60 / 80 / 120 / 140 mm que usa el ventilador, sujetando un disco recortado de malla o espuma sobre el orificio de flujo tras una rejilla de retención impresa. Elige un marco atornillado, un marco magnético sin tornillos, o un cartucho apilado de dos etapas que captura un prefiltro y un filtro fino en una sola pieza.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/fan-filter.webp",
    "tags": [
      "fan",
      "filter",
      "dust",
      "pc-fan",
      "cooling",
      "mesh",
      "grille",
      "hyperobject",
      "commons"
    ]
  },
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "industrial",
    "cdg_interfaces": [
      {
        "id": "fan_screw_pattern",
        "label": {
          "en": "PC Fan Corner-Hole Square",
          "es": "Cuadro de Orificios de Esquina de Ventilador PC"
        },
        "geometry_type": "grid",
        "standard": "PC fan 40-140mm",
        "parameters": ["fan_size"],
        "compatible_with": ["fan-adapter", "dust-shroud"]
      },
      {
        "id": "media_pocket",
        "label": {
          "en": "Filter Media Pocket",
          "es": "Bolsillo de Medio Filtrante"
        },
        "geometry_type": "pocket",
        "standard": "internal",
        "parameters": ["media_pocket", "grille_bar", "grille_rings"]
      },
      {
        "id": "magnet_pocket",
        "label": {
          "en": "Corner Magnet Pocket",
          "es": "Bolsillo de Imán de Esquina"
        },
        "geometry_type": "socket",
        "standard": "internal",
        "parameters": ["magnet_dia", "magnet_h"]
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "A dusty fan clogs, overheats and dies; a filter frame extends the life of any PC, 3D printer or ventilation fan for pennies of filament plus a scrap of mesh. Because it mounts on the open PC-fan corner-hole square shared by dozens of makers, one printed frame fits the same fan a fan-adapter or dust-shroud already bolts to, and the media is a washable, replaceable consumable instead of a proprietary cartridge.",
      "es": "Un ventilador con polvo se obstruye, se sobrecalienta y muere; un marco de filtro alarga la vida de cualquier ventilador de PC, impresora 3D o ventilación por unos centavos de filamento más un recorte de malla. Como se monta en el cuadro abierto de orificios de esquina de ventilador PC que comparten docenas de fabricantes, un marco impreso encaja en el mismo ventilador que un fan-adapter o dust-shroud ya atornilla, y el medio es un consumible lavable y reemplazable en vez de un cartucho propietario."
    },
    "commons_license": "CERN-OHL-W-2.0"
  },
