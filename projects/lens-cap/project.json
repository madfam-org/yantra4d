      "label": { "en": "Thread A — Female (mm)", "es": "Rosca A — Hembra (mm)" },
      "tooltip": { "en": "Bottom female thread — the size that screws ONTO the lens", "es": "Rosca hembra inferior — el tamaño que se enrosca EN la lente" },
