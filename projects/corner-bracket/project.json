{
  "project": {
    "name": "Corner Bracket / Angle Gusset",
    "slug": "corner-bracket",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A simple angle bracket that joins two panels or boards at any angle. Two legs meet at a configurable angle (default 90°); each leg carries a row of screw holes with an optional countersink and an optional triangular gusset brace.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Un simple ángulo de fijación que une dos paneles o tablas en cualquier ángulo. Dos patas se encuentran en un ángulo configurable (90° por defecto); cada pata lleva una fila de agujeros para tornillos con avellanado opcional y un refuerzo triangular opcional.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/corner-bracket.webp",
    "difficulty": "beginner",
    "tags": [
      "bracket",
      "angle",
      "gusset",
      "corner",
      "L-bracket",
      "joiner",
      "fastener",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
  "modes": [
    {
      "id": "L_bracket",
      "label": {
        "en": "L-Bracket",
        "es": "Ángulo en L"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": [
        "L_bracket"
      ],
      "estimate": {
