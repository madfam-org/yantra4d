          "pitch"
        ]
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": true,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "Lacing hooks are a tiny stamped part that a mender or small workshop cannot buy in ones and twos; printing them to the exact cord and plate size keeps a corset, a bodice, or a pair of boots repairable instead of discarded.",
      "es": "Los ganchos de cordón son una pieza troquelada diminuta que quien repara o un taller pequeño no puede comprar de una en una; imprimirlos a la medida exacta del cordón y de la placa mantiene reparables un corsé, un corpiño o unas botas en lugar de desecharlos."
    },
