      "message": { "en": "Groove depth is close to the pulley radius", "es": "La profundidad de la ranura se acerca al radio de la polea" }
    },
    {
      "expression": "bore <= outer_dia - 6",
      "severity": "error",
      "message": { "en": "Bore must leave a rim wall around it", "es": "El barreno debe dejar una pared de aro alrededor" }
    }
