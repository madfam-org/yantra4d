{
  "project": {
    "name": "Endstop Mount",
    "slug": "endstop-mount",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "Holds a limit switch at a repeatable position on a motion axis. The switch face carries the Omron-style microswitch footprint — two M2 holes on ~9.5 mm centres for a ~20 x 6 mm subminiature switch (SS / D2F family) — and adjustment slots dial in the trigger point. Choose a slotted switch bracket, an optical-endstop board mount, or a 2020 extrusion foot.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Sujeta un interruptor de limite en una posicion repetible sobre un eje de movimiento. La cara del interruptor lleva la huella tipo Omron — dos agujeros M2 a ~9.5 mm entre centros para un microinterruptor subminiatura de ~20 x 6 mm (familia SS / D2F) — y las ranuras de ajuste calibran el punto de disparo. Elige un soporte ranurado, un montaje para placa de endstop optico o un pie para extrusion 2020.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/endstop-mount.webp",
    "difficulty": "beginner",
    "tags": ["endstop", "limit-switch", "microswitch", "omron", "optical", "3d-printer", "cnc", "robotics", "hyperobject", "commons"],
    "hyperobject": { "is_hyperobject": true },
    "force_backend": true
  },
  "modes": [
    {
      "id": "switch_bracket",
      "label": { "en": "Switch Bracket", "es": "Soporte de Interruptor" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["switch_bracket"],
      "estimate": { "base_time": 10, "per_unit": 3, "per_part": 12 }
    },
    {
      "id": "optical_endstop",
      "label": { "en": "Optical Endstop", "es": "Endstop Optico" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["optical_endstop"],
      "estimate": { "base_time": 10, "per_unit": 3, "per_part": 12 }
    },
    {
      "id": "extrusion_endstop",
      "label": { "en": "2020 Extrusion Endstop", "es": "Endstop para Extrusion 2020" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["extrusion_endstop"],
      "estimate": { "base_time": 12, "per_unit": 3, "per_part": 14 }
    }
  ],
  "parts": [
    { "id": "switch_bracket", "label": { "en": "Switch Bracket", "es": "Soporte de Interruptor" }, "render_mode": 0, "color": "#4a7a5c" },
