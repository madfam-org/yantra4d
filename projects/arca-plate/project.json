  "constraints": [
    {
      "expression": "slot_w < plate_w",
      "severity": "error",
      "message": {
        "en": "1/4-20 slot must be narrower than the plate",
        "es": "La ranura 1/4-20 debe ser más estrecha que la placa"
      }
    },
    {
      "expression": "flank_ang >= 35",
      "severity": "warning",
      "message": {
        "en": "Shallow flank angles reduce the Arca dovetail's holding security",
        "es": "Ángulos de flanco poco profundos reducen la seguridad de sujeción de la cola de milano Arca"
      }
    }
  ],
