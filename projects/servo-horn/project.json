        "standard": "24T Futaba / 25T Spektrum",
        "parameters": ["spline", "tooth_h", "hub_d"]
      },
      {
        "id": "linkage_holes",
        "label": { "en": "Linkage Holes", "es": "Agujeros de Varillaje" },
        "geometry_type": "bolt_pattern",
        "standard": "internal",
        "parameters": ["hole_d", "hole_count", "hole_pitch"]
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "Servo horns snap and strip, and the OEM part is proprietary and often unavailable. An on-demand horn cut to the correct 24T/25T spline restores a servo on any craft or machine, and the tooth-depth control tunes the grip fit per printer.",
      "es": "Los horns de servo se rompen y barren, y la pieza original es propietaria y a menudo no disponible. Un horn bajo demanda cortado al estriado 24T/25T correcto restaura un servo en cualquier equipo o maquina, y el control de profundidad de diente ajusta el encaje por impresora."
    },
