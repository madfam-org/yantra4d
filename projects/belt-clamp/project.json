      "id": "belt", "type": "select", "default": "GT2-2mm",
      "group": "belt", "modes": ["belt_clamp", "tensioner", "belt_joiner"],
      "label": { "en": "Belt Profile", "es": "Perfil de Banda" },
      "tooltip": { "en": "Belt tooth profile — sets the ridge pitch and depth", "es": "Perfil de diente de la banda — define el paso y profundidad de las crestas" },
      "options": [
        { "value": "GT2-2mm", "label": { "en": "GT2 2 mm pitch", "es": "GT2 paso 2 mm" } },
        { "value": "HTD-3M", "label": { "en": "HTD 3M (3 mm pitch)", "es": "HTD 3M (paso 3 mm)" } }
      ]
    },
    {
      "id": "teeth", "type": "slider", "default": 6, "min": 2, "max": 40, "step": 1,
      "group": "belt", "modes": ["belt_clamp", "tensioner", "belt_joiner"],
      "label": { "en": "Grip Teeth", "es": "Dientes de Agarre" },
      "tooltip": { "en": "Number of gripping ridges per jaw", "es": "Numero de crestas de agarre por mordaza" }
    },
    {
      "id": "belt_w", "type": "slider", "default": 7.0, "min": 4.0, "max": 20.0, "step": 0.5,
      "group": "belt", "modes": ["belt_clamp", "tensioner", "belt_joiner"],
      "label": { "en": "Belt Width (mm)", "es": "Ancho de Banda (mm)" },
      "tooltip": { "en": "Channel width for the belt (6 mm GT2, 9 mm HTD typical)", "es": "Ancho del canal para la banda (6 mm GT2, 9 mm HTD tipico)" }
    },
    {
      "id": "wall", "type": "slider", "default": 2.4, "min": 1.6, "max": 5.0, "step": 0.2,
      "group": "body", "modes": ["belt_clamp", "tensioner", "belt_joiner"],
      "label": { "en": "Wall (mm)", "es": "Pared (mm)" },
      "tooltip": { "en": "Side-wall and body wall thickness", "es": "Grosor de pared lateral y del cuerpo" }
    },
    {
      "id": "floor", "type": "slider", "default": 3.0, "min": 1.6, "max": 6.0, "step": 0.2,
      "group": "body", "modes": ["belt_clamp", "tensioner", "belt_joiner"], "advanced": true,
      "label": { "en": "Floor (mm)", "es": "Piso (mm)" },
      "tooltip": { "en": "Material under the tooth ridges", "es": "Material bajo las crestas de diente" }
    },
    {
      "id": "bolt_d", "type": "slider", "default": 3.4, "min": 2.0, "max": 6.0, "step": 0.1,
      "group": "mount", "modes": ["belt_clamp", "tensioner", "belt_joiner"],
      "label": { "en": "Clamp Bolt (mm)", "es": "Tornillo de Abrazadera (mm)" },
      "tooltip": { "en": "Clamp bolt clearance (3.4 = M3)", "es": "Holgura del tornillo de abrazadera (3.4 = M3)" }
    },
    {
      "id": "slot_len", "type": "slider", "default": 16.0, "min": 6.0, "max": 40.0, "step": 1,
      "group": "mount", "modes": ["tensioner"],
      "label": { "en": "Slot Length (mm)", "es": "Largo de Ranura (mm)" },
      "tooltip": { "en": "Adjustment slot travel (tensioner)", "es": "Recorrido de la ranura de ajuste (tensor)" }
    },
    {
      "id": "mount_d", "type": "slider", "default": 4.5, "min": 2.5, "max": 6.5, "step": 0.1,
      "group": "mount", "modes": ["tensioner"], "advanced": true,
      "label": { "en": "Mount Hole (mm)", "es": "Agujero de Montaje (mm)" },
      "tooltip": { "en": "Slot / mounting bolt width (4.5 = M4)", "es": "Ancho del tornillo de ranura / montaje (4.5 = M4)" }
    }
  ],
  "presets": [
    {
      "id": "gt2_clamp", "mode": "belt_clamp",
      "label": { "en": "GT2 6 mm Clamp", "es": "Abrazadera GT2 6 mm" },
      "values": { "belt": "GT2-2mm", "teeth": 6, "belt_w": 7 }
    },
    {
      "id": "gt2_tensioner", "mode": "tensioner",
