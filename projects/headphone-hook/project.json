{
  "project": {
    "name": "Headphone / Headset Hook",
    "slug": "headphone-hook",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A hook that hangs a headset by its headband from a broad, rounded cradle so the band does not develop a dent. Choose a mount: Under-Desk is an L-bracket that screws to a desktop underside; Wall is a flat screw plate; Clamp is a C-clamp that grips a desk edge of a set thickness with no screws.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Un gancho que cuelga un audífono por su diadema desde una cuna ancha y redondeada para que la banda no se marque. Elige un montaje: Bajo Escritorio es una escuadra en L que se atornilla bajo el tablero; Pared es una placa plana atornillable; Abrazadera es una pinza en C que sujeta el borde del escritorio de un grosor dado sin tornillos.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/headphone-hook.webp",
    "difficulty": "beginner",
    "tags": ["hook", "headphone", "headset", "cradle", "desk", "clamp", "organizer", "hyperobject", "commons"],
    "hyperobject": { "is_hyperobject": true },
    "force_backend": true
  },
  "modes": [
    {
      "id": "under_desk_hook",
      "label": { "en": "Under-Desk Hook", "es": "Gancho Bajo Escritorio" },
      "scad_file": "main.py",
