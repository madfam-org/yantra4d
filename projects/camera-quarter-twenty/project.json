        "es": "Adaptador"
      },
      "render_mode": 0,
      "color": "#5a6b7b"
    }
  ],
  "parameter_groups": [
    {
      "id": "interface",
      "label": {
        "en": "Interface",
        "es": "Interfaz"
      }
    },
    {
      "id": "thread",
      "label": {
        "en": "Thread",
        "es": "Rosca"
      }
    },
    {
      "id": "base",
      "label": {
        "en": "Base",
        "es": "Base"
      }
    }
  ],
  "parameters": [
    {
      "id": "target_part",
      "type": "select",
      "default": "stud",
      "group": "interface",
      "modes": [
        "stud",
        "socket",
        "adapter"
      ],
      "label": {
        "en": "Part",
        "es": "Pieza"
      },
      "tooltip": {
        "en": "Which interface to generate",
        "es": "Qué interfaz generar"
      },
      "options": [
        {
          "value": "stud",
          "label": {
            "en": "Stud — 1/4-20 male boss",
            "es": "Perno — macho 1/4-20"
          }
        },
        {
          "value": "socket",
          "label": {
            "en": "Socket — 1/4-20 female hole",
            "es": "Casquillo — orificio hembra 1/4-20"
          }
        },
        {
          "value": "adapter",
          "label": {
            "en": "Adapter — 1/4 socket + top stud",
            "es": "Adaptador — casquillo 1/4 + perno superior"
          }
        }
      ]
    },
    {
      "id": "adapter_top",
      "type": "select",
      "default": "3/8-16",
      "group": "interface",
      "modes": [
        "adapter"
      ],
      "label": {
        "en": "Adapter Top Interface",
        "es": "Interfaz Superior del Adaptador"
      },
      "tooltip": {
        "en": "Thread on the top face of the adapter (bottom is always a 1/4-20 socket)",
        "es": "Rosca en la cara superior del adaptador (la inferior siempre es un casquillo 1/4-20)"
      },
      "options": [
        {
          "value": "3/8-16",
          "label": {
            "en": "3/8\"-16 stud (9.525 mm)",
            "es": "Perno 3/8\"-16 (9.525 mm)"
          }
        },
        {
          "value": "1/4-20",
          "label": {
            "en": "1/4\"-20 stud (6.35 mm)",
            "es": "Perno 1/4\"-20 (6.35 mm)"
          }
        }
      ]
    },
    {
      "id": "thread_style",
      "type": "select",
      "default": "cosmetic",
      "group": "thread",
      "modes": [
        "stud",
        "socket",
        "adapter"
      ],
      "label": {
        "en": "Thread Style",
        "es": "Estilo de Rosca"
      },
      "tooltip": {
        "en": "Cosmetic: fast, watertight thread envelope (default). Smooth: plain pitch-diameter cylinder/hole for tapping or a heat-set insert. Real: true swept helix (slower).",
        "es": "Cosmética: envolvente de rosca rápida y estanca (por defecto). Lisa: cilindro/orificio liso a diámetro de paso para roscar o inserto térmico. Real: hélice barrida verdadera (más lenta)."
      },
      "options": [
        {
          "value": "cosmetic",
          "label": {
            "en": "Cosmetic (fast, default)",
            "es": "Cosmética (rápida, por defecto)"
          }
        },
        {
          "value": "smooth",
          "label": {
            "en": "Smooth (tap / heat-set)",
            "es": "Lisa (roscar / inserto)"
          }
        },
        {
          "value": "real",
          "label": {
            "en": "Real helix (slower)",
            "es": "Hélice real (más lenta)"
          }
        }
      ]
    },
    {
      "id": "thread_len",
      "type": "slider",
      "default": 8.0,
      "min": 3.0,
      "max": 40.0,
      "step": 0.5,
      "group": "thread",
      "modes": [
        "stud",
        "socket",
        "adapter"
      ],
      "label": {
        "en": "Thread Length / Depth (mm)",
        "es": "Longitud / Profundidad de Rosca (mm)"
      },
      "tooltip": {
        "en": "Stud height, or socket depth (clamped so it never breaches the base)",
        "es": "Altura del perno, o profundidad del casquillo (limitada para no perforar la base)"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "z",
        "scale_factor": 1.0
      }
    },
    {
      "id": "chamfer_lead",
      "type": "checkbox",
      "default": true,
      "group": "thread",
      "modes": [
        "stud",
        "socket",
        "adapter"
      ],
      "label": {
        "en": "Lead-in Chamfer",
        "es": "Chaflán de Entrada"
      },
      "tooltip": {
        "en": "Chamfer the thread start / socket mouth for easy engagement",
        "es": "Achaflanar el inicio de rosca / boca del casquillo para facilitar el enrosque"
      }
    },
    {
      "id": "ring_count",
      "type": "slider",
      "default": 10,
      "min": 3,
      "max": 40,
      "step": 1,
      "group": "thread",
      "modes": [
        "stud",
        "socket",
        "adapter"
      ],
      "advanced": true,
      "label": {
        "en": "Cosmetic Thread Detail",
        "es": "Detalle de Rosca Cosmética"
      },
      "tooltip": {
        "en": "Number of thread teeth in the cosmetic envelope (higher = finer, slightly slower). Ignored for smooth/real styles.",
        "es": "Número de dientes de rosca en la envolvente cosmética (mayor = más fino, un poco más lento). Se ignora en estilos liso/real."
      }
    },
    {
      "id": "base_shape",
      "type": "select",
      "default": "disc",
      "group": "base",
      "modes": [
        "stud",
        "socket",
        "adapter"
      ],
      "label": {
        "en": "Base Shape",
        "es": "Forma de la Base"
      },
      "tooltip": {
        "en": "Disc or rounded square mounting base",
        "es": "Base de montaje en disco o cuadrado redondeado"
      },
      "options": [
        {
          "value": "disc",
          "label": {
            "en": "Disc",
            "es": "Disco"
          }
        },
        {
          "value": "square",
          "label": {
            "en": "Square",
            "es": "Cuadrado"
          }
        }
      ]
    },
    {
      "id": "base_size",
      "type": "slider",
      "default": 25.0,
      "min": 8.0,
      "max": 120.0,
      "step": 1.0,
      "group": "base",
      "modes": [
        "stud",
        "socket",
        "adapter"
      ],
      "label": {
        "en": "Base Size (mm)",
        "es": "Tamaño de Base (mm)"
      },
      "tooltip": {
        "en": "Disc diameter or square side length",
        "es": "Diámetro del disco o lado del cuadrado"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "radial",
        "scale_factor": 0.5
      }
    },
    {
      "id": "base_thick",
      "type": "slider",
      "default": 4.0,
      "min": 1.5,
      "max": 40.0,
      "step": 0.5,
      "group": "base",
      "modes": [
        "stud",
        "socket",
        "adapter"
      ],
      "label": {
        "en": "Base Thickness (mm)",
        "es": "Grosor de Base (mm)"
      },
      "tooltip": {
        "en": "Base plate / body thickness",
        "es": "Grosor de la placa base / cuerpo"
      }
    }
  ],
  "presets": [
    {
      "id": "tripod_screw",
      "mode": "stud",
      "label": {
        "en": "Tripod Quick-Plate Screw",
        "es": "Tornillo de Placa Rápida"
      },
      "values": {
        "target_part": "stud",
        "base_shape": "disc",
        "base_size": 25,
        "base_thick": 4,
        "thread_len": 8,
        "thread_style": "cosmetic"
      }
    },
    {
      "id": "mount_socket",
      "mode": "socket",
      "label": {
        "en": "Camera Mount Socket Plate",
        "es": "Placa con Casquillo"
      },
      "values": {
        "target_part": "socket",
        "base_shape": "square",
        "base_size": 40,
        "base_thick": 8,
        "thread_len": 6,
        "thread_style": "cosmetic"
      }
    },
    {
      "id": "quarter_to_threeeighth",
      "mode": "adapter",
      "label": {
        "en": "1/4-to-3/8 Adapter",
        "es": "Adaptador 1/4-a-3/8"
      },
      "values": {
        "target_part": "adapter",
        "adapter_top": "3/8-16",
        "base_shape": "disc",
        "base_size": 16,
        "base_thick": 6,
        "thread_len": 6,
        "thread_style": "cosmetic"
      }
    }
  ],
  "constraints": [
    {
      "expression": "thread_len <= base_thick + 36",
      "severity": "warning",
      "message": {
        "en": "Very long stud relative to base — check stability",
        "es": "Perno muy largo respecto a la base — revise estabilidad"
      }
    },
    {
      "expression": "base_thick >= 1.5",
      "severity": "error",
      "message": {
        "en": "Base must be at least 1.5 mm",
        "es": "La base debe ser de al menos 1.5 mm"
      }
    }
  ],
