      "modes": [
        "vwheel",
        "flat_wheel",
        "solid_wheel"
      ],
      "label": {
        "en": "Wheel Type",
        "es": "Tipo de Rueda"
      },
      "tooltip": {
        "en": "vslot is a double-V wheel for a V-slot rail; flat is a plain idler wheel.",
        "es": "vslot es una rueda de doble V para riel con ranura en V; flat es una rueda tensora lisa."
      },
      "options": [
        {
          "value": "vslot",
          "label": {
            "en": "V-Slot (double-V)",
            "es": "Ranura en V (doble V)"
          }
        },
        {
          "value": "flat",
          "label": {
            "en": "Flat idler",
            "es": "Tensora plana"
          }
        }
      ]
    },
    {
      "id": "outer_dia",
      "type": "slider",
      "default": 24.0,
      "min": 8.0,
      "max": 62.0,
      "step": 0.5,
      "group": "wheel",
      "modes": [
        "vwheel",
        "flat_wheel",
        "solid_wheel"
      ],
      "label": {
        "en": "Outer Diameter (mm)",
        "es": "Diámetro Exterior (mm)"
      },
