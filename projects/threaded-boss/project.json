        { "value": "M4", "label": { "en": "M4 (bore 5.6 mm)", "es": "M4 (barreno 5.6 mm)" } },
        { "value": "M5", "label": { "en": "M5 (bore 6.4 mm)", "es": "M5 (barreno 6.4 mm)" } },
        { "value": "M6", "label": { "en": "M6 (bore 8.0 mm)", "es": "M6 (barreno 8.0 mm)" } }
