      "label": {
        "en": "Squeeze Cleat",
        "es": "Cuña de Apriete"
      },
      "render_mode": 0,
      "color": "#34d399"
    }
  ],
  "parameter_groups": [
    {
      "id": "cord",
      "label": {
        "en": "Cord",
        "es": "Cordón"
      }
    },
    {
      "id": "body",
      "label": {
        "en": "Body",
        "es": "Cuerpo"
      }
    }
  ],
  "parameters": [
    {
      "id": "lock_style",
      "type": "select",
      "default": "spring_button",
      "group": "body",
      "modes": [
        "spring_toggle",
        "simple_toggle",
        "cleat"
      ],
      "label": {
        "en": "Lock Style",
        "es": "Estilo de Cierre"
      },
      "tooltip": {
        "en": "Spring button (printed pincher clamps the cord), twist (friction bead), or clam (squeeze cleat)",
        "es": "Botón de resorte (pinza impresa que aprieta el cordón), giro (cuenta de fricción) o almeja (cuña de apriete)"
      },
      "options": [
        {
          "value": "spring_button",
          "label": {
            "en": "Spring Button",
            "es": "Botón de Resorte"
          }
        },
        {
          "value": "twist",
          "label": {
            "en": "Twist / Friction",
            "es": "Giro / Fricción"
          }
        },
        {
          "value": "clam",
          "label": {
            "en": "Clam / Cleat",
            "es": "Almeja / Cuña"
          }
        }
      ]
    },
    {
      "id": "cord_dia",
      "type": "slider",
      "default": 4.0,
      "min": 1.0,
      "max": 8.0,
      "step": 0.1,
      "group": "cord",
      "modes": [
        "spring_toggle",
        "simple_toggle",
        "cleat"
      ],
      "label": {
        "en": "Cord Diameter (mm)",
        "es": "Diámetro de Cordón (mm)"
      },
      "tooltip": {
        "en": "Diameter of the cord / drawstring",
        "es": "Diámetro del cordón / cuerda"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "radial",
        "scale_factor": 1.0
      }
    },
    {
      "id": "cords",
      "type": "slider",
      "default": 1,
      "min": 1,
      "max": 2,
      "step": 1,
      "group": "cord",
      "modes": [
        "spring_toggle",
        "simple_toggle",
        "cleat"
      ],
      "label": {
        "en": "Number of Cords",
        "es": "Número de Cordones"
      },
      "tooltip": {
        "en": "1 or 2 cords through the lock",
        "es": "1 o 2 cordones a través del tope"
      }
    },
    {
      "id": "body_size",
      "type": "slider",
      "default": 14.0,
      "min": 8.0,
      "max": 30.0,
      "step": 0.5,
      "group": "body",
      "modes": [
        "spring_toggle",
        "simple_toggle",
        "cleat"
      ],
      "label": {
        "en": "Body Size (mm)",
        "es": "Tamaño del Cuerpo (mm)"
      },
      "tooltip": {
        "en": "Nominal body size (barrel diameter / cleat height)",
        "es": "Tamaño nominal del cuerpo (diámetro del barril / altura de la cuña)"
      }
    },
    {
      "id": "wall",
      "type": "slider",
      "default": 2.0,
      "min": 1.2,
      "max": 5.0,
      "step": 0.1,
      "group": "body",
      "modes": [
        "spring_toggle",
        "simple_toggle",
        "cleat"
      ],
      "advanced": true,
      "label": {
        "en": "Wall / Rib (mm)",
        "es": "Pared / Nervio (mm)"
      },
      "tooltip": {
        "en": "Wall and spring-rib thickness",
        "es": "Grosor de la pared y del nervio de resorte"
      }
    }
  ],
  "presets": [
    {
      "id": "hoodie_spring",
      "mode": "spring_toggle",
      "label": {
        "en": "Hoodie Spring Toggle (4 mm)",
        "es": "Tope de Resorte Sudadera (4 mm)"
      },
      "values": {
        "lock_style": "spring_button",
        "cord_dia": 4,
        "cords": 2,
        "body_size": 14,
        "wall": 2
      }
    },
    {
      "id": "backpack_bead",
      "mode": "simple_toggle",
      "label": {
        "en": "Backpack Friction Bead (5 mm)",
        "es": "Cuenta de Fricción Mochila (5 mm)"
      },
      "values": {
        "lock_style": "twist",
        "cord_dia": 5,
        "cords": 1,
        "body_size": 16
      }
    },
    {
      "id": "tent_cleat",
      "mode": "cleat",
      "label": {
        "en": "Tent Guy-Line Cleat (3 mm)",
        "es": "Cuña de Viento Tienda (3 mm)"
      },
      "values": {
        "lock_style": "clam",
        "cord_dia": 3,
        "cords": 1,
        "body_size": 14
      }
    }
  ],
  "constraints": [
    {
      "expression": "cord_dia <= body_size * 0.45",
      "severity": "warning",
      "message": {
        "en": "Cord is large relative to the body",
        "es": "El cordón es grande respecto al cuerpo"
      }
    },
    {
      "expression": "wall >= 1.2",
      "severity": "error",
      "message": {
        "en": "Wall must be at least 1.2 mm to print reliably",
        "es": "La pared debe ser de al menos 1.2 mm para imprimir de forma fiable"
      }
    }
  ],
  "camera_views": [
    {
      "id": "iso",
      "label": {
        "en": "Isometric",
        "es": "Isométrico"
      },
      "position": [
