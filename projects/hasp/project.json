{
  "project": {
    "name": "Padlock Hasp & Shackle Guard",
    "slug": "hasp",
    "version": "1.0.0",
    "engine": "cadquery",
    "force_backend": true,
    "description": {
      "en": "The hardware that turns a padlock into a door or lid latch: a hinged hasp strap, the staple loop its slot drops over, and a shrouded guard that shields the padlock shackle from bolt-cutters. Modelled on the 4 in (100 mm) safety-pattern hasp family.\n\nOfficial visualizer and configurator: Yantra4D",
      "es": "El herraje que convierte un candado en un pestillo para puerta o tapa: una portezuela (hasp) con bisagra, el grillete (staple) por donde cae su ranura, y un guardián que protege el arco del candado de las cizallas. Basado en la familia de hasp de patrón de seguridad de 4 in (100 mm).\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/hasp.webp",
    "difficulty": "beginner",
    "tags": [
      "hasp",
      "padlock",
      "staple",
      "shackle-guard",
      "latch",
      "security",
      "gate",
      "shed",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    }
  },
  "modes": [
    {
      "id": "safety_hasp",
      "scad_file": "main.py",
      "cq_file": "main.py",
      "label": {
        "en": "Safety Hasp Strap",
        "es": "Portezuela de Seguridad"
      },
      "description": {
        "en": "The swinging hasp strap: a flat arm with a hinge barrel at one end and a staple slot at the other, plus countersunk screws behind the hinge (covered by the leaf when closed — the safety pattern)."
      },
      "parts": [
        "safety_hasp"
      ],
      "estimate": {
        "base_time": 9,
        "per_unit": 2,
        "per_part": 9
      }
    },
    {
      "id": "staple",
      "scad_file": "main.py",
      "cq_file": "main.py",
      "label": {
        "en": "Staple Loop",
        "es": "Grillete (Staple)"
      },
      "description": {
        "en": "The staple loop the hasp slot drops over: a raised loop bar on a bolt-down base with a window the padlock shackle passes through, and two fixing screws."
      },
      "parts": [
        "staple"
      ],
      "estimate": {
        "base_time": 8,
        "per_unit": 2,
        "per_part": 8
      }
    },
    {
      "id": "shackle_guard",
      "scad_file": "main.py",
      "cq_file": "main.py",
      "label": {
        "en": "Shackle Guard Shroud",
        "es": "Guardián de Arco"
      },
      "description": {
        "en": "A U-shaped shroud that walls three sides of the padlock so bolt-cutters cannot reach the shackle, with a shackle-diameter slot in the front lip and a four-screw base."
      },
      "parts": [
        "shackle_guard"
      ],
      "estimate": {
        "base_time": 11,
        "per_unit": 2,
        "per_part": 11
      }
    }
