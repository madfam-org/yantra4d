      "type": "slider",
      "default": 30.0,
      "min": 12,
      "max": 80,
      "step": 1,
      "group": "cell",
      "modes": [
        "tray",
        "cell_strip",
        "humidity_dome"
      ],
      "label": {
        "en": "Cell Top Width (mm)",
        "es": "Ancho Superior de Celda (mm)"
      },
      "tooltip": {
        "en": "Opening width at the top of each cell",
        "es": "Ancho de la boca en la parte superior de cada celda"
      }
    },
    {
      "id": "cell_taper",
      "type": "slider",
      "default": 6.0,
      "min": 0,
      "max": 30,
      "step": 0.5,
      "group": "cell",
      "modes": [
        "tray",
        "cell_strip"
      ],
      "label": {
        "en": "Cell Taper (mm)",
        "es": "Conicidad de Celda (mm)"
      },
      "tooltip": {
        "en": "How much narrower each cell is at the bottom (eases plug removal)",
        "es": "Cuánto más angosta es cada celda abajo (facilita sacar el cepellón)"
      }
    },
    {
      "id": "depth",
      "type": "slider",
      "default": 45.0,
      "min": 15,
      "max": 120,
      "step": 1,
      "group": "cell",
      "modes": [
        "tray",
        "cell_strip",
        "humidity_dome"
      ],
      "label": {
        "en": "Cell Depth (mm)",
        "es": "Profundidad de Celda (mm)"
      },
      "tooltip": {
        "en": "Depth of each cell (root run)",
        "es": "Profundidad de cada celda (espacio para raíz)"
      }
    },
    {
      "id": "drainage",
      "type": "checkbox",
      "default": true,
      "group": "opts",
      "modes": [
        "tray",
        "cell_strip"
      ],
      "label": {
        "en": "Drainage Holes",
        "es": "Orificios de Drenaje"
      },
      "tooltip": {
        "en": "One hole per cell bottom",
        "es": "Un orificio por fondo de celda"
      }
    },
    {
      "id": "fit_1020",
      "type": "checkbox",
      "default": false,
      "group": "opts",
      "modes": [
        "tray"
      ],
      "label": {
        "en": "1020 Tray Lip",
        "es": "Reborde para Charola 1020"
      },
      "tooltip": {
        "en": "Add a rim lip to seat in a standard 1020 flat",
        "es": "Agregar un reborde para asentar en una charola 1020 estándar"
      }
    },
    {
      "id": "wall",
      "type": "slider",
      "default": 2.0,
      "min": 1.2,
      "max": 6.0,
      "step": 0.2,
      "group": "opts",
      "modes": [
        "tray",
        "cell_strip",
        "humidity_dome"
      ],
      "advanced": true,
      "label": {
        "en": "Wall Thickness (mm)",
        "es": "Grosor de Pared (mm)"
      },
      "tooltip": {
        "en": "Wall between cells and outer wall",
        "es": "Pared entre celdas y pared exterior"
      }
    }
  ],
  "presets": [
    {
      "id": "std_24",
      "mode": "tray",
      "label": {
        "en": "24-Cell Tray (6×4)",
        "es": "Charola de 24 Celdas (6×4)"
      },
      "values": {
        "cols": 6,
        "rows": 4,
        "cell_top": 30,
        "depth": 45
      }
    },
    {
      "id": "deep_9",
      "mode": "tray",
      "label": {
