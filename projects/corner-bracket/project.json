        "geometry_type": "bolt_pattern",
        "standard": "internal",
        "parameters": [
          "holes_per_leg",
          "screw_dia",
          "leg_a",
          "leg_b",
          "width"
        ]
      },
      {
        "id": "leg_face",
        "label": {
          "en": "Leg Mounting Face",
          "es": "Cara de Montaje"
        },
        "geometry_type": "profile",
        "standard": "internal",
        "parameters": [
          "leg_a",
