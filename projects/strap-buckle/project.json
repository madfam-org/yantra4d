        {
          "value": "20mm",
          "label": {
            "en": "20 mm",
            "es": "20 mm"
          }
        },
        {
          "value": "25mm",
          "label": {
            "en": "25 mm (1 in)",
            "es": "25 mm (1 pulg)"
          }
        },
        {
          "value": "38mm",
          "label": {
            "en": "38 mm (1.5 in)",
            "es": "38 mm (1.5 pulg)"
          }
        }
      ]
    },
    {
      "id": "web_t",
      "type": "slider",
      "default": 2.0,
      "min": 1.0,
      "max": 4.0,
      "step": 0.1,
      "group": "webbing",
      "modes": [
        "side_release",
        "slider",
        "tri_glide"
      ],
      "label": {
        "en": "Webbing Thickness (mm)",
        "es": "Grosor de Cincha (mm)"
      },
      "tooltip": {
        "en": "Thickness of the webbing strap",
        "es": "Grosor de la cincha"
      }
    },
    {
      "id": "snap_clear",
      "type": "slider",
      "default": 0.4,
      "min": 0.2,
      "max": 0.8,
      "step": 0.05,
      "group": "snap",
      "modes": [
        "side_release"
      ],
      "advanced": true,
      "label": {
        "en": "Snap Clearance (mm)",
        "es": "Holgura de Ajuste (mm)"
      },
      "tooltip": {
        "en": "Per-face gap between the male and female halves for a printable snap fit",
        "es": "Espacio por cara entre las piezas macho y hembra para un ajuste imprimible"
      }
    },
    {
      "id": "snap_ledge",
      "type": "slider",
      "default": 1.4,
      "min": 0.8,
      "max": 2.5,
      "step": 0.1,
      "group": "snap",
      "modes": [
        "side_release"
      ],
      "advanced": true,
      "label": {
        "en": "Barb Ledge (mm)",
        "es": "Reborde de Enganche (mm)"
      },
      "tooltip": {
        "en": "How far the prong barbs stand proud to catch the housing windows",
        "es": "Cuánto sobresalen los enganches de las lengüetas para atrapar las ventanas de la carcasa"
      }
    },
    {
      "id": "show_gap",
      "type": "slider",
      "default": 0.0,
      "min": 0.0,
      "max": 20.0,
      "step": 0.5,
      "group": "snap",
      "modes": [
        "side_release"
      ],
      "advanced": true,
      "label": {
        "en": "Explode Gap (mm)",
        "es": "Separación de Vista (mm)"
      },
      "tooltip": {
        "en": "Slide the male half out for an exploded assembly view (cosmetic)",
        "es": "Desliza la pieza macho para una vista explosionada (cosmético)"
      }
    },
    {
      "id": "wall",
      "type": "slider",
      "default": 2.4,
      "min": 1.6,
      "max": 4.0,
      "step": 0.2,
      "group": "build",
      "modes": [
        "side_release",
        "slider",
        "tri_glide"
      ],
      "label": {
        "en": "Wall Thickness (mm)",
        "es": "Grosor de Pared (mm)"
      },
      "tooltip": {
        "en": "Structural wall / bar thickness",
        "es": "Grosor de la pared / barra estructural"
      }
    }
  ],
  "presets": [
