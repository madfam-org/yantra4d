  "constraints": [
    {
      "expression": "bust_girth >= chest_girth",
      "message": {
        "en": "Bust girth is measured over the fullest part and is at least the chest girth.",
        "es": "El contorno de busto se mide en la parte más llena y es al menos el de pecho."
      }
    },
    {
      "expression": "hip_girth >= waist_girth * 0.9",
      "message": {
        "en": "A hip much smaller than the waist makes an unnatural seat curve.",
        "es": "Una cadera mucho menor que la cintura crea una curva de asiento poco natural."
      }
    },
    {
      "expression": "knee_girth <= thigh_girth * 0.92",
      "message": {
        "en": "The leg must taper: the knee ring is smaller than the thigh ring.",
        "es": "La pierna debe afinarse: el anillo de rodilla es menor que el de muslo."
      }
    },
    {
      "expression": "ankle_girth <= knee_girth * 0.92",
      "message": {
        "en": "The leg must taper: the ankle ring is smaller than the knee ring.",
        "es": "La pierna debe afinarse: el anillo de tobillo es menor que el de rodilla."
      }
    }
  ],
