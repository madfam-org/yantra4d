---
import type { Translations } from '../lib/i18n';

interface Props {
  t?: Translations;
}

const { t } = Astro.props;
---

<section class="cv-auto py-16 sm:py-24 px-4 sm:px-6">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="mb-4 text-2xl xs:text-3xl font-bold tracking-tight sm:text-4xl">{t?.cta.heading ?? 'Tu próxima impresión empieza aquí'}</h2>
    <p class="mb-8 text-muted-foreground">
      {t?.cta.subtitle ?? 'Sin cuenta. Sin instalar nada. Solo abre.'}
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="#gallery"
        class="rounded-md bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 min-h-[44px] inline-flex items-center justify-center"
      >
        {t?.cta.ctaMakers ?? 'Explorar Galería'}
      </a>
      <a
        href="https://github.com/madfam-org/solid-hyperobjects"
        class="rounded-md border border-border px-6 py-3 text-sm font-medium text-foreground transition-colors hover:bg-accent min-h-[44px] inline-flex items-center justify-center"
      >
        {t?.cta.ctaCreators ?? 'Contribuye un Diseño'}
      </a>
    </div>
  </div>
</section>
