  "parameter_groups": [
    {
      "id": "gear",
      "label": {
        "en": "Gear Geometry",
        "es": "Geometría del Engrane"
      }
    },
    {
      "id": "rack",
      "label": {
        "en": "Rack Body",
        "es": "Cuerpo de Cremallera"
      }
    },
    {
      "id": "mounting",
      "label": {
        "en": "Mounting",
        "es": "Montaje"
      }
    },
    {
      "id": "pinion",
      "label": {
        "en": "Pinion",
        "es": "Piñón"
      }
    }
  ],
  "parameters": [
    {
      "id": "m",
      "type": "slider",
      "default": 2.0,
      "min": 0.5,
      "max": 6.0,
      "step": 0.5,
      "group": "gear",
      "modes": [
        "rack",
        "rack_with_holes",
        "rack_and_pinion"
      ],
      "label": {
        "en": "Module (mm)",
        "es": "Módulo (mm)"
      },
      "tooltip": {
        "en": "Tooth size; circular pitch = pi x module. Must match the pinion.",
        "es": "Tamaño del diente; paso circular = pi x módulo. Debe coincidir con el piñón."
      }
    },
    {
      "id": "pressure_angle",
      "type": "select",
      "default": 20,
      "group": "gear",
      "modes": [
        "rack",
        "rack_with_holes",
        "rack_and_pinion"
      ],
      "label": {
        "en": "Pressure Angle",
        "es": "Ángulo de Presión"
      },
      "tooltip": {
        "en": "Flank inclination standard. 20 deg is the modern default.",
        "es": "Estándar de inclinación del flanco. 20 grados es el valor moderno."
      },
      "options": [
        {
          "value": 14.5,
          "label": {
            "en": "14.5 deg (legacy)",
            "es": "14.5 grados (heredado)"
          }
        },
        {
          "value": 20,
          "label": {
            "en": "20 deg (standard)",
            "es": "20 grados (estándar)"
          }
        },
        {
          "value": 25,
          "label": {
            "en": "25 deg (high load)",
            "es": "25 grados (alta carga)"
          }
        }
      ]
    },
    {
      "id": "rack_teeth",
      "type": "slider",
      "default": 12,
      "min": 2,
      "max": 60,
      "step": 1,
      "group": "rack",
      "modes": [
        "rack",
        "rack_with_holes",
        "rack_and_pinion"
      ],
      "label": {
        "en": "Rack Teeth",
        "es": "Dientes de Cremallera"
      },
      "tooltip": {
        "en": "Number of teeth; length = teeth x pi x module.",
        "es": "Número de dientes; longitud = dientes x pi x módulo."
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "x",
        "scale_factor": 6.28
      }
    },
    {
      "id": "width",
      "type": "slider",
      "default": 12.0,
      "min": 3.0,
      "max": 40.0,
      "step": 1.0,
      "group": "rack",
      "modes": [
        "rack",
        "rack_with_holes",
        "rack_and_pinion"
      ],
      "label": {
        "en": "Face Width (mm)",
        "es": "Ancho de Cara (mm)"
      },
      "tooltip": {
        "en": "Tooth face width / thickness in Z.",
        "es": "Ancho de cara del diente / grosor en Z."
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "z",
        "scale_factor": 1.0
      }
    },
    {
      "id": "height",
      "type": "slider",
      "default": 10.0,
      "min": 2.0,
      "max": 30.0,
      "step": 1.0,
      "group": "rack",
      "modes": [
        "rack",
        "rack_with_holes",
        "rack_and_pinion"
      ],
      "label": {
        "en": "Backing Height (mm)",
        "es": "Altura de Respaldo (mm)"
      },
      "tooltip": {
        "en": "Solid backing below the tooth roots.",
        "es": "Respaldo sólido debajo de las raíces de los dientes."
      }
    },
    {
      "id": "mount_holes",
      "type": "checkbox",
      "default": false,
      "group": "mounting",
      "modes": [
        "rack",
        "rack_and_pinion"
      ],
      "label": {
        "en": "Mounting Holes",
        "es": "Orificios de Montaje"
      },
      "tooltip": {
        "en": "Add through-holes along the rack back.",
        "es": "Agregar orificios pasantes a lo largo del respaldo."
      }
    },
    {
      "id": "hole_dia",
      "type": "slider",
      "default": 4.0,
      "min": 2.0,
      "max": 10.0,
      "step": 0.5,
      "group": "mounting",
      "modes": [
        "rack",
        "rack_with_holes",
        "rack_and_pinion"
      ],
      "label": {
        "en": "Hole Diameter (mm)",
        "es": "Diámetro de Orificio (mm)"
      },
      "tooltip": {
        "en": "Mounting-hole diameter.",
        "es": "Diámetro del orificio de montaje."
      }
    },
    {
      "id": "hole_count",
      "type": "slider",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 1,
      "group": "mounting",
      "modes": [
        "rack",
        "rack_with_holes",
        "rack_and_pinion"
      ],
      "label": {
        "en": "Hole Count",
        "es": "Número de Orificios"
      },
      "tooltip": {
        "en": "How many evenly-spaced mounting holes.",
        "es": "Cuántos orificios de montaje equidistantes."
      }
    },
    {
      "id": "include_pinion",
      "type": "checkbox",
      "default": false,
      "group": "pinion",
      "modes": [
        "rack_and_pinion"
      ],
      "label": {
        "en": "Include Pinion",
        "es": "Incluir Piñón"
      },
      "tooltip": {
        "en": "Add a matching involute pinion beside the rack.",
        "es": "Agregar un piñón de involuta a juego junto a la cremallera."
      }
    },
    {
      "id": "pinion_teeth",
      "type": "slider",
      "default": 16,
      "min": 6,
      "max": 60,
      "step": 1,
      "group": "pinion",
      "modes": [
        "rack_and_pinion"
      ],
      "label": {
        "en": "Pinion Teeth",
        "es": "Dientes del Piñón"
      },
      "tooltip": {
        "en": "Pinion tooth count (shares module and pressure angle).",
        "es": "Número de dientes del piñón (comparte módulo y ángulo de presión)."
      }
    },
    {
      "id": "bore",
      "type": "slider",
      "default": 6.0,
      "min": 0.0,
      "max": 20.0,
      "step": 0.5,
      "group": "pinion",
      "modes": [
        "rack_and_pinion"
      ],
      "advanced": true,
      "label": {
        "en": "Pinion Bore (mm)",
        "es": "Barreno del Piñón (mm)"
      },
      "tooltip": {
        "en": "Central shaft bore in the pinion (0 = solid).",
        "es": "Barreno central del eje en el piñón (0 = sólido)."
      }
    },
    {
      "id": "flank_pts",
      "type": "slider",
      "default": 9,
      "min": 4,
      "max": 16,
      "step": 1,
      "group": "pinion",
      "modes": [
        "rack_and_pinion"
      ],
      "advanced": true,
      "label": {
        "en": "Pinion Flank Samples",
        "es": "Muestras de Flanco del Piñón"
      },
      "tooltip": {
        "en": "Involute samples per flank on the pinion (facet control).",
        "es": "Muestras de involuta por flanco en el piñón (control de facetas)."
      }
    }
  ],
