{
  "project": {
    "name": "Breadboard Holder",
    "slug": "breadboard-holder",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A base that holds a solderless breadboard or perfboard flat and captive on the bench while you wire a circuit. A recessed pocket sized to the standard breadboard footprint receives the board; retaining lips hold it down and corner ears bolt it to a project base. Variants add flanking power-rail channels for the clip-off DC rails, or an angled easel that tilts the board toward you.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Una base que sujeta una protoboard o placa perforada plana y firme en la mesa mientras cableas un circuito. Un bolsillo rebajado dimensionado a la huella estándar de protoboard recibe la placa; unos labios de retención la sujetan y orejas de esquina la atornillan a una base. Las variantes agregan canales laterales para los rieles de alimentación desprendibles, o un caballete inclinado que orienta la placa hacia ti.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/breadboard-holder.webp",
    "difficulty": "beginner",
    "tags": [
      "breadboard",
      "perfboard",
      "holder",
      "electronics",
      "prototyping",
      "maker",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
  "modes": [
    {
      "id": "base_tray",
      "label": {
        "en": "Base Tray",
        "es": "Bandeja Base"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": [
        "base_tray"
      ],
      "estimate": {
