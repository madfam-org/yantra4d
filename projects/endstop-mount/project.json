      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "Every 3D printer, CNC and robot axis needs its endstop held at exactly the right spot, and the OEM bracket rarely fits a modified frame. A printed mount cut to the standard Omron microswitch footprint, with adjustment slots, lets any salvaged limit switch home a machine precisely.",
      "es": "Cada eje de impresora 3D, CNC y robot necesita su endstop sujeto en el punto exacto, y el soporte original rara vez encaja en un marco modificado. Un montaje impreso cortado a la huella estandar del microinterruptor Omron, con ranuras de ajuste, permite que cualquier interruptor de limite rescatado ubique una maquina con precision."
    },
    "commons_license": "CERN-OHL-W-2.0"
  },
