    {"id": "SLOT_KEY_X0", "expr": "2.0"},
    {"id": "SLOT_KEY_X1", "expr": "48.0"},
    {"id": "bo_cap", "expr": "belt_offset < 30 ? belt_offset : 30"},
    {"id": "bo", "expr": "10 > bo_cap ? 10 : bo_cap"},
    {"id": "bp_cap", "expr": "belt_plane < 29 ? belt_plane : 29"},
    {"id": "bp", "expr": "12 > bp_cap ? 12 : bp_cap"},
    {"id": "cd_cap", "expr": "center_distance < 42.8 ? center_distance : 42.8"},
    {"id": "cd", "expr": "38.8 > cd_cap ? 38.8 : cd_cap"},
    {"id": "bpo_cap", "expr": "big_pulley_od < 60 ? big_pulley_od : 60"},
    {"id": "bpo", "expr": "50 > bpo_cap ? 50 : bpo_cap"},
    {"id": "mp_cap", "expr": "mount_pitch < 30 ? mount_pitch : 30"},
    {"id": "mp", "expr": "(TNUT_L + 1) > mp_cap ? (TNUT_L + 1) : mp_cap"},
    {"id": "TOP", "expr": "-PROFILE / 2"},
    {"id": "Z", "expr": "-(10 + TOP_T + bpo / 2 + PULLEY_CLEAR)"},
    {"id": "Y", "expr": "bp"},
    {"id": "BX", "expr": "bo"},
    {"id": "MX", "expr": "BX + cd"},
    {"id": "A_IN", "expr": "P20_W / 2 + GAP"},
    {"id": "A_OUT", "expr": "A_IN + LIP + BEARING_W"},
    {"id": "B_OPEN", "expr": "-(P20_L - P20_W / 2) - GAP"},
    {"id": "B_BACK", "expr": "B_OPEN - BEARING_W - LIP"},
    {"id": "C_OPEN", "expr": "B_BACK - GAP - P80_L - GAP"},
    {"id": "C_OUT", "expr": "C_OPEN - BEARING_W - LIP"},
    {"id": "floor_top", "expr": "Z - bpo / 2 - PULLEY_CLEAR"},
    {"id": "z_bot", "expr": "floor_top - FLOOR_T"},
    {"id": "x2", "expr": "MOUNT_X1 + mp"},
    {"id": "X0_a", "expr": "-PROFILE / 2 - TAB_W / 2 - 1"},
    {"id": "X0_b", "expr": "BX - bpo / 2 - 2"},
    {"id": "X0", "expr": "X0_a < X0_b ? X0_a : X0_b"},
    {"id": "X1_a", "expr": "x2 + HEAD_DK / 2 + HEAD_CLEAR + EDGE"},
    {"id": "X1_b", "expr": "MX + NEMA_HALF + 3"},
    {"id": "X1", "expr": "X1_a > X1_b ? X1_a : X1_b"},
    {"id": "Y0", "expr": "Y + C_OUT"},
    {"id": "Y1", "expr": "Y + A_OUT"},
    {"id": "xr", "expr": "BX + WALL_REACH"},
    {"id": "key_y1", "expr": "CORNER_KEY_Y1 < Y1 - 1 ? CORNER_KEY_Y1 : Y1 - 1"},
    {"id": "half", "expr": "P20_PD / 2 + BELT_B + BELT_SLOT_MARGIN"},
    {"id": "yc0", "expr": "Y + C_OUT - 1"},
    {"id": "yc1", "expr": "Y + C_OPEN + 1"}
  ],
