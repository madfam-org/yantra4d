      "cq_file": "main.py",
      "engine": "cadquery",
      "label": {
        "en": "Cuvette Holder Block",
        "es": "Bloque Portacubetas"
      },
      "description": {
        "en": "Multi-well block sized for 12.5 mm square (10 mm path) cuvettes, with a beam-access window at each well so light reaches the sample."
      },
      "parts": ["cuvette_block"],
      "estimate": {
        "base_units": 1,
        "formula": "per_part"
      }
    },
    {
      "id": "hub_cap",
      "scad_file": "main.py",
      "cq_file": "main.py",
      "engine": "cadquery",
      "label": {
        "en": "Retaining Hub Cap",
        "es": "Tapa de Cubo Retenedora"
      },
      "description": {
        "en": "Stepped cap with a locating boss and shaft bore that pins the wheel to its shaft; fluted rim for finger grip."
      },
      "parts": ["hub_cap"],
      "estimate": {
        "base_units": 1,
        "formula": "per_part"
      }
    }
  ],
