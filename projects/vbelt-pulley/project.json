      "group": "hub", "modes": ["vbelt", "roundbelt", "multi_groove"],
      "label": { "en": "Set-Screw Hole", "es": "Agujero de Prisionero" },
      "tooltip": { "en": "Radial hole through the hub wall to lock the pulley to the shaft", "es": "Agujero radial por la pared del cubo para fijar la polea al eje" }
