{
  "project": {
    "name": "Beaker / Flask Clamp",
    "slug": "flask-clamp",
    "version": "1.0.0",
    "description": {
      "en": "Lab-glassware support hyperobject: an open C-ring clamp that hugs an Erlenmeyer or beaker body and locks onto a ring-stand rod, an inverted-neck drying holder sized to standard 34 mm flask necks, and a weighted rod-stand base. Sized to real borosilicate glassware and 12 mm support rods.",
      "es": "Hiperobjeto de soporte para material de vidrio: una abrazadera en C abierta que sujeta un matraz Erlenmeyer o vaso y se fija a una varilla de soporte, un soporte de secado por cuello invertido para cuellos estándar de 34 mm, y una base con peso para varilla. Dimensionado a vidrio borosilicato real y varillas de 12 mm."
    },
    "thumbnail": "/projects/flask-clamp.webp",
    "tags": ["flask", "beaker", "clamp", "ring-stand", "glassware", "lab", "medical", "hyperobject", "commons"],
    "difficulty": "intermediate",
    "hyperobject": {
      "is_hyperobject": true
    },
    "engine": "cadquery",
    "force_backend": true
  },
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "medical",
    "material_awareness": {
      "shrinkage_compensation": true,
      "recycled_material_toggle": true,
      "tolerance_by_material": true,
      "notes": {
        "en": "Ring bore uses +1.0 mm clearance around the vessel; print the clamp in PETG for heat and solvent resistance near hotplates.",
        "es": "El anillo usa +1.0 mm de holgura alrededor del recipiente; imprime la abrazadera en PETG para resistencia al calor y solventes cerca de placas calientes."
      }
    },
    "cdg_interfaces": [
      {
        "id": "vessel_ring",
        "label": {
          "en": "Vessel Body Ring",
          "es": "Anillo del Cuerpo del Recipiente"
        },
        "geometry_type": "socket",
        "standard": "Erlenmeyer/beaker body Ø70-108 mm",
        "parameters": ["vessel_diameter"]
      },
      {
        "id": "rod_mount",
        "label": {
          "en": "Ring-Stand Rod Mount",
          "es": "Montaje de Varilla de Soporte"
        },
        "geometry_type": "socket",
        "standard": "12 mm / 1/2 in support rod",
        "parameters": ["rod_diameter"]
      },
      {
        "id": "neck_socket",
        "label": {
          "en": "Flask Neck Socket",
          "es": "Alojamiento de Cuello de Matraz"
        },
        "geometry_type": "socket",
        "standard": "34 mm flask neck OD (250/500 mL)",
        "parameters": ["neck_diameter", "neck_holes"]
      }
    ],
    "societal_benefit": {
      "en": "Replaces cast-iron clamps and rings with reprintable supports so field and teaching labs can hold glassware safely without heavy proprietary hardware.",
      "es": "Reemplaza abrazaderas y anillos de hierro fundido con soportes reimprimibles para que laboratorios de campo y docentes sostengan vidrio de forma segura sin hardware pesado propietario."
    },
    "commons_license": "CERN-OHL-W-2.0"
  },
  "modes": [
    {
      "id": "ring_clamp",
      "scad_file": "main.py",
      "cq_file": "main.py",
      "engine": "cadquery",
      "label": {
        "en": "Rod-Mounted C-Ring Clamp",
        "es": "Abrazadera en C para Varilla"
      },
      "description": {
        "en": "Open C-ring that hugs a flask/beaker body and clamps onto a ring-stand rod via a slit clamp and cross screw bore."
      },
      "parts": ["ring_clamp"],
      "estimate": {
        "base_units": 1,
        "formula": "per_part"
      }
    },
    {
      "id": "neck_holder",
      "scad_file": "main.py",
      "cq_file": "main.py",
      "engine": "cadquery",
      "label": {
        "en": "Inverted-Neck Drying Holder",
        "es": "Soporte de Secado por Cuello"
      },
      "description": {
        "en": "Raised plate with keyed neck cutouts so flasks sit inverted to drain and dry, lifted on four corner legs for airflow."
      },
      "parts": ["neck_holder"],
      "estimate": {
        "base_units": 1,
        "formula": "per_part"
      }
    },
    {
      "id": "rod_stand_base",
      "scad_file": "main.py",
      "cq_file": "main.py",
      "engine": "cadquery",
      "label": {
        "en": "Weighted Rod-Stand Base",
        "es": "Base con Peso para Varilla"
      },
      "description": {
        "en": "Heavy footed base with a rear vertical rod socket and underside weight pockets, so glassware overhangs the front."
      },
      "parts": ["rod_stand_base"],
      "estimate": {
        "base_units": 1,
        "formula": "per_part"
      }
    }
  ],
  "parts": [
    {
