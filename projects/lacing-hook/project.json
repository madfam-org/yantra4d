{
  "project": {
    "name": "Lacing Hook",
    "slug": "lacing-hook",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A 3D-printed lacing hook — the upturned speed hook a lace zig-zags over on a corset, a bodice, or a boot-style closure. This is the rigid hard good the Fashion Cabinet `lacing-hook` notion places and bridges to here for its geometry, and it pairs with `garment-eyelet` on the opposing edge. Sized so a garment's finished lacing dimensions drive the finding.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Un gancho de cordón impreso en 3D — el gancho rápido, de cuerno hacia arriba, sobre el que se cruza el cordón en un corsé, un corpiño o un cierre tipo bota. Es el herraje rígido que el avío `lacing-hook` de Fashion Cabinet coloca y al que se puentea aquí, y hace juego con `garment-eyelet` en el borde opuesto. Dimensionado para que las medidas terminadas del cordonado de la prenda determinen el avío.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/lacing-hook.webp",
    "difficulty": "intermediate",
    "tags": [
      "lacing-hook",
      "speed-hook",
      "lacing",
      "corsetry",
      "boot",
      "closure",
      "hardware",
      "fastener",
      "finding",
      "wearable",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
  "modes": [
    {
      "id": "set",
      "label": {
        "en": "Hook Row",
        "es": "Hilera de ganchos"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": [
        "set"
      ],
      "estimate": {
        "base_time": 10,
        "per_unit": 2,
        "per_part": 6
      }
    },
    {
      "id": "hook",
      "label": {
        "en": "Single Hook",
        "es": "Gancho suelto"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": [
        "hook"
      ],
      "estimate": {
        "base_time": 10,
        "per_unit": 2,
        "per_part": 6
      }
    }
  ],
  "parts": [
    {
      "id": "set",
      "label": {
        "en": "Hook Row",
        "es": "Hilera de ganchos"
      },
      "render_mode": 0,
      "color": "#b0a890"
    },
    {
      "id": "hook",
      "label": {
        "en": "Single Hook",
        "es": "Gancho suelto"
      },
      "render_mode": 0,
      "color": "#a89c86"
    }
  ],
  "parameter_groups": [
    {
      "id": "row",
      "label": {
        "en": "Row",
        "es": "Hilera"
      }
    },
    {
      "id": "plate",
      "label": {
        "en": "Base Plate",
        "es": "Placa base"
      }
    },
    {
      "id": "horn",
      "label": {
        "en": "Horn",
        "es": "Cuerno"
      }
    }
  ],
  "parameters": [
    {
      "id": "hook_count",
      "type": "slider",
      "default": 4,
      "min": 2,
      "max": 8,
      "step": 1,
      "group": "row",
      "modes": [
        "set"
      ],
      "label": {
        "en": "Hooks in the row",
        "es": "Ganchos en la hilera"
      },
      "tooltip": {
        "en": "How many hooks are generated along the row (set mode only).",
        "es": "Cuántos ganchos se generan a lo largo de la hilera (solo en modo hilera)."
      }
    },
    {
      "id": "pitch",
      "type": "slider",
      "default": 12.0,
      "min": 8.0,
      "max": 25.0,
      "step": 0.5,
      "group": "row",
      "modes": [
        "set"
      ],
      "label": {
        "en": "Hook spacing (mm)",
        "es": "Separación entre ganchos (mm)"
      },
      "tooltip": {
        "en": "Centre-to-centre spacing between hooks along the row (mm); it is never allowed to fall below the plate width.",
        "es": "Separación de centro a centro entre ganchos a lo largo de la hilera (mm); nunca baja del ancho de la placa."
      }
    },
    {
      "id": "cord_dia",
      "type": "slider",
      "default": 4.0,
      "min": 2.0,
      "max": 6.0,
      "step": 0.5,
      "group": "horn",
      "modes": [
        "set",
        "hook"
      ],
      "label": {
        "en": "Cord diameter (mm)",
        "es": "Diámetro del cordón (mm)"
      },
      "tooltip": {
        "en": "Diameter of the lace or cord (mm). The horn mouth opens 0.5 mm wider than this so the cord drops in cleanly.",
        "es": "Diámetro del cordón o agujeta (mm). La boca del cuerno abre 0.5 mm más que esto para que el cordón entre con holgura."
      }
    },
    {
      "id": "plate_w",
      "type": "slider",
      "default": 9.0,
      "min": 6.0,
      "max": 14.0,
      "step": 0.5,
      "group": "plate",
      "modes": [
        "set",
        "hook"
      ],
      "label": {
        "en": "Plate width (mm)",
        "es": "Ancho de la placa (mm)"
      },
      "tooltip": {
        "en": "Width of the base plate across the lacing edge (mm).",
        "es": "Ancho de la placa base a lo largo del borde de cordonado (mm)."
      }
    },
    {
      "id": "plate_t",
      "type": "slider",
      "default": 1.6,
      "min": 1.2,
      "max": 3.0,
      "step": 0.1,
      "group": "plate",
      "modes": [
        "set",
        "hook"
      ],
      "label": {
        "en": "Plate thickness (mm)",
        "es": "Espesor de la placa (mm)"
      },
      "tooltip": {
        "en": "Thickness of the base plate (mm); it also sets the horn stock gauge.",
        "es": "Espesor de la placa base (mm); también fija el calibre del cuerno."
      }
    },
    {
      "id": "rivet_hole_dia",
      "type": "slider",
      "default": 2.5,
      "min": 1.5,
      "max": 4.0,
      "step": 0.1,
      "group": "plate",
      "modes": [
        "set",
        "hook"
      ],
      "label": {
        "en": "Rivet hole diameter (mm)",
        "es": "Diámetro del barreno del remache (mm)"
      },
      "tooltip": {
        "en": "Setting hole through the plate for the rivet or tack (mm); it is capped so material always remains around it.",
        "es": "Barreno de fijación en la placa para el remache o tachuela (mm); se limita para que siempre quede material alrededor."
      }
    }
  ],
  "presets": [
