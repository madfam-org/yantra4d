{
  "project": {
    "name": "Fin-Ray Gripper Jaw",
    "slug": "finray-gripper",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A compliant Fin-Ray-effect gripper jaw: a triangular ribbed finger that wraps toward the load when pushed, form-fitting fragile or irregular parts with no actuator. One mode carries a real 24T/25T servo output spline so a jaw bolts straight onto a hobby servo — bridging soft-robotics to the servo family. Print rigid for a light-compliance jaw, or in TPU for a soft wrapping one.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Una mordaza de agarre compatible de efecto Fin-Ray: un dedo triangular con nervaduras que envuelve hacia la carga al empujarlo, adaptandose a piezas fragiles o irregulares sin actuador. Un modo lleva un estriado de servo real 24T/25T para montar la mordaza directamente en un servo — uniendo la robotica blanda a la familia de servos. Imprime rigido para una mordaza de compliancia ligera, o en TPU para una envolvente blanda.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/finray-gripper.webp",
    "difficulty": "advanced",
    "tags": ["soft-robotics", "fin-ray", "gripper", "jaw", "compliant-mechanism", "servo", "robotics", "hyperobject", "commons"],
    "hyperobject": { "is_hyperobject": true },
    "force_backend": true
  },
  "modes": [
    {
      "id": "finray_jaw",
      "label": { "en": "Fin-Ray Jaw", "es": "Mordaza Fin-Ray" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["finray_jaw"],
      "estimate": { "base_time": 17, "per_unit": 5, "per_part": 18 }
    },
    {
