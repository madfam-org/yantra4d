#!/bin/sh

# Sync fallback manifest if source has changed.
# The fallback manifest is for offline/WASM mode, so force_backend must be
# stripped — it would prevent WASM rendering when the backend is unreachable.
MANIFEST_SRC="projects/gridfinity/project.json"
MANIFEST_DST="apps/studio/src/config/fallback-manifest.json"
MANIFEST_TMP=$(mktemp)
# Build the expected fallback (source minus force_backend)
sed '/"force_backend":/d' "$MANIFEST_SRC" > "$MANIFEST_TMP"
if ! cmp -s "$MANIFEST_TMP" "$MANIFEST_DST"; then
  echo "husky: Syncing fallback manifest before commit..."
  cp "$MANIFEST_TMP" "$MANIFEST_DST"
  git add "$MANIFEST_DST"
fi
rm -f "$MANIFEST_TMP"

# Run Lint Staged in Studio
(cd apps/studio && npx lint-staged) || exit 1

# Run Python Linting (Ruff)
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ -n "$STAGED_PY" ]; then
  if command -v ruff >/dev/null 2>&1; then
    echo "$STAGED_PY" | xargs ruff check
  else
    echo "Warning: ruff not found, skipping Python lint"
  fi
fi
