      "max": 0.8,
      "step": 0.05,
      "group": "fit",
      "modes": [
        "ght_to_barb",
        "faucet_to_ght",
        "coupler"
      ],
      "label": {
        "en": "Thread Clearance (mm)",
        "es": "Holgura de Rosca (mm)"
      },
      "tooltip": {
        "en": "Per-side thread fit slop for a printable thread",
        "es": "Holgura por lado para una rosca imprimible"
      }
    },
    {
      "id": "grip_knurl",
      "type": "checkbox",
      "default": true,
