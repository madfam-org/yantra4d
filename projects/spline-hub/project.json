      "group": "flange",
      "modes": [
        "keyed_hub",
        "spline_hub",
        "hex_hub"
      ],
      "advanced": true,
      "label": {
        "en": "Flange Bolt Ø (mm)",
        "es": "Ø de Perno de Brida (mm)"
      },
      "tooltip": {
        "en": "Diameter of the flange bolt holes",
        "es": "Diámetro de los orificios de perno de la brida"
      }
    }
  ],
