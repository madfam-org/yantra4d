  "constraints": [
    {
      "expression": "rib_w >= 1.5",
      "severity": "warning",
      "message": { "en": "Ribs below 1.5 mm are fragile and hard to print", "es": "Nervaduras menores a 1.5 mm son fragiles y dificiles de imprimir" }
    },
    {
      "expression": "fin_base >= 18",
      "severity": "warning",
      "message": { "en": "A narrow base reduces Fin-Ray wrap and grip", "es": "Una base estrecha reduce la envoltura y agarre Fin-Ray" }
    }
  ],
  "camera_views": [
    { "id": "iso", "label": { "en": "Isometric", "es": "Isometrico" }, "position": [90, 90, 70] },
    { "id": "top", "label": { "en": "Top", "es": "Superior" }, "position": [0, 40, 160] },
    { "id": "front", "label": { "en": "Front", "es": "Frontal" }, "position": [140, 0, 20] }
