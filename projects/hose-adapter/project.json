      "tooltip": {
        "en": "Central fluid channel diameter",
        "es": "Diámetro del canal central de fluido"
      }
    },
    {
      "id": "barb_dia",
      "type": "slider",
      "default": 13.0,
      "min": 6,
      "max": 24,
      "step": 0.5,
      "group": "flow",
      "modes": [
        "ght_to_barb"
      ],
      "label": {
        "en": "Barb OD (mm)",
        "es": "DE de Espiga (mm)"
