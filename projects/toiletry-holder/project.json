          "hole_d",
          "hole_count"
        ]
      },
      {
        "id": "wall_screw_mount",
        "label": {
          "en": "Wall Screw Mount",
          "es": "Montaje con Tornillo"
        },
        "geometry_type": "bolt_pattern",
        "standard": "ISO 7045 M4",
        "parameters": [
