[submodule "libs/BOSL2"]
	path = libs/BOSL2
	url = https://github.com/BelfrySCAD/BOSL2.git
[submodule "libs/NopSCADlib"]
	path = libs/NopSCADlib
	url = https://github.com/nophead/NopSCADlib.git
[submodule "libs/Round-Anything"]
	path = libs/Round-Anything
	url = https://github.com/Irev-Dev/Round-Anything.git
[submodule "libs/threads-scad"]
	path = libs/threads-scad
	url = https://github.com/rcolyer/threads-scad.git
[submodule "libs/MCAD"]
	path = libs/MCAD
	url = https://github.com/openscad/MCAD.git
[submodule "libs/dotSCAD"]
	path = libs/dotSCAD
	url = https://github.com/JustinSDK/dotSCAD.git
[submodule "projects"]
	path = projects
	url = https://github.com/madfam-org/solid-hyperobjects.git
	branch = main
[submodule "private-projects/tablaco"]
	path = private-projects/tablaco
	url = https://github.com/madfam-org/tablaco.git
	update = none
[submodule "private-projects/tablaco-v2"]
	path = private-projects/tablaco-v2
