      "label": { "en": "Tee Shaft Diameter (mm)", "es": "Diámetro del Tee (mm)" },
      "tooltip": { "en": "Diameter of the tee shaft the sockets hold", "es": "Diámetro del cuerpo del tee que sostienen los orificios" }
    },
    {
      "id": "tee_count", "type": "slider", "default": 5, "min": 2, "max": 12, "step": 1,
      "group": "variant", "modes": ["tee_holder"],
      "label": { "en": "Tee Count", "es": "Número de Tees" },
      "tooltip": { "en": "How many tees the holder carries", "es": "Cuántos tees lleva el porta-tees" }
    },
    {
      "id": "wall", "type": "slider", "default": 3.0, "min": 2.0, "max": 6.0, "step": 0.2,
      "group": "sizes", "modes": ["tee_holder", "ball_marker", "alignment_tool"],
      "label": { "en": "Wall Thickness (mm)", "es": "Grosor de Pared (mm)" },
      "tooltip": { "en": "Body wall thickness", "es": "Grosor de la pared del cuerpo" }
    },
    {
      "id": "marker_dia", "type": "slider", "default": 24, "min": 18, "max": 36, "step": 1,
      "group": "variant", "modes": ["ball_marker"],
      "label": { "en": "Marker Diameter (mm)", "es": "Diámetro del Marcador (mm)" },
      "tooltip": { "en": "Diameter of the ball marker disc", "es": "Diámetro del disco marcador" }
    },
    {
      "id": "slot_w", "type": "slider", "default": 2.2, "min": 1.2, "max": 4.0, "step": 0.1,
      "group": "variant", "modes": ["alignment_tool"],
      "label": { "en": "Pen Slot Width (mm)", "es": "Ancho de Ranura para Pluma (mm)" },
      "tooltip": { "en": "Width of the line-drawing slot (match your pen tip)", "es": "Ancho de la ranura para trazar la línea (según la punta de tu pluma)" }
    }
  ],
  "presets": [
    {
      "id": "five_tee_clip", "mode": "tee_holder",
      "label": { "en": "Five-Tee Belt Clip", "es": "Clip de Cinco Tees" },
      "values": { "tee_dia": 5.5, "tee_count": 5 }
