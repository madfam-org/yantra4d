  "estimate_constants": {
    "base_time": 10,
    "per_unit": 3,
    "per_part": 12,
    "fn_factor": 32,
    "wasm_multiplier": 4,
    "warning_threshold_seconds": 90
  },
  "hyperobject": {
    "domain": "household",
    "cdg_interfaces": [
      {
        "id": "gridfinity_grid",
        "label": {
          "en": "Gridfinity 42mm Grid",
          "es": "Rejilla Gridfinity de 42mm"
        },
        "geometry_type": "grid",
        "standard": "Gridfinity (42mm module, 7mm Z-unit)",
        "parameters": [
          "grid_x",
          "grid_y",
          "grid_z"
        ],
        "compatible_with": [
          "multiboard"
        ]
      },
      {
        "id": "gridfinity_base_profile",
        "label": {
          "en": "Gridfinity Base Profile",
          "es": "Perfil Base Gridfinity"
        },
        "geometry_type": "profile",
        "standard": "Gridfinity stacking-lip profile (0.8/1.8/2.15 mm chamfer stack, ~4.75 mm)",
        "parameters": [
          "lip_enabled",
          "bp_thickness"
        ]
      },
      {
        "id": "gridfinity_baseplate_snap",
        "label": {
          "en": "Baseplate Snap Interface",
          "es": "Interfaz de Encaje a Placa"
        },
        "geometry_type": "snap",
        "standard": "Gridfinity baseplate socket (0.25 mm clearance)",
        "parameters": [
          "grid_x",
          "grid_y",
          "bp_thickness"
        ]
      },
      {
        "id": "magnet_socket_6x2",
        "label": {
          "en": "6×2mm Magnet Socket",
          "es": "Alojamiento para Imán 6×2mm"
        },
        "geometry_type": "socket",
        "standard": "6mm dia × 2mm N52 neodymium",
        "parameters": [
          "enable_magnets"
        ]
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": false
    },
    "societal_benefit": {
      "en": "A universal, freely licensed modular storage grid for workshops, offices, and homes. One shared 42 mm/7 mm standard lets bins, trays, and baseplates from any maker interoperate — reducing single-use organizers and packaging waste while keeping storage repairable and endlessly reconfigurable.",
      "es": "Una rejilla de almacenamiento modular universal y de licencia libre para talleres, oficinas y hogares. Un estándar compartido de 42 mm/7 mm permite que contenedores, bandejas y placas base de cualquier fabricante sean interoperables — reduciendo organizadores de un solo uso y residuos de empaque, manteniendo el almacenamiento reparable e infinitamente reconfigurable."
    },
    "commons_license": "CERN-OHL-W-2.0"
  },
