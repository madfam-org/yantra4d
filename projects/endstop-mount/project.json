  ],
  "parameter_groups": [
    { "id": "switch", "label": { "en": "Switch", "es": "Interruptor" } },
    { "id": "plate", "label": { "en": "Plate", "es": "Placa" } },
    { "id": "mount", "label": { "en": "Mount", "es": "Montaje" } }
  ],
  "parameters": [
    {
      "id": "hole_span", "type": "slider", "default": 9.5, "min": 4.0, "max": 16.0, "step": 0.1,
      "group": "switch", "modes": ["switch_bracket", "extrusion_endstop"],
      "label": { "en": "Switch Hole Spacing (mm)", "es": "Separacion de Agujeros (mm)" },
      "tooltip": { "en": "Microswitch bolt centres (Omron SS/D2F ≈ 9.5 mm)", "es": "Centros de tornillos del microinterruptor (Omron SS/D2F ≈ 9.5 mm)" }
    },
    {
      "id": "switch_hole", "type": "slider", "default": 2.2, "min": 1.6, "max": 4.0, "step": 0.1,
      "group": "switch", "modes": ["switch_bracket", "extrusion_endstop"],
      "label": { "en": "Switch Bolt (mm)", "es": "Tornillo de Interruptor (mm)" },
      "tooltip": { "en": "Microswitch bolt clearance (2.2 = M2)", "es": "Holgura del tornillo del microinterruptor (2.2 = M2)" }
    },
    {
      "id": "plate_t", "type": "slider", "default": 3.0, "min": 2.0, "max": 6.0, "step": 0.5,
      "group": "plate", "modes": ["switch_bracket", "optical_endstop", "extrusion_endstop"],
      "label": { "en": "Plate Thickness (mm)", "es": "Grosor de Placa (mm)" },
      "tooltip": { "en": "Bracket plate thickness", "es": "Grosor de la placa del soporte" }
    },
    {
      "id": "plate_w", "type": "slider", "default": 14.0, "min": 10.0, "max": 24.0, "step": 0.5,
