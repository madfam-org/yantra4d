  "constraints": [
    {
      "expression": "flank_ang >= 30",
      "severity": "warning",
      "message": {
        "en": "Shallow flank angles weaken the dovetail undercut grip",
        "es": "Ángulos de flanco poco profundos debilitan el agarre de la cola de milano"
      }
    },
    {
      "expression": "clamp_bolt_d < rail_w",
      "severity": "error",
      "message": {
        "en": "Clamp bolt hole must be narrower than the rail width",
        "es": "El orificio del perno debe ser más estrecho que el ancho del riel"
