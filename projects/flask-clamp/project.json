  "parameters": [
    {
      "id": "vessel_diameter",
      "type": "slider",
      "default": 84,
      "min": 40,
      "max": 120,
      "step": 1,
      "label": {
        "en": "Vessel Body Diameter (mm)",
        "es": "Diámetro del Cuerpo (mm)"
      },
      "tooltip": {
        "en": "Erlenmeyer body: 125 mL ~70, 250 mL ~84, 500 mL ~108 mm. Beaker 250 mL ~70 mm.",
        "es": "Cuerpo Erlenmeyer: 125 mL ~70, 250 mL ~84, 500 mL ~108 mm. Vaso 250 mL ~70 mm."
      },
      "group": "clamp"
    },
    {
      "id": "rod_diameter",
      "type": "slider",
      "default": 12,
      "min": 8,
      "max": 16,
      "step": 0.1,
      "label": {
        "en": "Support Rod Diameter (mm)",
        "es": "Diámetro de la Varilla (mm)"
      },
      "tooltip": {
        "en": "Standard lab ring-stand rod is 12 mm; 1/2 in = 12.7 mm.",
        "es": "La varilla estándar de soporte es 12 mm; 1/2 in = 12.7 mm."
      },
      "group": "clamp"
    },
    {
      "id": "neck_diameter",
      "type": "slider",
      "default": 34,
      "min": 20,
      "max": 45,
      "step": 0.5,
      "label": {
        "en": "Flask Neck OD (mm)",
        "es": "Diámetro Exterior del Cuello (mm)"
      },
      "tooltip": {
        "en": "250/500 mL Erlenmeyer neck OD is 34 mm; 125 mL is ~30 mm.",
        "es": "El cuello de Erlenmeyer 250/500 mL es 34 mm; 125 mL es ~30 mm."
      },
      "group": "drying"
    },
    {
      "id": "neck_holes",
      "type": "slider",
      "default": 3,
      "min": 1,
      "max": 6,
      "step": 1,
      "label": {
        "en": "Drying Positions",
        "es": "Posiciones de Secado"
      },
      "group": "drying"
    }
  ],
  "parameter_groups": [
    {
      "id": "clamp",
      "label": {
        "en": "Ring Clamp & Rod",
