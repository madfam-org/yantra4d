{
  "project": {
    "name": "Accessory Shoe Mount",
    "slug": "shoe-mount",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "The ISO 518 camera accessory shoe — the ~18.7 mm rail with rounded-corner flanges that every on-camera light, microphone, monitor and flash slides onto. Build a male shoe foot with a 1/4-20 base, a female shoe socket that an accessory slides into, or a dual-shoe bar carrying two accessories.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "La zapata de accesorios ISO 518 — el riel de ~18.7 mm con pestañas de esquinas redondeadas al que se acoplan luces, micrófonos, monitores y flashes de cámara. Genera un pie de zapata macho con base 1/4-20, un receptáculo hembra en el que desliza un accesorio, o una barra de doble zapata para dos accesorios.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/shoe-mount.webp",
    "difficulty": "intermediate",
    "tags": [
      "shoe",
      "cold-shoe",
      "hot-shoe",
      "accessory",
      "camera",
      "mount",
      "iso-518",
      "flash",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
