  "constraints": [
    {
      "expression": "channel_w <= foot_width - 2",
      "severity": "error",
      "message": {
        "en": "Channel width must leave at least 1 mm flange on each side",
        "es": "El ancho de canal debe dejar al menos 1 mm de pestaña por lado"
      }
    },
    {
      "expression": "foot_width >= 12",
      "severity": "warning",
      "message": {
        "en": "Shoe narrower than 12 mm departs far from the ISO 518 standard",
        "es": "Una zapata más estrecha de 12 mm se aleja mucho del estándar ISO 518"
      }
    }
  ],
