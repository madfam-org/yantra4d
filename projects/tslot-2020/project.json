{
  "project": {
    "name": "T-Slot 2020 Accessory Kit",
    "slug": "tslot-2020",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "The 'industrial LEGO' accessory ecosystem. On-demand T-nuts, corner brackets, and cable/panel clips that lock into standard aluminium T-slot extrusion (2020 / 3030 / 4040 series). The extrusion profile is the shared denominator every accessory fits.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "El ecosistema de accesorios 'LEGO industrial'. Tuercas en T, escuadras y clips para cable/panel bajo demanda que se fijan en perfil de aluminio T-slot estándar (series 2020 / 3030 / 4040). El perfil de la extrusión es el denominador compartido que todo accesorio encaja.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/tslot-2020.webp",
    "difficulty": "intermediate",
