    "domain": "commercial",
    "cdg_interfaces": [
      {
        "id": "filter_thread",
        "label": { "en": "Filter Thread", "es": "Rosca de Filtro" },
        "geometry_type": "thread",
        "standard": "M49-M82 x 0.75",
        "parameters": ["filter_thread", "thread_a", "thread_b", "clearance"]
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "The photographic filter thread is a decades-old open standard shared by every lens front and screw-in filter. Lost lens caps and missing step rings are a constant, wasteful expense; on-demand caps and step rings let a photographer replace a lost cap or bridge two filter sizes for pennies of filament, keeping filters and lenses in use instead of buying single-purpose accessories.",
      "es": "La rosca de filtro fotográfico es un estándar abierto de décadas compartido por cada frente de lente y filtro roscado. Las tapas perdidas y los anillos escalonados faltantes son un gasto constante y derrochador; tapas y anillos bajo demanda permiten a un fotógrafo reemplazar una tapa perdida o unir dos tamaños de filtro por centavos de filamento, manteniendo filtros y lentes en uso en vez de comprar accesorios de un solo propósito."
    },
