      "tooltip": { "en": "Thickness of the flange or wall segment under the boss", "es": "Grosor de la brida o segmento de pared bajo el poste" }
    },
    {
      "id": "base_margin", "type": "slider", "default": 5.0, "min": 2.0, "max": 20.0, "step": 0.5,
      "group": "mount", "modes": ["boss", "boss_ribbed", "boss_strip"], "advanced": true,
      "label": { "en": "Base Margin (mm)", "es": "Margen de Base (mm)" },
      "tooltip": { "en": "Base material beyond the boss outer diameter", "es": "Material de base más allá del diámetro exterior del poste" }
    },
    {
      "id": "ribs", "type": "checkbox", "default": false,
      "group": "ribs", "modes": ["boss", "boss_strip"],
      "label": { "en": "Gusset Ribs", "es": "Nervios de Refuerzo" },
      "tooltip": { "en": "Add triangular ribs from the boss to the base for stiffness", "es": "Añade nervios triangulares del poste a la base para rigidez" }
    },
    {
      "id": "rib_count", "type": "slider", "default": 4, "min": 2, "max": 8, "step": 1,
      "group": "ribs", "modes": ["boss", "boss_ribbed", "boss_strip"], "advanced": true,
      "label": { "en": "Rib Count", "es": "Número de Nervios" },
      "tooltip": { "en": "Number of evenly spaced gusset ribs", "es": "Número de nervios de refuerzo equiespaciados" }
    },
    {
      "id": "strip_count", "type": "slider", "default": 3, "min": 2, "max": 10, "step": 1,
      "group": "strip", "modes": ["boss_strip"],
      "label": { "en": "Bosses in Strip", "es": "Postes en la Tira" },
      "tooltip": { "en": "Number of bosses in the row", "es": "Número de postes en la fila" }
    },
    {
      "id": "strip_pitch", "type": "slider", "default": 25.0, "min": 8.0, "max": 60.0, "step": 1.0,
      "group": "strip", "modes": ["boss_strip"],
      "label": { "en": "Strip Pitch (mm)", "es": "Paso de la Tira (mm)" },
      "tooltip": { "en": "Centre-to-centre spacing of the bosses", "es": "Espaciado centro a centro de los postes" }
    }
  ],
