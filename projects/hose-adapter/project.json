      "type": "slider",
      "default": 2.6,
      "min": 1.6,
      "max": 5.0,
      "step": 0.2,
      "group": "fit",
      "modes": [
        "ght_to_barb",
        "faucet_to_ght",
        "coupler"
      ],
      "label": {
        "en": "Wall Thickness (mm)",
        "es": "Grosor de Pared (mm)"
      },
      "tooltip": {
        "en": "Side wall around the threads and bore",
        "es": "Pared lateral alrededor de las roscas y el barreno"
