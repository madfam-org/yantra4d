{
  "version": "1.1.0",
  "units": "mm",
  "meta": {
    "title": "Toolhead Proxy (graph twin)",
    "notes": "Golden twin of main.py (graph format 1.1): the same parameters, the same derivations and the same operations in the same order. main.py stays the oracle; y4d-spec --parity compares the two at the defaults and at every preset. Clamps are min/max pairs spelled as ternaries, in the script's order (band_top reads the UNclamped body_top, as the script does). The script's makeCylinder and makeCone along -Y are a z cylinder laid down by rotate x +90 and spun by rotate y +90, and a trapezoid on YZ (on the -Z side of the axis) revolved about y: both put the B-rep seam where makeCylinder/makeCone put it (x direction -Z), which keeps the meshes vertex-identical. Conventions as main.py: HOLE_DEPTH 8, NOZZLE_D 8, TIP_D 3, TIP_TAPER 3; the mount pattern (20 mm square, clearance 3.4) is key toolhead-mount-20x20-m3."
  },
  "parameters": {
    "body_w": {"default": 56.0},
    "band_w": {"default": 36.0},
    "band_top": {"default": 1.0},
    "body_d": {"default": 56.0},
    "body_top": {"default": 25.0},
    "body_drop": {"default": 94.0},
    "nozzle_drop": {"default": 102.0},
    "nozzle_reach": {"default": 12.0}
  },
  "derived": [
    {"id": "bw_cap", "expr": "body_w < 90 ? body_w : 90"},
    {"id": "bw", "expr": "30 > bw_cap ? 30 : bw_cap"},
    {"id": "nw_cap", "expr": "band_w < bw ? band_w : bw"},
    {"id": "nw", "expr": "26 > nw_cap ? 26 : nw_cap"},
    {"id": "bt_cap", "expr": "band_top < body_top - 4 ? band_top : body_top - 4"},
    {"id": "bt", "expr": "-12 > bt_cap ? -12 : bt_cap"},
    {"id": "bd_cap", "expr": "body_d < 90 ? body_d : 90"},
    {"id": "bd", "expr": "30 > bd_cap ? 30 : bd_cap"},
    {"id": "top_cap", "expr": "body_top < 80 ? body_top : 80"},
    {"id": "top", "expr": "12 > top_cap ? 12 : top_cap"},
    {"id": "drop_cap", "expr": "body_drop < 160 ? body_drop : 160"},
    {"id": "drop", "expr": "12 > drop_cap ? 12 : drop_cap"},
    {"id": "nd_cap", "expr": "nozzle_drop < 180 ? nozzle_drop : 180"},
    {"id": "nd", "expr": "drop + 3 + 1 > nd_cap ? drop + 3 + 1 : nd_cap"},
    {"id": "nr_cap", "expr": "nozzle_reach < bd - 8 / 2 - 2 ? nozzle_reach : bd - 8 / 2 - 2"},
    {"id": "nr", "expr": "8 / 2 + 2 > nr_cap ? 8 / 2 + 2 : nr_cap"},
    {"id": "straight", "expr": "nd - 3 - drop"}
  ],
  "nodes": [
    {"id": "column_blank", "type": "box", "params": {"w": {"expr": "nw / 2 - (-nw / 2)"}, "d": {"expr": "bt + 0.5 - (-drop)"}, "h": {"expr": "bd - (0.0)"}}},
    {"id": "column", "type": "translate", "inputs": {"shape": "column_blank"}, "params": {"x": {"expr": "((-nw / 2) + (nw / 2)) / 2"}, "y": {"expr": "((-drop) + (bt + 0.5)) / 2"}, "z": {"expr": "((0.0) + (bd)) / 2"}}},
    {"id": "cap_blank", "type": "box", "params": {"w": {"expr": "bw / 2 - (-bw / 2)"}, "d": {"expr": "top - (bt)"}, "h": {"expr": "bd - (0.0)"}}},
    {"id": "cap", "type": "translate", "inputs": {"shape": "cap_blank"}, "params": {"x": {"expr": "((-bw / 2) + (bw / 2)) / 2"}, "y": {"expr": "((bt) + (top)) / 2"}, "z": {"expr": "((0.0) + (bd)) / 2"}}},
    {"id": "body_1", "type": "union", "inputs": {"a": "column", "b": "cap"}},
    {"id": "nozzle_blank", "type": "cylinder", "params": {"r": 4.0, "h": {"expr": "straight + 0.5"}}},
    {"id": "nozzle_lay", "type": "rotate", "inputs": {"shape": "nozzle_blank"}, "params": {"axis": "x", "angle": 90.0}},
    {"id": "nozzle_spin", "type": "rotate", "inputs": {"shape": "nozzle_lay"}, "params": {"axis": "y", "angle": 90.0}},
    {"id": "nozzle", "type": "translate", "inputs": {"shape": "nozzle_spin"}, "params": {"y": {"expr": "(-drop + 0.5) - (straight + 0.5) / 2"}, "z": {"expr": "nr"}}},
    {"id": "body_2", "type": "union", "inputs": {"a": "body_1", "b": "nozzle"}},
    {"id": "tip_section", "type": "profile_polyline", "params": {"plane": "YZ", "points": [[{"expr": "-(nd - 3)"}, 0.0], [{"expr": "-(nd - 3)"}, -4.0], [{"expr": "-nd"}, -1.5], [{"expr": "-nd"}, 0.0]]}},
    {"id": "tip_blank", "type": "revolve", "inputs": {"profile": "tip_section"}, "params": {"angle": 360.0, "axis": "y"}},
    {"id": "tip", "type": "translate", "inputs": {"shape": "tip_blank"}, "params": {"z": {"expr": "nr"}}},
    {"id": "body_3", "type": "union", "inputs": {"a": "body_2", "b": "tip"}},
    {"id": "mount_hole_1_blank", "type": "cylinder", "params": {"r": 1.7, "h": 9.0}},
    {"id": "mount_hole_1", "type": "translate", "inputs": {"shape": "mount_hole_1_blank"}, "params": {"x": -10.0, "y": -10.0, "z": 3.5}},
    {"id": "body_4", "type": "cut", "inputs": {"a": "body_3", "b": "mount_hole_1"}},
    {"id": "mount_hole_2_blank", "type": "cylinder", "params": {"r": 1.7, "h": 9.0}},
    {"id": "mount_hole_2", "type": "translate", "inputs": {"shape": "mount_hole_2_blank"}, "params": {"x": -10.0, "y": 10.0, "z": 3.5}},
    {"id": "body_5", "type": "cut", "inputs": {"a": "body_4", "b": "mount_hole_2"}},
    {"id": "mount_hole_3_blank", "type": "cylinder", "params": {"r": 1.7, "h": 9.0}},
    {"id": "mount_hole_3", "type": "translate", "inputs": {"shape": "mount_hole_3_blank"}, "params": {"x": 10.0, "y": -10.0, "z": 3.5}},
    {"id": "body_6", "type": "cut", "inputs": {"a": "body_5", "b": "mount_hole_3"}},
    {"id": "mount_hole_4_blank", "type": "cylinder", "params": {"r": 1.7, "h": 9.0}},
    {"id": "mount_hole_4", "type": "translate", "inputs": {"shape": "mount_hole_4_blank"}, "params": {"x": 10.0, "y": 10.0, "z": 3.5}},
    {"id": "body_7", "type": "cut", "inputs": {"a": "body_6", "b": "mount_hole_4"}}
  ],
  "outputs": {"toolhead_proxy": "body_7"}
}
