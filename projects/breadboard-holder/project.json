  "constraints": [
    {
      "expression": "lip_h <= board_th",
      "severity": "warning",
      "message": {
        "en": "Lip taller than the board will bury it",
        "es": "Un labio más alto que la placa la cubrirá"
      }
    },
    {
      "expression": "wall >= 1.6",
      "severity": "error",
      "message": {
        "en": "Wall must be at least 1.6 mm",
        "es": "La pared debe ser de al menos 1.6 mm"
      }
    }
  ],
