        { "value": "82", "label": { "en": "82 mm", "es": "82 mm" } }
      ]
    },
    {
      "id": "thread_b", "type": "select", "default": "52",
      "group": "ring", "modes": ["step_ring"],
      "label": { "en": "Thread B — Male (mm)", "es": "Rosca B — Macho (mm)" },
      "tooltip": { "en": "Top male thread — the size a filter screws ONTO", "es": "Rosca macho superior — el tamaño al que se enrosca un filtro" },
      "options": [
        { "value": "49", "label": { "en": "49 mm", "es": "49 mm" } },
        { "value": "52", "label": { "en": "52 mm", "es": "52 mm" } },
        { "value": "58", "label": { "en": "58 mm", "es": "58 mm" } },
        { "value": "67", "label": { "en": "67 mm", "es": "67 mm" } },
        { "value": "72", "label": { "en": "72 mm", "es": "72 mm" } },
        { "value": "77", "label": { "en": "77 mm", "es": "77 mm" } },
        { "value": "82", "label": { "en": "82 mm", "es": "82 mm" } }
      ]
    },
    {
      "id": "thread_turns", "type": "slider", "default": 4.0, "min": 2.0, "max": 8.0, "step": 0.5,
      "group": "ring", "modes": ["step_ring"], "advanced": true,
      "label": { "en": "Thread Engagement (turns)", "es": "Enganche de Rosca (vueltas)" },
      "tooltip": { "en": "How many turns of thread on each side of the ring", "es": "Cuántas vueltas de rosca en cada lado del anillo" }
    },
    {
      "id": "clearance", "type": "slider", "default": 0.3, "min": 0.1, "max": 0.8, "step": 0.05,
      "group": "thread", "modes": ["snap_cap", "step_ring"], "advanced": true,
      "label": { "en": "Fit Clearance (mm)", "es": "Holgura de Ajuste (mm)" },
      "tooltip": { "en": "Per-side thread/press fit slop for printed parts", "es": "Holgura por lado de rosca/presión para piezas impresas" }
    },
    {
      "id": "wall", "type": "slider", "default": 2.4, "min": 1.6, "max": 5.0, "step": 0.1,
      "group": "cap", "modes": ["snap_cap", "step_ring", "body_cap"],
      "label": { "en": "Wall Thickness (mm)", "es": "Grosor de Pared (mm)" },
      "tooltip": { "en": "Side wall thickness", "es": "Grosor de la pared lateral" }
    },
    {
      "id": "cap_depth", "type": "slider", "default": 7.0, "min": 3.0, "max": 20.0, "step": 0.5,
      "group": "cap", "modes": ["snap_cap"],
      "label": { "en": "Cap Skirt Depth (mm)", "es": "Profundidad de Faldón (mm)" },
      "tooltip": { "en": "How deep the snap cap's skirt reaches over the lens", "es": "Qué tan profundo llega el faldón de la tapa sobre la lente" },
      "preview_hint": { "type": "axis_scale", "axis": "z", "scale_factor": 1.0 }
    },
    {
      "id": "top_th", "type": "slider", "default": 2.2, "min": 1.2, "max": 6.0, "step": 0.1,
      "group": "cap", "modes": ["snap_cap", "step_ring", "body_cap"], "advanced": true,
      "label": { "en": "Top/Web Thickness (mm)", "es": "Grosor de Tapa/Alma (mm)" },
      "tooltip": { "en": "Thickness of the cap top or the step-ring web", "es": "Grosor de la parte superior de la tapa o el alma del anillo" }
    },
    {
      "id": "grip_teeth", "type": "slider", "default": 0, "min": 0, "max": 80, "step": 1,
      "group": "cap", "modes": ["snap_cap", "body_cap"], "advanced": true,
      "label": { "en": "Grip Flutes", "es": "Estrías de Agarre" },
      "tooltip": { "en": "Number of vertical grip flutes around the rim (0 = smooth)", "es": "Número de estrías verticales de agarre en el borde (0 = liso)" }
    },
    {
      "id": "body_cap_d", "type": "slider", "default": 42.0, "min": 20.0, "max": 80.0, "step": 0.5,
      "group": "body", "modes": ["body_cap"],
      "label": { "en": "Body Cap Diameter (mm)", "es": "Diámetro de Tapa de Cuerpo (mm)" },
      "tooltip": { "en": "Bayonet outer diameter of the rear body cap blank", "es": "Diámetro exterior de bayoneta de la tapa trasera" },
      "preview_hint": { "type": "axis_scale", "axis": "radial", "scale_factor": 1.0 }
    }
  ],
  "presets": [
