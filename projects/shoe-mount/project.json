      "step": 0.1,
      "group": "shoe",
      "modes": [
        "cold_shoe_male",
        "shoe_socket",
        "dual_shoe_bar"
      ],
      "label": {
        "en": "Channel Width (mm)",
        "es": "Ancho de Canal (mm)"
