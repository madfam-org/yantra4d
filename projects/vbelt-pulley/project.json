      "label": { "en": "Shaft Bore (mm)", "es": "Barreno de Eje (mm)" },
      "tooltip": { "en": "Shaft hole diameter (auto-clamped inside the rim)", "es": "Diámetro del agujero del eje (limitado dentro del aro)" }
    },
    {
      "id": "hub", "type": "checkbox", "default": true,
      "group": "hub", "modes": ["vbelt", "roundbelt", "multi_groove"],
