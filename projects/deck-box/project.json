  "constraints": [
    {
      "expression": "wall >= 1.2",
      "severity": "error",
      "message": {
        "en": "Wall must be at least 1.2 mm",
        "es": "La pared debe ser de al menos 1.2 mm"
      }
    },
    {
      "expression": "corner_r <= 70 / 2 + wall",
      "severity": "warning",
      "message": {
        "en": "Corner radius is large relative to the card",
        "es": "El radio de esquina es grande respecto a la carta"
      }
    }
  ],
