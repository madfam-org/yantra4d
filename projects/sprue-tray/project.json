  "presets": [
    {
      "id": "build_tray", "mode": "parts_tray",
      "label": { "en": "Build Tray (3x2)", "es": "Bandeja de Montaje (3x2)" },
      "values": { "tray_w": 120, "tray_d": 80, "cols": 3, "rows": 2 }
    },
    {
      "id": "bench_magnet", "mode": "magnetic_tray",
      "label": { "en": "Bench Magnetic Tray", "es": "Bandeja Magnética de Mesa" },
      "values": { "tray_w": 140, "tray_d": 90, "cols": 4, "rows": 3, "floor": 3, "mag_n": 4 }
    },
    {
      "id": "screw_lid", "mode": "sorting_lid",
      "label": { "en": "Screw Sorting Lid", "es": "Tapa Clasificadora de Tornillos" },
      "values": { "tray_w": 120, "tray_d": 80, "fine_cols": 5, "fine_rows": 4 }
    }
  ],
  "constraints": [
    {
      "expression": "magnet_h <= floor - 0.4",
      "severity": "warning",
      "message": { "en": "Magnet pocket is deep relative to the floor", "es": "La cavidad del imán es profunda respecto al piso" }
    },
    {
      "expression": "wall >= 1.2",
      "severity": "error",
      "message": { "en": "Wall must be at least 1.2 mm", "es": "La pared debe ser de al menos 1.2 mm" }
    }
  ],
  "camera_views": [
    { "id": "iso", "label": { "en": "Isometric", "es": "Isométrico" }, "position": [150, 150, 120] },
    { "id": "top", "label": { "en": "Top", "es": "Superior" }, "position": [0, 0, 220] },
    { "id": "front", "label": { "en": "Front", "es": "Frontal" }, "position": [0, -220, 40] }
  ],
  "export_formats": ["stl", "3mf", "step", "glb", "gltf", "obj"],
  "estimate_constants": {
    "base_time": 14, "per_unit": 3, "per_part": 16,
    "fn_factor": 48, "wasm_multiplier": 4, "warning_threshold_seconds": 100
