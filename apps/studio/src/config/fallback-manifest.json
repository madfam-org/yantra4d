  "parameters": [
    {
      "id": "target_part",
      "type": "select",
      "default": "bin",
      "group": "grid",
      "modes": [
        "bin",
        "baseplate"
      ],
      "label": {
        "en": "Part",
        "es": "Pieza"
      },
      "tooltip": {
        "en": "Which Gridfinity part to generate",
        "es": "Qué pieza Gridfinity generar"
      },
      "options": [
        {
          "value": "bin",
          "label": {
            "en": "Bin",
            "es": "Contenedor"
          }
        },
        {
          "value": "baseplate",
          "label": {
            "en": "Baseplate",
            "es": "Placa Base"
          }
        }
      ]
    },
    {
      "id": "grid_x",
      "type": "slider",
      "default": 2,
      "min": 1,
      "max": 6,
      "step": 1,
      "group": "grid",
      "modes": [
        "bin",
        "baseplate"
      ],
      "label": {
        "en": "Width (units)",
        "es": "Ancho (unidades)"
      },
      "tooltip": {
        "en": "Grid units in X — each unit is 42 mm",
        "es": "Unidades de rejilla en X — cada unidad son 42 mm"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "x",
        "scale_factor": 42,
        "affected_parts": [
          "bin",
          "baseplate"
        ]
      }
    },
    {
      "id": "grid_y",
      "type": "slider",
      "default": 1,
      "min": 1,
      "max": 6,
      "step": 1,
      "group": "grid",
      "modes": [
        "bin",
        "baseplate"
      ],
      "label": {
        "en": "Depth (units)",
        "es": "Profundidad (unidades)"
      },
      "tooltip": {
        "en": "Grid units in Y — each unit is 42 mm",
        "es": "Unidades de rejilla en Y — cada unidad son 42 mm"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "y",
        "scale_factor": 42,
        "affected_parts": [
          "bin",
          "baseplate"
        ]
      }
    },
    {
      "id": "grid_z",
      "type": "slider",
      "default": 3,
      "min": 1,
      "max": 12,
      "step": 1,
      "group": "grid",
      "modes": [
        "bin"
      ],
      "label": {
        "en": "Height (units)",
        "es": "Altura (unidades)"
      },
      "tooltip": {
        "en": "Height in 7 mm units",
        "es": "Altura en unidades de 7 mm"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "z",
        "scale_factor": 7,
        "affected_parts": [
          "bin"
        ]
      }
    },
    {
      "id": "wall",
      "type": "slider",
      "default": 1.2,
      "min": 0.8,
      "max": 3.0,
      "step": 0.1,
      "group": "structure",
      "modes": [
        "bin"
      ],
      "label": {
        "en": "Wall Thickness (mm)",
        "es": "Grosor de Pared (mm)"
      },
      "tooltip": {
        "en": "Bin side-wall thickness",
        "es": "Grosor de la pared lateral del contenedor"
      }
    },
    {
      "id": "floor_th",
      "type": "slider",
      "default": 1.2,
      "min": 0.6,
      "max": 4.0,
      "step": 0.1,
      "group": "structure",
      "modes": [
        "bin"
      ],
      "advanced": true,
      "label": {
        "en": "Floor Thickness (mm)",
        "es": "Grosor del Piso (mm)"
      },
      "tooltip": {
        "en": "Solid floor above the base profile",
        "es": "Piso sólido sobre el perfil base"
      }
    },
    {
      "id": "lip_enabled",
      "type": "checkbox",
      "default": true,
      "group": "structure",
      "modes": [
        "bin"
      ],
      "label": {
        "en": "Stacking Lip",
        "es": "Labio de Apilamiento"
      },
      "tooltip": {
        "en": "Top lip so bins stack on one another",
        "es": "Labio superior para apilar contenedores"
      }
    },
    {
      "id": "enable_magnets",
      "type": "checkbox",
      "default": false,
      "group": "features",
      "modes": [
        "bin"
      ],
      "label": {
        "en": "Magnet Holes (6×2 mm)",
        "es": "Orificios para Imanes (6×2 mm)"
      },
      "tooltip": {
        "en": "6 mm dia × 2 mm deep pockets at each cell corner",
        "es": "Cavidades de 6 mm diám × 2 mm en cada esquina de celda"
      },
      "preview_hint": {
        "type": "toggle_geometry",
        "affected_parts": [
          "bin"
        ]
      }
    },
    {
      "id": "finger_scoop",
      "type": "checkbox",
      "default": false,
      "group": "features",
      "modes": [
        "bin"
      ],
      "label": {
        "en": "Finger Scoop",
        "es": "Rampa para Dedos"
      },
      "tooltip": {
        "en": "Front ramp for easy access to contents",
        "es": "Rampa frontal para acceso fácil al contenido"
      }
    },
    {
      "id": "bp_thickness",
      "type": "slider",
      "default": 5.25,
      "min": 4.75,
      "max": 10.0,
      "step": 0.25,
      "group": "baseplate",
      "modes": [
        "baseplate"
      ],
      "advanced": true,
      "label": {
        "en": "Baseplate Thickness (mm)",
        "es": "Grosor de Placa Base (mm)"
      },
      "tooltip": {
        "en": "Plate thickness; ≥ 4.75 mm socket profile depth",
        "es": "Grosor de la placa; ≥ 4.75 mm de profundidad del perfil"
      }
    }
  ],
  "presets": [
    {
      "id": "small_parts_bin",
      "mode": "bin",
      "label": {
        "en": "Small Parts Bin (2×1×3)",
        "es": "Contenedor Pequeño (2×1×3)"
      },
      "values": {
        "target_part": "bin",
        "grid_x": 2,
        "grid_y": 1,
        "grid_z": 3,
        "enable_magnets": true,
        "finger_scoop": true
      }
    },
    {
      "id": "deep_bin",
      "mode": "bin",
      "label": {
        "en": "Deep Bin (2×2×6)",
        "es": "Contenedor Profundo (2×2×6)"
      },
      "values": {
        "target_part": "bin",
        "grid_x": 2,
        "grid_y": 2,
        "grid_z": 6,
        "enable_magnets": true
      }
    },
    {
      "id": "standard_baseplate",
      "mode": "baseplate",
      "label": {
        "en": "Standard Baseplate (2×2)",
        "es": "Placa Base Estándar (2×2)"
      },
      "values": {
        "target_part": "baseplate",
        "grid_x": 2,
        "grid_y": 2
      }
    }
  ],
  "constraints": [
    {
      "expression": "grid_x * grid_y <= 24",
      "severity": "warning",
      "message": {
        "en": "Large grids (>24 cells) may be slow to render",
        "es": "Rejillas grandes (>24 celdas) pueden tardar en renderizar"
      }
    },
    {
      "expression": "wall >= 0.8",
      "severity": "error",
      "message": {
        "en": "Wall must be at least 0.8 mm",
        "es": "La pared debe ser de al menos 0.8 mm"
      }
    }
  ],
  "camera_views": [
    {
      "id": "iso",
      "label": {
        "en": "Isometric",
        "es": "Isométrico"
      },
      "position": [
