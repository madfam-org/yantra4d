        "lip_h": 14
      }
    }
  ],
  "constraints": [
    {
      "expression": "groove_gap >= card_t",
      "severity": "error",
      "message": {
        "en": "Groove must be at least as wide as the card/page it holds",
        "es": "La ranura debe ser al menos tan ancha como la carta/página que sostiene"
      }
    },
    {
      "expression": "base_depth >= 30",
      "severity": "warning",
      "message": {
        "en": "A shallow base may tip over when loaded",
        "es": "Una base poco profunda puede volcarse al cargarse"
      }
    }
  ],
