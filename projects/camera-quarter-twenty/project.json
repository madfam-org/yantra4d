{
  "project": {
    "name": "1/4-20 Camera / Tripod Interface",
    "slug": "camera-quarter-twenty",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "The universal camera/tripod 1/4\"-20 UNC interface — the base every mount, plate, and adapter bolts onto. Generate a 1/4-20 male stud (tripod screw), a 1/4-20 female socket (for plates and mounts), or the ubiquitous 1/4-to-3/8 adapter, on a configurable disc or plate base. Threads render fast and watertight by default.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "La interfaz universal cámara/trípode 1/4\"-20 UNC — la base sobre la que se atornilla toda montura, placa y adaptador. Genera un perno macho 1/4-20 (tornillo de trípode), un casquillo hembra 1/4-20 (para placas y monturas), o el ubicuo adaptador 1/4-a-3/8, sobre una base de disco o placa configurable. Las roscas se renderizan rápido y estancas por defecto.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/camera-quarter-twenty.webp",
    "difficulty": "beginner",
    "tags": [
      "camera",
      "tripod",
      "quarter-twenty",
      "1/4-20",
      "3/8-16",
      "mount",
      "adapter",
      "photography",
      "thread",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
