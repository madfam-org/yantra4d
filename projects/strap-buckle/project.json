  "constraints": [
    {
      "expression": "wall >= 1.6",
      "severity": "error",
      "message": {
        "en": "Wall must be at least 1.6 mm",
        "es": "La pared debe ser de al menos 1.6 mm"
      }
    },
    {
      "expression": "snap_ledge > snap_clear",
      "severity": "warning",
      "message": {
        "en": "Barb ledge should exceed the snap clearance to latch",
        "es": "El reborde debe superar la holgura para enganchar"
      }
    }
  ],
