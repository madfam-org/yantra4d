  "constraints": [
    {
      "expression": "hub_d >= spigot_d + 3",
      "severity": "error",
      "message": {
        "en": "Hub must be wider than the spigot stud",
        "es": "El cubo debe ser más ancho que el vástago del spigot"
      }
    },
    {
      "expression": "groove_pos <= spigot_len - 3",
      "severity": "warning",
      "message": {
        "en": "Locking groove sits too close to the stud tip",
        "es": "La ranura de bloqueo queda demasiado cerca de la punta del vástago"
      }
    }
