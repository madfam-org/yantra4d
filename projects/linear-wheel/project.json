  "constraints": [
    {
      "expression": "bearing_bore <= outer_dia - 4",
      "severity": "error",
      "message": {
        "en": "Bearing bore must leave a rim around it",
        "es": "El barreno del rodamiento debe dejar un aro alrededor"
      }
    },
    {
      "expression": "width >= 4",
      "severity": "warning",
      "message": {
        "en": "A very narrow wheel may not track the rail well",
        "es": "Una rueda muy angosta puede no seguir bien el riel"
      }
    }
  ],
