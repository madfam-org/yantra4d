{
  "version": "1.1.0",
  "units": "mm",
  "meta": {
    "title": "Z Belt Clamp (graph twin)",
    "notes": "Golden twin of main.py (graph format 1.1): the same parameters, the same derivations and the same operations in the same order. main.py stays the oracle; y4d-spec --parity compares the two at the defaults and at every preset. Constants keep main.py's names and values, and their sources are main.py's: Gates PowerGrip GT 2MR (design manual 17195 p. 90: BELT_B 1.52, BELT_T 0.76), the 9 mm Z belt (Voron 2.4r2 guide p. 111, BELT_WIDTH), ISO 7380-1 M5x10 (SCREW_D 5, HEAD_DK 9.5), MISUMI HFS5 2020 (SLOT_LIP_T 2); WIDTH_CLEAR, PLY_CLEAR, HOLE_CLEAR, HEAD_CLEAR, GRIP, TAB_W, MID_HALF, WALL and SIDE_WALL are main.py's labelled conventions. Clamps max(lo, min(x, hi)) and the jaw slot's min/max ends are ternaries, because the expression dialect has no function calls. The jaw loop (sign +1, then -1) is unrolled in order."
  },
  "parameters": {
    "jaw_length": {"default": 14.0},
    "post_d": {"default": 6.0},
    "slot_w": {"default": 2.4},
    "base_t": {"default": 3.5}
  },
  "derived": [
    {"id": "BELT_B", "expr": "1.52"},
    {"id": "BELT_T", "expr": "0.76"},
    {"id": "BELT_WIDTH", "expr": "9.0"},
    {"id": "SCREW_D", "expr": "5.0"},
    {"id": "HEAD_DK", "expr": "9.5"},
    {"id": "SLOT_LIP_T", "expr": "2.0"},
    {"id": "WIDTH_CLEAR", "expr": "0.3"},
    {"id": "PLY_CLEAR", "expr": "0.3"},
    {"id": "HOLE_CLEAR", "expr": "0.25"},
    {"id": "HEAD_CLEAR", "expr": "0.5"},
    {"id": "GRIP", "expr": "4.5"},
    {"id": "TAB_W", "expr": "5.8"},
    {"id": "MID_HALF", "expr": "7.25"},
    {"id": "WALL", "expr": "2.0"},
    {"id": "SIDE_WALL", "expr": "3.0"},
    {"id": "jl_cap", "expr": "jaw_length < 24 ? jaw_length : 24"},
    {"id": "jl", "expr": "10 > jl_cap ? 10 : jl_cap"},
    {"id": "pd_cap", "expr": "post_d < 10 ? post_d : 10"},
    {"id": "pd", "expr": "4 > pd_cap ? 4 : pd_cap"},
    {"id": "sw_cap", "expr": "slot_w < 3.2 ? slot_w : 3.2"},
    {"id": "sw", "expr": "(2 * BELT_B - BELT_T) > sw_cap ? (2 * BELT_B - BELT_T) : sw_cap"},
    {"id": "bt_cap", "expr": "base_t < 8 ? base_t : 8"},
    {"id": "bt", "expr": "2.5 > bt_cap ? 2.5 : bt_cap"},
    {"id": "DEPTH", "expr": "bt + BELT_WIDTH + 2 * WIDTH_CLEAR"},
    {"id": "pocket_d", "expr": "pd + 2 * (BELT_B + PLY_CLEAR)"},
    {"id": "x_post", "expr": "MID_HALF + WALL + pocket_d / 2"},
    {"id": "HALF_L", "expr": "x_post + jl"},
    {"id": "HALF_W", "expr": "pocket_d / 2 + SIDE_WALL"},
    {"id": "xp_r", "expr": "x_post"},
    {"id": "xe_r", "expr": "HALF_L + 1"},
    {"id": "slot_x0_r", "expr": "xp_r < xe_r ? xp_r : xe_r"},
    {"id": "slot_x1_r", "expr": "xp_r > xe_r ? xp_r : xe_r"},
    {"id": "xp_l", "expr": "-x_post"},
    {"id": "xe_l", "expr": "-(HALF_L + 1)"},
    {"id": "slot_x0_l", "expr": "xp_l < xe_l ? xp_l : xe_l"},
    {"id": "slot_x1_l", "expr": "xp_l > xe_l ? xp_l : xe_l"}
  ],
  "nodes": [
    {"id": "block_blank", "type": "box", "params": {"w": {"expr": "HALF_L - -HALF_L"}, "d": {"expr": "HALF_W - -HALF_W"}, "h": {"expr": "DEPTH - 0"}}},
    {"id": "block", "type": "translate", "inputs": {"shape": "block_blank"}, "params": {"x": {"expr": "(-HALF_L + HALF_L) / 2"}, "y": {"expr": "(-HALF_W + HALF_W) / 2"}, "z": {"expr": "(0 + DEPTH) / 2"}}},
    {"id": "tongue_blank", "type": "box", "params": {"w": {"expr": "HALF_L - 2 - (-HALF_L + 2)"}, "d": {"expr": "TAB_W / 2 - (-TAB_W / 2)"}, "h": {"expr": "0.5 - -SLOT_LIP_T"}}},
    {"id": "tongue", "type": "translate", "inputs": {"shape": "tongue_blank"}, "params": {"x": {"expr": "(-HALF_L + 2 + (HALF_L - 2)) / 2"}, "y": {"expr": "(-TAB_W / 2 + (TAB_W / 2)) / 2"}, "z": {"expr": "(-SLOT_LIP_T + 0.5) / 2"}}},
    {"id": "body_1", "type": "union", "inputs": {"a": "block", "b": "tongue"}},
    {"id": "screw_hole_outline", "type": "profile_circle", "params": {"r": {"expr": "(SCREW_D + 2 * HOLE_CLEAR) / 2"}}},
    {"id": "screw_hole_blank", "type": "extrude", "inputs": {"profile": "screw_hole_outline"}, "params": {"height": {"expr": "DEPTH + 1 - (-SLOT_LIP_T - 1)"}}},
    {"id": "screw_hole", "type": "translate", "inputs": {"shape": "screw_hole_blank"}, "params": {"z": {"expr": "-SLOT_LIP_T - 1"}}},
    {"id": "body_2", "type": "cut", "inputs": {"a": "body_1", "b": "screw_hole"}},
    {"id": "counterbore_outline", "type": "profile_circle", "params": {"r": {"expr": "(HEAD_DK + 2 * HEAD_CLEAR) / 2"}}},
    {"id": "counterbore_blank", "type": "extrude", "inputs": {"profile": "counterbore_outline"}, "params": {"height": {"expr": "DEPTH + 1 - GRIP"}}},
    {"id": "counterbore", "type": "translate", "inputs": {"shape": "counterbore_blank"}, "params": {"z": {"expr": "GRIP"}}},
    {"id": "body_3", "type": "cut", "inputs": {"a": "body_2", "b": "counterbore"}},
    {"id": "slot_r_blank", "type": "box", "params": {"w": {"expr": "slot_x1_r - slot_x0_r"}, "d": {"expr": "sw / 2 - (-sw / 2)"}, "h": {"expr": "DEPTH + 1 - bt"}}},
    {"id": "slot_r", "type": "translate", "inputs": {"shape": "slot_r_blank"}, "params": {"x": {"expr": "(slot_x0_r + slot_x1_r) / 2"}, "y": {"expr": "(-sw / 2 + (sw / 2)) / 2"}, "z": {"expr": "(bt + (DEPTH + 1)) / 2"}}},
    {"id": "body_4", "type": "cut", "inputs": {"a": "body_3", "b": "slot_r"}},
    {"id": "pocket_r_outline", "type": "profile_circle", "params": {"r": {"expr": "pocket_d / 2"}, "x": {"expr": "xp_r"}}},
    {"id": "pocket_r_blank", "type": "extrude", "inputs": {"profile": "pocket_r_outline"}, "params": {"height": {"expr": "DEPTH + 1 - bt"}}},
    {"id": "pocket_r", "type": "translate", "inputs": {"shape": "pocket_r_blank"}, "params": {"z": {"expr": "bt"}}},
    {"id": "post_r_outline", "type": "profile_circle", "params": {"r": {"expr": "pd / 2"}, "x": {"expr": "xp_r"}}},
    {"id": "post_r_blank", "type": "extrude", "inputs": {"profile": "post_r_outline"}, "params": {"height": {"expr": "DEPTH + 2 - (bt - 1)"}}},
    {"id": "post_r", "type": "translate", "inputs": {"shape": "post_r_blank"}, "params": {"z": {"expr": "bt - 1"}}},
    {"id": "ring_r", "type": "cut", "inputs": {"a": "pocket_r", "b": "post_r"}},
    {"id": "body_5", "type": "cut", "inputs": {"a": "body_4", "b": "ring_r"}},
    {"id": "slot_l_blank", "type": "box", "params": {"w": {"expr": "slot_x1_l - slot_x0_l"}, "d": {"expr": "sw / 2 - (-sw / 2)"}, "h": {"expr": "DEPTH + 1 - bt"}}},
    {"id": "slot_l", "type": "translate", "inputs": {"shape": "slot_l_blank"}, "params": {"x": {"expr": "(slot_x0_l + slot_x1_l) / 2"}, "y": {"expr": "(-sw / 2 + (sw / 2)) / 2"}, "z": {"expr": "(bt + (DEPTH + 1)) / 2"}}},
    {"id": "body_6", "type": "cut", "inputs": {"a": "body_5", "b": "slot_l"}},
    {"id": "pocket_l_outline", "type": "profile_circle", "params": {"r": {"expr": "pocket_d / 2"}, "x": {"expr": "xp_l"}}},
    {"id": "pocket_l_blank", "type": "extrude", "inputs": {"profile": "pocket_l_outline"}, "params": {"height": {"expr": "DEPTH + 1 - bt"}}},
    {"id": "pocket_l", "type": "translate", "inputs": {"shape": "pocket_l_blank"}, "params": {"z": {"expr": "bt"}}},
    {"id": "post_l_outline", "type": "profile_circle", "params": {"r": {"expr": "pd / 2"}, "x": {"expr": "xp_l"}}},
    {"id": "post_l_blank", "type": "extrude", "inputs": {"profile": "post_l_outline"}, "params": {"height": {"expr": "DEPTH + 2 - (bt - 1)"}}},
    {"id": "post_l", "type": "translate", "inputs": {"shape": "post_l_blank"}, "params": {"z": {"expr": "bt - 1"}}},
    {"id": "ring_l", "type": "cut", "inputs": {"a": "pocket_l", "b": "post_l"}},
    {"id": "body_7", "type": "cut", "inputs": {"a": "body_6", "b": "ring_l"}}
  ],
  "outputs": {
    "z_belt_clamp": "body_7"
  }
}
