{
  "project": {
    "name": "Seed Tray / Cell Insert",
    "slug": "seed-tray",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A seed-starting tray: an array of tapered cells (wide at the top, narrower at the bottom so the plug pops out) each with a drainage hole. Drop it into a standard 1020 propagation tray, or use it free-standing. A single-row cell strip and a vented humidity dome complete the germination set.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Una charola para germinar semillas: un arreglo de celdas cónicas (anchas arriba, más angostas abajo para que el cepellón salga fácil) cada una con orificio de drenaje. Colócala en una charola de propagación 1020 estándar, o úsala sola. Una tira de una fila y una cúpula de humedad ventilada completan el set de germinación.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/seed-tray.webp",
    "difficulty": "beginner",
    "tags": [
      "seed",
      "tray",
      "propagation",
      "cells",
      "germination",
      "seedling",
      "garden",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
