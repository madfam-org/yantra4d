    {
      "id": "putting_liner", "mode": "alignment_tool",
      "label": { "en": "Putting Line-Up Tool", "es": "Herramienta de Línea de Putt" },
      "values": { "ball_dia": 42.7, "slot_w": 2.2 }
    }
  ],
  "constraints": [
    {
      "expression": "slot_w >= 1.2",
