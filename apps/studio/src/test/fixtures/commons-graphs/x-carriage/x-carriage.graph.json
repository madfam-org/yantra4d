    {"id": "bl", "expr": "15 > bl_cap ? 15 : bl_cap"},
    {"id": "ba_cap", "expr": "belt_a_level < 70 ? belt_a_level : 70"},
    {"id": "ba", "expr": "22 > ba_cap ? 22 : ba_cap"},
    {"id": "bb_cap", "expr": "belt_b_level < 70 ? belt_b_level : 70"},
    {"id": "bb", "expr": "22 > bb_cap ? 22 : bb_cap"},
    {"id": "cx_cap", "expr": "clamp_x < 30 ? clamp_x : 30"},
    {"id": "cx", "expr": "12 > cx_cap ? 12 : cx_cap"},
    {"id": "jl_cap", "expr": "jaw_length < 16 ? jaw_length : 16"},
    {"id": "jl", "expr": "6 > jl_cap ? 6 : jl_cap"},
    {"id": "pd_cap", "expr": "post_d < 8 ? post_d : 8"},
    {"id": "pd", "expr": "4 > pd_cap ? 4 : pd_cap"},
    {"id": "sw_cap", "expr": "slot_w < 3.2 ? slot_w : 3.2"},
    {"id": "sw", "expr": "(2 * 1.52 - 0.76) > sw_cap ? (2 * 1.52 - 0.76) : sw_cap"},
    {"id": "pt_cap", "expr": "plate_t < 14 ? plate_t : 14"},
    {"id": "pt", "expr": "6 > pt_cap ? 6 : pt_cap"},
    {"id": "half_h", "expr": "6 / 2 + 0.3"},
    {"id": "lo", "expr": "ba < bb ? ba : bb"},
    {"id": "hi", "expr": "ba > bb ? ba : bb"},
    {"id": "top", "expr": "hi + half_h + 1.2"},
    {"id": "th_top", "expr": "th + 20 / 2 + 4 / 2 + 2"},
    {"id": "plate_top", "expr": "top > th_top ? top : th_top"},
    {"id": "floor", "expr": "27 / 2 + 1"},
    {"id": "pocket_d", "expr": "pd + 2 * (1.52 + 0.3)"},
    {"id": "x_post", "expr": "cx - jl"},
    {"id": "back", "expr": "teeth_toward_toolhead ? -1 : 1"},
    {"id": "z_wall", "expr": "-bl + back * (1.52 - 0.76 - 0.254)"},
    {"id": "z_slot", "expr": "z_wall - back * sw / 2"},
    {"id": "z_wall_far", "expr": "z_wall - back * sw"},
    {"id": "z_pocket_rear", "expr": "z_slot - pocket_d / 2"},
    {"id": "z_rear", "expr": "(z_pocket_rear < z_wall_far ? z_pocket_rear : z_wall_far) - 2.5"},
    {"id": "z_pocket_front", "expr": "z_slot + pocket_d / 2"},
    {"id": "z_front", "expr": "z_pocket_front > z_wall ? z_pocket_front : z_wall"},
    {"id": "rib_half", "expr": "x_post - pocket_d / 2"},
    {"id": "zs0", "expr": "z_wall < z_wall_far ? z_wall : z_wall_far"},
    {"id": "zs1", "expr": "z_wall < z_wall_far ? z_wall_far : z_wall"},
    {"id": "xe_p", "expr": "(cx + 1)"},
