# Yantra4D — Environment Variables
#
# Copy this file to .env and fill in secrets. The .env file is gitignored.
#
# Usage:
#   Local dev (no Docker):  loaded automatically by python-dotenv
#   Docker dev stack:       loaded by docker compose env_file directive
#   Production:             set as container environment variables

# ---------------------------------------------------------------------------
# Janua Auth (leave blank or set AUTH_ENABLED=false for local dev)
# ---------------------------------------------------------------------------
JANUA_ISSUER=https://auth.madfam.io
JANUA_AUDIENCE=yantra4d-api
AUTH_ENABLED=false        # set to "true" in production

# Frontend auth (Vite env vars — baked into the JS bundle at build time)
# To get VITE_JANUA_CLIENT_ID:
#   1. Clone and start the Janua auth server (https://github.com/madfam/janua)
#   2. Run: cd janua/apps/api && python seed_core_clients.py
#   3. Copy the jnc_* client_id printed for "yantra4d-studio"
# See docs/guides/developer-onboarding.md "Auth Setup" for full instructions.
VITE_JANUA_BASE_URL=https://auth.madfam.io
VITE_JANUA_CLIENT_ID=  # jnc_* value from seed output (yantra4d-studio)
VITE_JANUA_REDIRECT_URI=http://localhost:5173

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=false         # override to "true" in dev (docker-compose.dev.yml does this)

# CORS — comma-separated list of allowed origins
# docker-compose.dev.yml sets this automatically; only override for custom setups
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# Studio Vite dev proxy (docker-compose.dev.yml only)
# ---------------------------------------------------------------------------
# Override if your API runs on a different port or host:
# VITE_API_PROXY_TARGET=http://localhost:5000

# ---------------------------------------------------------------------------
# Database (PostgreSQL in production, SQLite fallback if unset)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://yantra4d:secret@localhost:5432/yantra4d

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=false  # set to "true" with Redis in production
# RATE_LIMIT_STORAGE=redis://redis:6379

# ---------------------------------------------------------------------------
# AI features (optional — leave blank to disable)
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic          # or "openai"
# AI_API_KEY=                    # your API key (Anthropic or OpenAI, depending on AI_PROVIDER)

# ---------------------------------------------------------------------------
# Observability (all optional — zero impact when unset)
# ---------------------------------------------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---------------------------------------------------------------------------
# ForgeSight Data Intelligence Platform (optional — leave blank to disable)
# Provides real-time 3D printing price benchmarks for print cost estimates.
# Register at https://app.forgesight.quest/sign-up (free Starter tier: 10 calls/hr)
# ---------------------------------------------------------------------------
# FORGESIGHT_API_URL=https://api.forgesight.quest
# FORGESIGHT_EMAIL=admin@madfam.io
# FORGESIGHT_PASSWORD=
# FORGESIGHT_ENABLED=false
# FORGESIGHT_REGION=CDMX

# ---------------------------------------------------------------------------
# MQTT telemetry (optional — leave blank to disable)
# ---------------------------------------------------------------------------
# MQTT_BROKER=localhost
# MQTT_PORT=1883
# MQTT_ENABLED=true
