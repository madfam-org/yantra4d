    { "id": "speaker_hole_cyl", "type": "cylinder", "params": { "r": 0.7, "h": 6 } },
    { "id": "speaker_hole_rot", "type": "rotate", "inputs": { "shape": "speaker_hole_cyl" }, "params": { "axis": "y", "angle": 90 } },
    { "id": "speaker_place", "type": "translate", "inputs": { "shape": "speaker_hole_rot" }, "params": { "x": -78, "y": 54.3, "z": -2.65 } },
