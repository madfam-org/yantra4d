        "standard": "Arduino form factors",
        "parameters": [
          "board",
          "boss_d"
        ]
      },
      {
        "id": "din_rail_foot",
        "label": {
          "en": "DIN TS35 Foot",
          "es": "Pie DIN TS35"
        },
        "geometry_type": "rail",
        "standard": "DIN EN 60715",
