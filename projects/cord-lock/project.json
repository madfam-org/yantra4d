      },
      {
        "id": "cord_channel",
        "label": {
          "en": "Cord Channel",
          "es": "Canal de Cordón"
        },
        "geometry_type": "pocket",
        "standard": "internal",
        "parameters": [
          "cord_dia",
          "cords",
          "body_size"
        ]
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "Cord locks are the tiny plastic part that fails first and can never be found to replace — a print-in-place stopper sized to any cord keeps a jacket, bag, or tent in service instead of the landfill.",
      "es": "Los topes de cordón son la pequeña pieza de plástico que falla primero y nunca se encuentra para reemplazar — un tope impreso en el sitio dimensionado a cualquier cordón mantiene una chaqueta, bolsa o tienda en uso en vez del basurero."
    },
