      "cq_file": "main.py",
      "parts": ["bend_limiter"],
      "estimate": { "base_time": 12, "per_unit": 3, "per_part": 14 }
    }
  ],
  "parts": [
    { "id": "grommet_relief", "label": { "en": "Snap-In Grommet", "es": "Ojal a Presión" }, "render_mode": 0, "color": "#8f5f4f" },
