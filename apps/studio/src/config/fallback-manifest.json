{
  "project": {
    "name": "Gridfinity",
    "slug": "gridfinity",
    "version": "2.1.0",
    "engine": "cadquery",
    "description": {
      "en": "Gridfinity in exact CadQuery B-Rep: a hollow bin and a baseplate on the published 42 mm / 7 mm standard, with the stacking-lip base profile, optional magnet holes and a finger scoop. The former OpenSCAD \"extended\" modes were removed on 2026-09-04 (ADR-021) and are reserved for clean-room re-creation.",
      "es": "Gridfinity en B-Rep exacto con CadQuery: un contenedor hueco y una base sobre el estándar publicado de 42 mm / 7 mm, con el perfil de base apilable, orificios opcionales para imanes y una muesca para el dedo. Los antiguos modos «extended» en OpenSCAD se retiraron el 2026-09-04 (ADR-021) y quedan reservados para su recreación en sala limpia."
    },
    "thumbnail": "/projects/gridfinity.webp",
    "difficulty": "intermediate",
    "tags": [
      "gridfinity",
      "storage",
      "modular",
      "snap-fit",
      "baseplate",
      "organizer",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "attribution": {
      "author": "Zack Freedman",
      "url": "https://thangs.com/designer/ZackFreedman",
      "license": "MIT"
    }
  },
