      "modes": [
        "side_release",
        "slider",
        "tri_glide"
      ],
      "label": {
        "en": "Webbing Width",
        "es": "Ancho de Cincha"
      },
      "tooltip": {
        "en": "Nominal webbing width the buckle fits",
        "es": "Ancho nominal de cincha para la hebilla"
      },
