      "tooltip": { "en": "Magnet pocket diameter", "es": "Diámetro de la cavidad del imán" }
    },
    {
      "id": "magnet_h", "type": "slider", "default": 3.2, "min": 1.5, "max": 6.0, "step": 0.1,
