  "parameters": [
    {
      "id": "slot_series",
      "type": "select",
      "default": "2020",
      "group": "profile",
      "modes": [
        "t_nut",
        "corner_bracket",
        "cable_clip",
        "panel_clip"
      ],
      "options": [
        {
          "value": "2020",
          "label": {
            "en": "2020 (20 mm profile, 6 mm slot)",
            "es": "2020 (perfil 20 mm, ranura 6 mm)"
          }
        },
        {
          "value": "3030",
          "label": {
            "en": "3030 (30 mm profile, 8 mm slot)",
            "es": "3030 (perfil 30 mm, ranura 8 mm)"
          }
        },
        {
          "value": "4040",
          "label": {
            "en": "4040 (40 mm profile, 8 mm slot)",
            "es": "4040 (perfil 40 mm, ranura 8 mm)"
          }
        }
      ],
      "label": {
        "en": "Extrusion Series",
        "es": "Serie de Extrusión"
      },
      "tooltip": {
        "en": "Aluminium T-slot family the accessory locks into (Bosch Rexroth / OpenBuilds / Misumi HFS)",
        "es": "Familia de perfil T-slot de aluminio en la que encaja el accesorio (Bosch Rexroth / OpenBuilds / Misumi HFS)"
      }
    },
    {
      "id": "slot_fit_clearance",
      "type": "slider",
      "default": 0.3,
      "min": 0.0,
      "max": 0.8,
      "step": 0.05,
      "group": "profile",
      "modes": [
        "t_nut",
        "corner_bracket",
        "cable_clip",
        "panel_clip"
      ],
      "advanced": true,
      "label": {
        "en": "Slot Fit Clearance (mm)",
        "es": "Holgura de Ajuste (mm)"
      },
      "tooltip": {
        "en": "Per-side gap between the printed part and the slot for a workable fit (tune per printer/material)",
        "es": "Espacio por lado entre la pieza impresa y la ranura para un ajuste funcional (ajustar por impresora/material)"
      }
    },
    {
      "id": "screw_size",
      "type": "select",
      "default": "M4",
      "group": "fastener",
      "modes": [
        "t_nut",
        "corner_bracket"
      ],
      "options": [
        {
          "value": "M3",
          "label": {
            "en": "M3 (clearance 3.4 mm)",
            "es": "M3 (holgura 3.4 mm)"
          }
        },
        {
          "value": "M4",
          "label": {
            "en": "M4 (clearance 4.5 mm)",
            "es": "M4 (holgura 4.5 mm)"
          }
        },
        {
          "value": "M5",
          "label": {
            "en": "M5 (clearance 5.5 mm)",
            "es": "M5 (holgura 5.5 mm)"
          }
        }
      ],
      "label": {
        "en": "Screw Size",
        "es": "Tamaño de Tornillo"
      },
      "tooltip": {
        "en": "Metric screw the hole is sized for (2020 typically M5, 3030/4040 M6-class fits use M5 here)",
        "es": "Tornillo métrico para el que se dimensiona el agujero (2020 normalmente M5; 3030/4040 usan M5 aquí)"
      }
    },
    {
      "id": "nut_length",
      "type": "slider",
      "default": 12,
      "min": 6,
      "max": 40,
      "step": 1,
      "group": "t_nut",
      "modes": [
        "t_nut"
      ],
      "label": {
        "en": "T-Nut Length (mm)",
        "es": "Largo de Tuerca (mm)"
      },
      "tooltip": {
        "en": "Length along the slot axis. Short = drop-in and quarter-turn; long = slide in from the end for more grip",
        "es": "Largo a lo largo del eje de la ranura. Corto = insertar y girar un cuarto; largo = deslizar desde el extremo para más agarre"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "x",
        "scale_factor": 1.0,
        "affected_parts": [
          "t_nut"
        ]
      }
    },
    {
      "id": "tapped",
      "type": "checkbox",
      "default": false,
      "group": "t_nut",
      "modes": [
        "t_nut"
      ],
      "advanced": true,
      "label": {
        "en": "Tapped / Heat-Set Bore",
        "es": "Barreno Roscado / Inserto"
      },
      "tooltip": {
        "en": "Use a smaller bore for a self-tapping screw or brass heat-set insert instead of a clearance hole",
        "es": "Usa un barreno más pequeño para tornillo autorroscante o inserto de latón en vez de agujero pasante"
      }
    },
    {
      "id": "bracket_leg",
      "type": "slider",
      "default": 30,
      "min": 15,
      "max": 80,
      "step": 1,
      "group": "bracket",
      "modes": [
        "corner_bracket"
      ],
      "label": {
        "en": "Bracket Leg Length (mm)",
        "es": "Largo de Brazo (mm)"
      },
      "tooltip": {
        "en": "Length of each arm of the angle bracket",
        "es": "Largo de cada brazo de la escuadra"
      }
    },
    {
      "id": "bracket_thick",
      "type": "slider",
      "default": 5.0,
      "min": 3.0,
      "max": 10.0,
      "step": 0.5,
      "group": "bracket",
      "modes": [
        "corner_bracket"
      ],
      "label": {
        "en": "Bracket Thickness (mm)",
        "es": "Grosor de Escuadra (mm)"
      },
      "tooltip": {
        "en": "Wall thickness of the bracket legs",
        "es": "Grosor de pared de los brazos de la escuadra"
      }
    },
    {
      "id": "bracket_gusset",
      "type": "checkbox",
      "default": true,
      "group": "bracket",
      "modes": [
        "corner_bracket"
      ],
      "label": {
        "en": "Stiffening Gusset",
        "es": "Refuerzo Triangular"
      },
      "tooltip": {
        "en": "Add a triangular gusset across the corner for rigidity",
        "es": "Añade un refuerzo triangular en la esquina para rigidez"
      }
    },
    {
      "id": "cable_dia",
      "type": "slider",
      "default": 6.0,
      "min": 2.0,
      "max": 16.0,
      "step": 0.5,
      "group": "cable",
      "modes": [
        "cable_clip"
      ],
      "label": {
        "en": "Cable Diameter (mm)",
        "es": "Diámetro de Cable (mm)"
      },
      "tooltip": {
        "en": "Outer diameter of the wire bundle or pneumatic line the clip routes",
        "es": "Diámetro exterior del haz de cables o línea neumática que enruta el clip"
      }
    },
    {
      "id": "panel_t",
      "type": "slider",
      "default": 3.0,
      "min": 1.0,
      "max": 8.0,
      "step": 0.5,
      "group": "panel",
      "modes": [
        "panel_clip"
      ],
      "label": {
        "en": "Panel Thickness (mm)",
        "es": "Grosor de Panel (mm)"
      },
      "tooltip": {
        "en": "Thickness of the acrylic / plywood panel edge the clip retains",
        "es": "Grosor del borde de panel de acrílico / madera que retiene el clip"
      }
    }
  ],
