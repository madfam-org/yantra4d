{
  "project": {
    "name": "Lens & Filter Cap",
    "slug": "lens-cap",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "Front lens caps, rear body caps and step-up/step-down rings for the universal photographic filter-thread system (49/52/58/67/72/77/82 mm at a fine 0.75 mm pitch). Build a pinch/press snap cap sized to a filter OD, a step ring that threads one filter size to another, or a rear body-cap blank.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Tapas frontales de lente, tapas traseras de cuerpo y anillos escalonados para el sistema universal de rosca de filtro fotográfico (49/52/58/67/72/77/82 mm con paso fino de 0.75 mm). Genera una tapa a presión dimensionada al diámetro del filtro, un anillo escalonado que enrosca un tamaño de filtro a otro, o una tapa trasera de cuerpo.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/lens-cap.webp",
    "difficulty": "intermediate",
    "tags": ["lens-cap", "filter", "step-ring", "body-cap", "photography", "thread", "camera", "hyperobject", "commons"],
    "hyperobject": { "is_hyperobject": true },
    "force_backend": true
  },
  "modes": [
    {
      "id": "snap_cap",
      "label": { "en": "Snap Cap", "es": "Tapa a Presión" },
      "scad_file": "main.py",
