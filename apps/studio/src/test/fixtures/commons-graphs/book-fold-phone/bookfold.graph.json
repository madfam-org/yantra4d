    { "id": "hingefold_relief", "type": "rotate", "inputs": { "shape": "hingefold_relief_cyl" }, "params": { "axis": "y", "angle": 90 } },

    { "id": "framehalf_cover_box", "type": "box", "params": { "w": 156, "d": 74, "h": 4.7 } },
