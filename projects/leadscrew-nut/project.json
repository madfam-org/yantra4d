    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "Lead-screw nuts wear out and back-order for weeks; a stripped Z nut halts a printer or CNC entirely. A printable trapezoidal nut in the exact standard restores motion the same day with no proprietary spare.",
      "es": "Las tuercas de husillo se desgastan y tardan semanas en reponerse; una tuerca Z barrida detiene por completo una impresora o CNC. Una tuerca trapezoidal imprimible en el estándar exacto restaura el movimiento el mismo día sin repuesto propietario."
    },
    "commons_license": "CERN-OHL-W-2.0"
  },
