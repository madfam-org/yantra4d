      "label": {
        "en": "Y-Splitter",
        "es": "Divisor en Y"
      },
      "render_mode": 0,
      "color": "#4f9fd0"
    }
  ],
  "parameter_groups": [
    {
      "id": "thread",
      "label": {
        "en": "Thread & Fit",
        "es": "Rosca y Ajuste"
      }
    },
    {
      "id": "body",
      "label": {
        "en": "Body & Bore",
        "es": "Cuerpo y Barreno"
      }
    },
    {
      "id": "outlet",
      "label": {
        "en": "Outlet",
        "es": "Salida"
      }
    }
  ],
  "parameters": [
    {
      "id": "turns",
      "type": "slider",
      "default": 2.0,
      "min": 1.0,
      "max": 2.5,
      "step": 0.25,
      "group": "thread",
      "modes": [
        "ght_coupler",
        "nozzle_adapter",
        "y_splitter"
      ],
      "label": {
        "en": "Thread Turns",
        "es": "Vueltas de Rosca"
      },
      "tooltip": {
        "en": "Engagement turns — more grip vs slower print/render",
        "es": "Vueltas de agarre — más sujeción vs impresión/render más lento"
      }
    },
    {
      "id": "clearance",
      "type": "slider",
      "default": 0.35,
      "min": 0.1,
      "max": 0.8,
      "step": 0.05,
      "group": "thread",
      "modes": [
        "ght_coupler",
        "nozzle_adapter",
        "y_splitter"
      ],
      "label": {
        "en": "Thread Clearance (mm)",
        "es": "Holgura de Rosca (mm)"
      },
      "tooltip": {
        "en": "Per-side slop for a printable thread fit",
        "es": "Holgura por lado para un ajuste imprimible"
      }
    },
    {
      "id": "wall",
      "type": "slider",
      "default": 3.0,
      "min": 2.0,
      "max": 6.0,
      "step": 0.2,
      "group": "body",
      "modes": [
        "ght_coupler",
        "nozzle_adapter",
        "y_splitter"
      ],
      "label": {
        "en": "Wall Thickness (mm)",
        "es": "Grosor de Pared (mm)"
      },
      "tooltip": {
        "en": "Body wall around the thread",
        "es": "Pared del cuerpo alrededor de la rosca"
      }
    },
    {
      "id": "bore_dia",
      "type": "slider",
      "default": 14.0,
      "min": 4.0,
      "max": 22.0,
      "step": 0.5,
      "group": "body",
      "modes": [
        "ght_coupler",
        "nozzle_adapter",
        "y_splitter"
      ],
      "label": {
        "en": "Through Bore (mm)",
        "es": "Barreno Pasante (mm)"
      },
      "tooltip": {
        "en": "Fluid channel diameter",
        "es": "Diámetro del canal de fluido"
      }
    },
    {
      "id": "grip_knurl",
      "type": "checkbox",
      "default": true,
      "group": "body",
      "modes": [
        "ght_coupler",
        "nozzle_adapter",
        "y_splitter"
      ],
      "label": {
        "en": "Grip Flutes",
        "es": "Estrías de Agarre"
      },
      "tooltip": {
        "en": "Knurl the hub for a hand grip",
        "es": "Estrías en el cubo para agarre manual"
      }
    },
    {
      "id": "spout_dia",
      "type": "slider",
      "default": 13.0,
      "min": 6.0,
      "max": 24.0,
      "step": 0.5,
      "group": "outlet",
      "modes": [
        "nozzle_adapter"
      ],
      "label": {
        "en": "Spout OD (mm)",
        "es": "Diámetro de Boquilla (mm)"
      },
      "tooltip": {
        "en": "Outer diameter of the barbed push spout",
        "es": "Diámetro exterior de la boquilla dentada"
      }
    },
    {
      "id": "barb_count",
      "type": "slider",
      "default": 3,
      "min": 1,
      "max": 6,
      "step": 1,
      "group": "outlet",
      "modes": [
        "nozzle_adapter"
      ],
      "label": {
        "en": "Barb Ridges",
        "es": "Anillos Dentados"
      },
      "tooltip": {
        "en": "Number of grip ridges on the spout",
        "es": "Número de anillos de agarre en la boquilla"
      }
    },
    {
      "id": "split_ang",
      "type": "slider",
      "default": 35.0,
      "min": 15.0,
      "max": 55.0,
      "step": 1.0,
      "group": "outlet",
      "modes": [
        "y_splitter"
      ],
      "label": {
        "en": "Split Angle (deg)",
        "es": "Ángulo de División (°)"
      },
      "tooltip": {
        "en": "Half-angle each Y outlet fans out",
        "es": "Semiángulo de apertura de cada salida en Y"
      }
    }
  ],
  "presets": [
    {
      "id": "hose_join",
      "mode": "ght_coupler",
      "label": {
        "en": "Hose Join (GHT×GHT)",
        "es": "Unión de Manguera (GHT×GHT)"
      },
      "values": {
        "turns": 2.0,
        "bore_dia": 14,
        "wall": 3.0
      }
    },
    {
      "id": "drip_feed",
      "mode": "nozzle_adapter",
      "label": {
        "en": "Drip Tube Feed",
        "es": "Alimentación de Goteo"
      },
      "values": {
        "spout_dia": 10,
        "barb_count": 4,
        "bore_dia": 8
      }
    },
    {
      "id": "two_way",
      "mode": "y_splitter",
      "label": {
        "en": "Two-Way Splitter",
        "es": "Divisor de Dos Vías"
      },
      "values": {
        "split_ang": 35,
        "turns": 2.0,
        "bore_dia": 12
      }
    }
  ],
  "constraints": [
    {
      "expression": "bore_dia <= 24 - 2 * wall",
      "severity": "warning",
      "message": {
        "en": "Bore is large relative to the thread envelope",
        "es": "El barreno es grande respecto a la rosca"
      }
    },
    {
      "expression": "wall >= 2",
      "severity": "error",
      "message": {
        "en": "Wall must be at least 2 mm around a pressurized thread",
        "es": "La pared debe ser de al menos 2 mm en una rosca a presión"
      }
    }
  ],
