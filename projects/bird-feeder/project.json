  "constraints": [
    {
      "expression": "port_size < tube_dia",
      "severity": "warning",
      "message": {
        "en": "Seed port is large relative to the tube",
        "es": "El puerto de semilla es grande respecto al tubo"
      }
    },
    {
      "expression": "wall >= 2",
      "severity": "error",
      "message": {
        "en": "Wall must be at least 2 mm",
        "es": "La pared debe ser de al menos 2 mm"
      }
    }
