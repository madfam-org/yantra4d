        "type": "axis_scale",
        "axis": "radial",
        "scale_factor": 0.5
      }
    },
    {
      "id": "width",
      "type": "slider",
      "default": 10.9,
      "min": 4.0,
      "max": 24.0,
      "step": 0.1,
      "group": "wheel",
      "modes": [
        "vwheel",
        "flat_wheel",
        "solid_wheel"
      ],
      "label": {
        "en": "Wheel Width (mm)",
        "es": "Ancho de Rueda (mm)"
      },
      "tooltip": {
        "en": "Axial width (OpenBuilds V-wheel ≈ 10.9 mm)",
        "es": "Ancho axial (rueda en V OpenBuilds ≈ 10.9 mm)"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "z",
        "scale_factor": 1.0
      }
    },
    {
      "id": "v_angle",
      "type": "slider",
      "default": 90.0,
      "min": 60.0,
      "max": 120.0,
      "step": 1.0,
      "group": "vprofile",
      "modes": [
        "vwheel",
        "solid_wheel"
      ],
      "label": {
        "en": "V Included Angle (°)",
        "es": "Ángulo Incluido en V (°)"
      },
      "tooltip": {
        "en": "90° gives two 45° flanks matching a V-slot rail (auto-clamped to keep a solid core)",
        "es": "90° da dos flancos de 45° que coinciden con un riel de ranura en V (limitado para conservar un núcleo sólido)"
      }
    },
    {
      "id": "bearing_bore",
      "type": "slider",
      "default": 16.0,
      "min": 3.0,
      "max": 30.0,
      "step": 0.5,
      "group": "bore",
      "modes": [
        "vwheel",
        "flat_wheel"
      ],
      "label": {
        "en": "Bearing Bore (mm)",
        "es": "Barreno de Rodamiento (mm)"
      },
      "tooltip": {
        "en": "Bearing OD press-fit seat (625 = 16, 608 = 22)",
        "es": "Alojamiento a presión del DE del rodamiento (625 = 16, 608 = 22)"
      }
    },
    {
      "id": "counterbore",
      "type": "checkbox",
      "default": true,
      "group": "bore",
      "modes": [
        "vwheel",
        "flat_wheel"
      ],
      "label": {
        "en": "Bearing Shoulder Recess",
        "es": "Rebaje de Hombro de Rodamiento"
      },
      "tooltip": {
        "en": "Recess each face slightly so the bearing shoulders sit flush",
        "es": "Rebaja ligeramente cada cara para que los hombros del rodamiento queden al ras"
      }
    },
    {
      "id": "cb_depth",
      "type": "slider",
      "default": 0.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.2,
      "group": "bore",
      "modes": [
        "vwheel",
        "flat_wheel"
      ],
      "advanced": true,
      "label": {
        "en": "Shoulder Recess Depth (mm)",
        "es": "Profundidad de Rebaje (mm)"
      },
      "tooltip": {
        "en": "Extra recess depth per face (0 = a light default recess)",
        "es": "Profundidad extra de rebaje por cara (0 = rebaje ligero por defecto)"
      }
    },
    {
      "id": "axle_bore",
      "type": "slider",
      "default": 5.0,
      "min": 2.0,
      "max": 20.0,
      "step": 0.5,
      "group": "bore",
      "modes": [
        "solid_wheel"
      ],
      "label": {
        "en": "Axle Hole (mm)",
        "es": "Agujero de Eje (mm)"
      },
      "tooltip": {
        "en": "Plain axle hole for a bearingless solid wheel",
        "es": "Agujero de eje simple para una rueda maciza sin rodamiento"
      }
