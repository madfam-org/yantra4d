    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest-axe": "^9.0.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.14",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "axios": "^1.16.1",
