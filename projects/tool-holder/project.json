      "group": "mounting", "modes": ["block"],
      "label": { "en": "Wall Mount Back Plate", "es": "Placa Trasera de Pared" },
      "tooltip": { "en": "Informational — use the Wall Rack mode for a back plate + screw holes", "es": "Informativo — usa el modo Estante de Pared para placa trasera + agujeros" }
