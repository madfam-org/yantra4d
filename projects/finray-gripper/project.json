    { "id": "finray_finger", "label": { "en": "Modular Finger", "es": "Dedo Modular" }, "render_mode": 0, "color": "#5c95a5" }
  ],
  "parameter_groups": [
    { "id": "finger", "label": { "en": "Fin-Ray Finger", "es": "Dedo Fin-Ray" } },
