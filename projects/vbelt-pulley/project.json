    {
      "id": "hub_dia", "type": "slider", "default": 22.0, "min": 8.0, "max": 40.0, "step": 0.5,
      "group": "hub", "modes": ["vbelt", "roundbelt", "multi_groove"], "advanced": true,
      "label": { "en": "Hub Diameter (mm)", "es": "Diámetro de Cubo (mm)" },
      "tooltip": { "en": "Outer diameter of the set-screw hub", "es": "Diámetro exterior del cubo del prisionero" }
    },
    {
      "id": "hub_height", "type": "slider", "default": 8.0, "min": 2.0, "max": 25.0, "step": 0.5,
      "group": "hub", "modes": ["vbelt", "roundbelt", "multi_groove"], "advanced": true,
      "label": { "en": "Hub Height (mm)", "es": "Altura de Cubo (mm)" },
      "tooltip": { "en": "How far the hub extends below the rim", "es": "Cuánto se extiende el cubo bajo el aro" }
    },
    {
