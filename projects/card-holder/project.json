        "es": "Base"
      }
    },
    {
      "id": "hold",
      "label": {
        "en": "Card / Page Hold",
        "es": "Sujeción de Carta / Página"
      }
    }
  ],
  "parameters": [
    {
      "id": "base_len",
      "type": "slider",
      "default": 150.0,
      "min": 60.0,
      "max": 300.0,
      "step": 1.0,
      "group": "base",
