      "group": "multi", "modes": ["multi_groove"], "advanced": true,
      "label": { "en": "Groove Spacing (mm)", "es": "Separación entre Ranuras (mm)" },
      "tooltip": { "en": "Centre-to-centre spacing between adjacent grooves", "es": "Separación centro a centro entre ranuras adyacentes" }
    },
    {
      "id": "bore", "type": "slider", "default": 8.0, "min": 2.0, "max": 30.0, "step": 0.5,
