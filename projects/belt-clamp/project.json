    },
    {
      "id": "htd_joiner", "mode": "belt_joiner",
      "label": { "en": "HTD 3M Joiner", "es": "Empalmador HTD 3M" },
      "values": { "belt": "HTD-3M", "teeth": 8, "belt_w": 9 }
    }
  ],
  "constraints": [
    {
      "expression": "teeth >= 2",
      "severity": "error",
      "message": { "en": "A grip needs at least 2 teeth to hold the belt", "es": "Un agarre necesita al menos 2 dientes para sujetar la banda" }
    },
    {
      "expression": "floor >= 1.6",
      "severity": "warning",
      "message": { "en": "A floor under 1.6 mm may be too thin beneath the ridges", "es": "Un piso menor a 1.6 mm puede ser demasiado delgado bajo las crestas" }
    }
  ],
  "camera_views": [
