      "type": "slider",
      "default": 55.0,
      "min": 30.0,
      "max": 120.0,
      "step": 1.0,
      "group": "base",
      "modes": [
        "card_rack",
        "book_stand",
        "page_holder"
      ],
      "label": {
        "en": "Depth (mm)",
        "es": "Profundidad (mm)"
      },
      "tooltip": {
        "en": "Front-to-back depth (footprint stability)",
        "es": "Profundidad de adelante hacia atrás (estabilidad de la base)"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "y",
        "scale_factor": 1.0
      }
    },
    {
      "id": "base_h",
      "type": "slider",
      "default": 16.0,
      "min": 8.0,
      "max": 40.0,
      "step": 1.0,
      "group": "base",
      "modes": [
        "card_rack",
        "book_stand",
        "page_holder"
      ],
      "label": {
        "en": "Base Height (mm)",
        "es": "Altura de Base (mm)"
      },
      "tooltip": {
        "en": "Height / mass of the base block",
        "es": "Altura / masa del bloque base"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "z",
        "scale_factor": 1.0
      }
    },
    {
      "id": "card_t",
      "type": "slider",
      "default": 1.2,
      "min": 0.4,
      "max": 6.0,
      "step": 0.1,
      "group": "hold",
      "modes": [
        "card_rack",
        "page_holder"
      ],
      "advanced": true,
      "label": {
        "en": "Card / Page Thickness (mm)",
        "es": "Grosor de Carta / Página (mm)"
      },
      "tooltip": {
        "en": "Thickness of a single card or page (a poker card is ~0.3 mm; a fan is thicker)",
        "es": "Grosor de una sola carta o página (una carta de póker es ~0.3 mm; un abanico es más grueso)"
      }
    },
    {
      "id": "groove_gap",
      "type": "slider",
      "default": 2.4,
      "min": 1.5,
      "max": 12.0,
      "step": 0.1,
      "group": "hold",
      "modes": [
        "card_rack",
        "page_holder"
      ],
      "label": {
        "en": "Groove Width (mm)",
        "es": "Ancho de Ranura (mm)"
      },
      "tooltip": {
        "en": "Slot width — a wider groove holds more cards",
        "es": "Ancho de la ranura — una ranura más ancha sostiene más cartas"
      }
    },
    {
      "id": "groove_ang",
      "type": "slider",
      "default": 65.0,
      "min": 45.0,
      "max": 85.0,
      "step": 1.0,
      "group": "hold",
      "modes": [
        "card_rack"
      ],
      "label": {
        "en": "Card Lean Angle (deg)",
        "es": "Ángulo de Inclinación de Cartas (grados)"
      },
      "tooltip": {
        "en": "How upright the cards stand (from horizontal)",
        "es": "Cuán verticales quedan las cartas (desde la horizontal)"
      }
    },
    {
      "id": "n_grooves",
      "type": "slider",
      "default": 3,
      "min": 1,
      "max": 6,
      "step": 1,
      "group": "hold",
      "modes": [
        "card_rack"
      ],
      "label": {
        "en": "Number of Rows",
        "es": "Número de Filas"
      },
      "tooltip": {
        "en": "How many parallel card rows the rack has",
        "es": "Cuántas filas paralelas de cartas tiene el atril"
      }
    },
    {
      "id": "lip_h",
      "type": "slider",
      "default": 12.0,
      "min": 5.0,
      "max": 40.0,
      "step": 1.0,
      "group": "hold",
      "modes": [
        "book_stand",
        "page_holder"
      ],
      "label": {
        "en": "Front Ledge Height (mm)",
        "es": "Altura del Reborde Frontal (mm)"
      },
      "tooltip": {
        "en": "Height of the ledge that stops the book/page sliding off",
        "es": "Altura del reborde que evita que el libro/página se deslice"
      }
    },
    {
      "id": "stand_ang",
      "type": "slider",
      "default": 60.0,
      "min": 35.0,
      "max": 80.0,
      "step": 1.0,
      "group": "hold",
      "modes": [
        "book_stand"
      ],
      "label": {
        "en": "Easel Angle (deg)",
        "es": "Ángulo del Atril (grados)"
      },
      "tooltip": {
        "en": "Reading angle of the easel back",
        "es": "Ángulo de lectura del respaldo del atril"
      }
    }
  ],
  "presets": [
