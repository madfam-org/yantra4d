{
  "project": {
    "name": "Sprinkler & Nozzle Adapter",
    "slug": "sprinkler-adapter",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "Puts a real Garden-Hose-Thread (GHT 3/4\") interface on a hose so any sprinkler, spray nozzle, or drip line screws on. Straight GHT coupler, GHT-to-spout nozzle adapter, or a two-outlet Y-splitter. The thread is a genuine helical rib, dimensionally matched to the NH garden-hose finish.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Coloca una interfaz real de rosca de manguera de jardín (GHT 3/4\") para que cualquier aspersor, boquilla o línea de goteo se enrosque. Acoplador GHT recto, adaptador GHT a boquilla, o un divisor Y de dos salidas. La rosca es una costilla helicoidal real, dimensionada al acabado NH de manguera de jardín.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/sprinkler-adapter.webp",
    "difficulty": "intermediate",
    "tags": [
      "sprinkler",
      "hose",
      "ght",
      "adapter",
      "thread",
      "garden",
      "irrigation",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
  "modes": [
    {
      "id": "ght_coupler",
      "label": {
        "en": "GHT Coupler",
        "es": "Acoplador GHT"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": [
        "ght_coupler"
      ],
      "estimate": {
        "base_time": 18,
        "per_unit": 3,
        "per_part": 18
      }
    },
    {
      "id": "nozzle_adapter",
      "label": {
        "en": "Nozzle Adapter",
        "es": "Adaptador de Boquilla"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": [
        "nozzle_adapter"
      ],
      "estimate": {
        "base_time": 12,
        "per_unit": 3,
        "per_part": 12
      }
    },
    {
      "id": "y_splitter",
      "label": {
        "en": "Y-Splitter",
        "es": "Divisor en Y"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": [
        "y_splitter"
      ],
      "estimate": {
        "base_time": 16,
        "per_unit": 3,
        "per_part": 16
      }
    }
  ],
  "parts": [
