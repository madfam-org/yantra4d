        "per_part": 16
      }
    },
    {
      "id": "page_holder",
      "label": {
        "en": "Page Holder",
        "es": "Sujetapáginas"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "engine": "cadquery",
      "parts": [
