{
  "project": {
    "name": "Cuvette / Filter Wheel",
    "slug": "filter-wheel",
    "version": "1.0.0",
    "description": {
      "en": "Benchtop optics hyperobject: a detented rotating filter/optic wheel that seats Ø1 in or Ø25 mm optics, a multi-well cuvette holder block with beam-access windows for standard 10 mm cuvettes, and a knurled retaining hub cap. Swap filters by hand or organize spectroscopy cells on the bench.",
      "es": "Hiperobjeto de óptica de mesa: una rueda de filtros/óptica giratoria con retenes que aloja ópticas de Ø1 in o Ø25 mm, un bloque portacubetas de múltiples pozos con ventanas de paso de haz para cubetas estándar de 10 mm, y una tapa de cubo estriada. Cambia filtros a mano u organiza celdas de espectroscopía en la mesa."
    },
    "thumbnail": "/projects/filter-wheel.webp",
    "tags": ["optics", "filter-wheel", "cuvette", "spectroscopy", "lab", "medical", "hyperobject", "commons"],
    "difficulty": "advanced",
    "hyperobject": {
      "is_hyperobject": true
    },
    "engine": "cadquery",
    "force_backend": true
  },
  "hyperobject": {
    "is_hyperobject": true,
    "domain": "medical",
    "material_awareness": {
      "shrinkage_compensation": true,
      "recycled_material_toggle": false,
      "tolerance_by_material": true,
      "notes": {
        "en": "Optic seats use +0.2 mm radial clearance; print opaque black filament to block stray light between filter positions.",
        "es": "Los asientos ópticos usan +0.2 mm de holgura radial; imprime en filamento negro opaco para bloquear luz parásita entre posiciones."
      }
    },
    "cdg_interfaces": [
      {
        "id": "optic_seat",
        "label": {
          "en": "Optic Seat & Light Path",
          "es": "Asiento Óptico y Paso de Luz"
        },
        "geometry_type": "socket",
        "standard": "Ø1 in (25.4 mm) / Ø25 mm optic",
        "parameters": ["optic_diameter", "positions"]
      },
      {
        "id": "cuvette_well",
        "label": {
          "en": "Cuvette Well (10 mm path)",
          "es": "Pozo de Cubeta (paso 10 mm)"
        },
        "geometry_type": "pocket",
        "standard": "12.5 mm square, 10 mm path-length cuvette",
        "parameters": ["cuvette_wells"]
      }
    ],
    "societal_benefit": {
      "en": "Lets teaching and field labs assemble spectroscopy and imaging optics trains without proprietary filter wheels, lowering the barrier to hands-on photonics.",
      "es": "Permite a laboratorios docentes y de campo montar trenes ópticos de espectroscopía e imagen sin ruedas de filtros propietarias, reduciendo la barrera a la fotónica práctica."
    },
    "commons_license": "CERN-OHL-W-2.0"
  },
  "modes": [
    {
      "id": "wheel",
      "scad_file": "main.py",
      "cq_file": "main.py",
      "engine": "cadquery",
      "label": {
        "en": "Filter / Optic Wheel",
        "es": "Rueda de Filtros / Óptica"
      },
      "description": {
        "en": "Rotating disc with N optic pockets, per-seat light-path holes, a central shaft bore, and rim detent notches for indexed positions."
      },
      "parts": ["wheel"],
      "estimate": {
        "base_units": 1,
        "formula": "per_part"
      }
    },
    {
      "id": "cuvette_block",
