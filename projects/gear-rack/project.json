{
  "project": {
    "name": "Involute Gear Rack",
    "slug": "gear-rack",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A linear involute gear rack that meshes with a spur pinion. Straight trapezoidal teeth inclined at the pressure angle (ISO 53 / DIN 867), with optional back-mounting holes and an optional matching involute pinion for a complete rack-and-pinion set.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Una cremallera lineal de involuta que engrana con un piñón recto. Dientes trapezoidales rectos inclinados al ángulo de presión (ISO 53 / DIN 867), con orificios de montaje traseros opcionales y un piñón de involuta a juego opcional para un conjunto completo de cremallera y piñón.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/gear-rack.webp",
    "difficulty": "advanced",
    "tags": [
      "gear",
      "rack",
      "pinion",
      "involute",
      "linear",
      "motion",
      "mechanism",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
