    {"id": "xs_p", "expr": "xp_p + pd / 2"},
    {"id": "slot_x0_p", "expr": "xs_p < xe_p ? xs_p : xe_p"},
    {"id": "slot_x1_p", "expr": "xs_p > xe_p ? xs_p : xe_p"},
