      "message": { "en": "Spacing is tight relative to the tool diameter", "es": "La separación es ajustada respecto al diámetro de la herramienta" }
    },
    {
      "expression": "block_h > bore_depth",
      "severity": "error",
      "message": { "en": "Block must be taller than the bore depth", "es": "El bloque debe ser más alto que la profundidad del orificio" }
    }
  ],
