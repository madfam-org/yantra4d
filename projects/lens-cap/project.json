      "values": { "body_cap_d": 42.0, "wall": 2.4 }
    }
  ],
  "constraints": [
    {
      "expression": "wall >= 1.6",
      "severity": "error",
      "message": { "en": "Wall must be at least 1.6 mm for a printable cap", "es": "La pared debe ser de al menos 1.6 mm para una tapa imprimible" }
    },
    {
      "expression": "clearance <= 0.6",
      "severity": "warning",
      "message": { "en": "Large clearance makes the thread/press fit loose", "es": "Una holgura grande hace flojo el ajuste de rosca/presión" }
    }
  ],
  "camera_views": [
    { "id": "iso", "label": { "en": "Isometric", "es": "Isométrico" }, "position": [90, 90, 90] },
    { "id": "top", "label": { "en": "Top", "es": "Superior" }, "position": [0, 0, 160] },
    { "id": "front", "label": { "en": "Front", "es": "Frontal" }, "position": [0, -160, 20] }
  ],
