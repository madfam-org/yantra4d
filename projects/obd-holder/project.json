      "values": { "obd_w": 25, "obd_h": 13, "screw_d": 4.2 }
    }
  ],
  "constraints": [
    {
      "expression": "obd_w > obd_h",
      "severity": "warning",
      "message": { "en": "The OBD-II connector face is wider than it is tall", "es": "La cara del conector OBD-II es más ancha que alta" }
    },
    {
      "expression": "wall >= 1.6",
      "severity": "warning",
      "message": { "en": "Thin pocket walls can split around a snug fuse", "es": "Paredes delgadas de bolsillo pueden partirse alrededor de un fusible ajustado" }
    }
  ],
  "camera_views": [
