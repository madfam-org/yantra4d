      "tooltip": {
        "en": "The ball diameter — the socket is sized to match this",
        "es": "El diámetro de la bola — la copa se dimensiona para coincidir"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "radial",
        "scale_factor": 1.0
