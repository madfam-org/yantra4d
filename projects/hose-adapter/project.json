  "constraints": [
    {
      "expression": "bore_dia < barb_dia",
      "severity": "warning",
      "message": {
        "en": "Through bore should be smaller than the barb OD",
        "es": "El barreno debe ser menor que el DE de la espiga"
      }
    },
    {
      "expression": "wall >= 1.6",
      "severity": "error",
      "message": {
        "en": "Wall must be at least 1.6 mm",
        "es": "La pared debe ser de al menos 1.6 mm"
      }
    }
  ],
