  "constraints": [
    {
      "expression": "socket_grip < 1",
      "severity": "error",
      "message": {
        "en": "Socket grip must be below 1 so the opening captures the ball",
        "es": "El agarre debe ser menor que 1 para que la apertura capture la bola"
      }
    },
    {
      "expression": "stem_dia <= ball_dia - 1",
      "severity": "warning",
      "message": {
        "en": "Stem should be thinner than the ball",
        "es": "El vástago debe ser más delgado que la bola"
      }
    }
  ],
