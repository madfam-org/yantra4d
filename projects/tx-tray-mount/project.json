      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "Long flying and simulator sessions strain wrists, and OEM trays cost more than the plastic they use. An on-demand tray sized to the exact radio carries the weight on a strap, angles the screen, and holds a telemetry phone.",
      "es": "Las sesiones largas de vuelo y simulador cansan las munecas, y las bandejas originales cuestan mas que el plastico que usan. Una bandeja bajo demanda dimensionada a la radio exacta carga el peso en una correa, angula la pantalla y sostiene un telefono de telemetria."
    },
