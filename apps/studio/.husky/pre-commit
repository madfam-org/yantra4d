#!/bin/sh

# Sync fallback manifest if source has changed.
# The fallback manifest is for offline/WASM mode, so force_backend must be
# stripped — it would prevent WASM rendering when the backend is unreachable.
#
# Delegate to the same script CI checks with. This used to strip the key with
# `sed '/"force_backend":/d'`, a line-level delete, while CI compared parsed
# JSON — two different definitions of "in sync" that could disagree.
ROOT_DIR="$(git rev-parse --show-toplevel)"
MANIFEST_DST="$ROOT_DIR/apps/studio/src/config/fallback-manifest.json"
if ! python3 "$ROOT_DIR/scripts/qa/sync_fallback_manifest.py" --check >/dev/null 2>&1; then
  echo "husky: Syncing fallback manifest before commit..."
  python3 "$ROOT_DIR/scripts/qa/sync_fallback_manifest.py" || exit 1
  git add "$MANIFEST_DST"
fi

# Run Lint Staged in Studio
(cd apps/studio && npx lint-staged) || exit 1

# Run Python Linting (Ruff)
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ -n "$STAGED_PY" ]; then
  if command -v ruff >/dev/null 2>&1; then
    echo "$STAGED_PY" | xargs ruff check
  else
    echo "Warning: ruff not found, skipping Python lint"
  fi
fi
