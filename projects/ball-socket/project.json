      "id": "socket_grip",
      "type": "slider",
      "default": 0.85,
      "min": 0.55,
      "max": 0.95,
      "step": 0.01,
      "group": "ball",
      "modes": [
        "socket_cup",
        "arm_segment"
      ],
      "label": {
        "en": "Socket Grip",
        "es": "Agarre de Copa"
      },
      "tooltip": {
        "en": "Opening as a fraction of ball diameter. Below 1 the mouth is smaller than the ball, so it snaps in and holds. Lower = grips harder",
        "es": "Apertura como fracción del diámetro de la bola. Por debajo de 1 la boca es menor que la bola, así encaja y sostiene. Menor = agarra más"
      }
    },
    {
      "id": "socket_clear",
      "type": "slider",
      "default": 0.3,
      "min": 0.1,
      "max": 1.0,
      "step": 0.05,
      "group": "ball",
      "modes": [
        "socket_cup",
        "arm_segment"
      ],
      "advanced": true,
      "label": {
        "en": "Socket Clearance (mm)",
        "es": "Holgura de Copa (mm)"
      },
      "tooltip": {
        "en": "Radial gap between the socket cavity and the ball so it pivots freely",
        "es": "Espacio radial entre la cavidad de la copa y la bola para que pivote libremente"
      }
    },
