      "parts": ["pot"],
      "estimate": { "base_time": 10, "per_unit": 3, "per_part": 12 }
    },
    {
      "id": "saucer",
      "label": { "en": "Drip Saucer", "es": "Plato de Goteo" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["saucer"],
      "estimate": { "base_time": 7, "per_unit": 2, "per_part": 9 }
    },
    {
      "id": "hanging_pot",
      "label": { "en": "Hanging Pot", "es": "Maceta Colgante" },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": ["hanging_pot"],
      "estimate": { "base_time": 11, "per_unit": 3, "per_part": 13 }
