      "tooltip": { "en": "Number of rows of tools", "es": "Número de filas de herramientas" }
    },
    {
      "id": "pitch", "type": "slider", "default": 25.0, "min": 6.0, "max": 80.0, "step": 1.0,
      "group": "array", "modes": ["block", "wall_rack", "drawer_insert"],
      "label": { "en": "Spacing (mm)", "es": "Separación (mm)" },
      "tooltip": { "en": "Centre-to-centre spacing between tool openings", "es": "Separación centro a centro entre orificios de herramienta" }
