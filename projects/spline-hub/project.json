        "es": "Cuerpo del Cubo"
      }
    },
    {
      "id": "flange",
      "label": {
        "en": "Mounting Flange",
        "es": "Brida de Montaje"
      }
    }
  ],
  "parameters": [
    {
      "id": "bore_type",
      "type": "select",
      "default": "keyway",
      "group": "bore",
      "modes": [
        "keyed_hub",
        "spline_hub",
        "hex_hub"
      ],
      "label": {
        "en": "Bore Type",
        "es": "Tipo de Barreno"
      },
      "tooltip": {
        "en": "keyway: round bore + key slot. involute_spline: a toothed bore. hex: a hexagonal bore. (Each part forces its matching type.)",
        "es": "keyway: barreno redondo + ranura de chaveta. involute_spline: barreno dentado. hex: barreno hexagonal. (Cada pieza fuerza su tipo.)"
      },
      "options": [
        {
          "value": "keyway",
          "label": {
            "en": "Keyway (bore + key slot)",
            "es": "Chavetero (barreno + ranura)"
          }
        },
        {
          "value": "involute_spline",
          "label": {
            "en": "Involute Spline (toothed)",
            "es": "Estriado de Involuta (dentado)"
          }
        },
        {
          "value": "hex",
          "label": {
            "en": "Hex (hexagonal bore)",
            "es": "Hexagonal (barreno hexagonal)"
          }
        }
      ]
    },
    {
      "id": "shaft_dia",
      "type": "slider",
      "default": 8.0,
      "min": 3.0,
      "max": 30.0,
      "step": 0.5,
      "group": "bore",
      "modes": [
        "keyed_hub",
        "spline_hub",
        "hex_hub"
      ],
      "label": {
        "en": "Shaft Diameter (mm)",
        "es": "Diámetro de Eje (mm)"
      },
      "tooltip": {
        "en": "Nominal shaft size: bore diameter (keyway/spline) or across-flats (hex)",
        "es": "Tamaño nominal del eje: diámetro de barreno (chavetero/estría) o entre caras (hex)"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "radial",
        "scale_factor": 1.0
      }
    },
    {
      "id": "clearance",
      "type": "slider",
      "default": 0.2,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05,
      "group": "bore",
      "modes": [
        "keyed_hub",
        "spline_hub",
        "hex_hub"
      ],
      "label": {
        "en": "Fit Clearance (mm)",
        "es": "Holgura de Ajuste (mm)"
      },
      "tooltip": {
        "en": "Added to the bore so the printed hub slides onto the shaft",
        "es": "Se suma al barreno para que el cubo impreso deslice sobre el eje"
      }
    },
    {
      "id": "spline_teeth",
      "type": "slider",
      "default": 6,
      "min": 4,
      "max": 24,
      "step": 1,
      "group": "bore",
      "modes": [
        "spline_hub"
      ],
      "label": {
        "en": "Spline Teeth",
        "es": "Dientes de Estría"
      },
      "tooltip": {
        "en": "Number of teeth around the involute-spline bore (more = smoother load sharing)",
        "es": "Número de dientes alrededor del barreno estriado (más = reparto de carga más suave)"
      }
    },
    {
      "id": "key_width",
      "type": "slider",
      "default": 3.0,
      "min": 1.0,
      "max": 12.0,
      "step": 0.5,
      "group": "bore",
      "modes": [
        "keyed_hub"
      ],
      "label": {
        "en": "Key Width (mm)",
        "es": "Ancho de Chaveta (mm)"
      },
      "tooltip": {
        "en": "Width of the key slot (auto-clamped to the shaft)",
        "es": "Ancho de la ranura de chaveta (limitado al eje)"
      }
    },
    {
      "id": "key_depth",
      "type": "slider",
      "default": 1.8,
      "min": 0.5,
      "max": 6.0,
      "step": 0.1,
      "group": "bore",
      "modes": [
        "keyed_hub"
      ],
      "label": {
        "en": "Key Depth (mm)",
        "es": "Profundidad de Chaveta (mm)"
      },
      "tooltip": {
        "en": "How far the key slot cuts into the hub wall past the bore",
        "es": "Cuánto penetra la ranura en la pared del cubo más allá del barreno"
      }
    },
    {
      "id": "hub_od",
      "type": "slider",
      "default": 0.0,
      "min": 0.0,
      "max": 60.0,
      "step": 1.0,
      "group": "hub",
      "modes": [
        "keyed_hub",
        "spline_hub",
        "hex_hub"
      ],
      "label": {
        "en": "Hub Outer Ø (mm, 0 = auto)",
        "es": "Ø Exterior del Cubo (mm, 0 = auto)"
      },
      "tooltip": {
        "en": "Outer diameter of the hub; 0 auto-sizes to 2.2× shaft + 4 mm",
        "es": "Diámetro exterior del cubo; 0 lo dimensiona a 2.2× eje + 4 mm"
      }
    },
    {
      "id": "length",
      "type": "slider",
      "default": 16.0,
      "min": 5.0,
      "max": 40.0,
      "step": 1.0,
      "group": "hub",
      "modes": [
        "keyed_hub",
        "spline_hub",
        "hex_hub"
      ],
      "label": {
        "en": "Hub Length (mm)",
        "es": "Longitud del Cubo (mm)"
      },
      "tooltip": {
        "en": "Axial length of the hub (longer = more torque grip)",
        "es": "Longitud axial del cubo (más largo = más agarre de par)"
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "z",
        "scale_factor": 1.0
      }
    },
    {
      "id": "flange",
      "type": "checkbox",
      "default": false,
      "group": "flange",
      "modes": [
        "keyed_hub",
        "spline_hub",
        "hex_hub"
