{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yantra4d.com/schemas/graph.schema.json",
  "title": "Yantra4D Graph Document",
  "description": "Node-graph geometry document (.graph.json) compiled by the graph engine into a sandboxed CadQuery script. Version 1.x. The enforcing validator is apps/api/services/engine/graph_engine.py — it additionally checks socket types, cycles, and value ranges; this schema is the public contract for authoring tools and the studio editor. A node param is a literal, a {\"param\": id} reference to a manifest parameter, or an {\"expr\": \"...\"} expression over manifest parameters (the safeFormula dialect: arithmetic, comparison, boolean, ternary; no strings, no function calls; 256 characters and 128 tokens). Only numeric params (float, count) accept those forms; selector, axis and plane stay literal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "nodes", "outputs"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+(\\.\\d+)?$",
      "description": "Graph format version. Major 1 is the only supported line; the renderer rejects anything else. The minor version records which features the document uses: 1.0 is literals and manifest bindings only; 1.1 adds {\"param\": id} and {\"expr\": \"...\"} param values. A 1.0 document stays valid — the addition is backwards compatible — but a document that uses the 1.1 forms should say 1.1 so an older reader fails loudly instead of misreading a param object."
    },
    "units": {
      "type": "string",
      "enum": ["mm"],
      "default": "mm",
      "description": "Model units. v1 supports millimeters only — declared explicitly so future unit support cannot silently rescale existing documents."
    },
    "meta": {
      "type": "object",
      "description": "Free-form authoring metadata. Ignored by the renderer."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/node" }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 50,
      "description": "Map of part id → node id. Part ids correspond to manifest parts[].id; the render selects one via the injected target_part. Every referenced node must produce a solid, not a profile.",
      "additionalProperties": { "$ref": "#/$defs/nodeId" }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "paramId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "description": "A manifest parameter id (parameters[].id)."
    },
    "paramRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["param"],
      "description": "Drive this socket from a manifest parameter, stated from the graph's side. Equivalent to a manifest parameters[].binding pointing here; use one or the other, never both.",
      "properties": { "param": { "$ref": "#/$defs/paramId" } }
    },
    "paramExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expr"],
      "description": "Compute this socket from manifest parameters. The dialect is the one manifest constraints already use (apps/studio/src/lib/safeFormula.ts): arithmetic (+ - * / %), comparison (< <= > >= == != === !==), boolean (&& || !), a ternary (c ? a : b) and parentheses, over numeric literals and manifest parameter identifiers. There are no string literals and no function calls. An unknown identifier or a syntax error is a validation error, never a silent literal.",
      "properties": {
        "expr": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "float": {
      "description": "A number, or a manifest parameter reference or expression that produces one.",
      "anyOf": [
        { "type": "number" },
        { "$ref": "#/$defs/paramRef" },
        { "$ref": "#/$defs/paramExpr" }
      ]
    },
    "count": {
      "description": "A whole number in 1..200, or a manifest parameter reference or expression that produces one. A computed count is rounded and clamped to that range in the generated script.",
      "anyOf": [
        { "type": "integer", "minimum": 1, "maximum": 200 },
        { "$ref": "#/$defs/paramRef" },
        { "$ref": "#/$defs/paramExpr" }
      ]
    },
    "plane": { "type": "string", "enum": ["XY", "XZ", "YZ"] },
    "selector": { "type": "string", "maxLength": 120 },
    "shapeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": { "shape": { "$ref": "#/$defs/nodeId" } }
    },
    "noInputs": { "type": "object", "additionalProperties": false },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": {
          "type": "string",
          "description": "Node types produce either a solid or a profile. Profiles (profile_*) are 2D sketches consumed only by extrude.",
          "enum": [
            "box", "cylinder", "sphere",
            "profile_rect", "profile_circle", "profile_polygon", "extrude",
            "union", "cut", "intersect",
            "translate", "rotate", "mirror",
            "pattern_linear", "pattern_polar",
            "fillet", "chamfer", "shell", "hole"
          ]
        },
        "params": { "type": "object" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nodeId" }
        },
        "meta": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "box" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "w": { "$ref": "#/$defs/float" },
                  "d": { "$ref": "#/$defs/float" },
                  "h": { "$ref": "#/$defs/float" }
                }
              },
              "inputs": { "$ref": "#/$defs/noInputs" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "cylinder" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "r": { "$ref": "#/$defs/float" },
                  "h": { "$ref": "#/$defs/float" }
                }
              },
              "inputs": { "$ref": "#/$defs/noInputs" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "sphere" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": { "r": { "$ref": "#/$defs/float" } }
              },
              "inputs": { "$ref": "#/$defs/noInputs" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "profile_rect" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "w": { "$ref": "#/$defs/float" },
                  "d": { "$ref": "#/$defs/float" },
                  "x": { "$ref": "#/$defs/float" },
                  "y": { "$ref": "#/$defs/float" },
                  "plane": { "$ref": "#/$defs/plane" }
                }
              },
              "inputs": { "$ref": "#/$defs/noInputs" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "profile_circle" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "r": { "$ref": "#/$defs/float" },
                  "x": { "$ref": "#/$defs/float" },
                  "y": { "$ref": "#/$defs/float" },
                  "plane": { "$ref": "#/$defs/plane" }
                }
              },
              "inputs": { "$ref": "#/$defs/noInputs" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "profile_polygon" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "sides": { "$ref": "#/$defs/count" },
                  "diameter": { "$ref": "#/$defs/float" },
                  "x": { "$ref": "#/$defs/float" },
                  "y": { "$ref": "#/$defs/float" },
                  "plane": { "$ref": "#/$defs/plane" }
                }
              },
              "inputs": { "$ref": "#/$defs/noInputs" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "extrude" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": { "height": { "$ref": "#/$defs/float" } }
              },
              "inputs": {
                "type": "object", "additionalProperties": false,
                "required": ["profile"],
                "properties": { "profile": { "$ref": "#/$defs/nodeId" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["union", "cut", "intersect"] } } },
          "then": {
            "properties": {
              "params": { "type": "object", "additionalProperties": false },
              "inputs": {
                "type": "object", "additionalProperties": false,
                "required": ["a", "b"],
                "properties": {
                  "a": { "$ref": "#/$defs/nodeId" },
                  "b": { "$ref": "#/$defs/nodeId" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "translate" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "x": { "$ref": "#/$defs/float" },
                  "y": { "$ref": "#/$defs/float" },
                  "z": { "$ref": "#/$defs/float" }
                }
              },
              "inputs": { "$ref": "#/$defs/shapeInput" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "rotate" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "axis": { "type": "string", "enum": ["x", "y", "z"] },
                  "angle": { "$ref": "#/$defs/float" }
                }
              },
              "inputs": { "$ref": "#/$defs/shapeInput" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "mirror" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": { "plane": { "$ref": "#/$defs/plane" } }
              },
              "inputs": { "$ref": "#/$defs/shapeInput" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pattern_linear" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "count": { "$ref": "#/$defs/count" },
                  "dx": { "$ref": "#/$defs/float" },
                  "dy": { "$ref": "#/$defs/float" },
                  "dz": { "$ref": "#/$defs/float" }
                }
              },
              "inputs": { "$ref": "#/$defs/shapeInput" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pattern_polar" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "count": { "$ref": "#/$defs/count" },
                  "angle": { "$ref": "#/$defs/float" }
                }
              },
              "inputs": { "$ref": "#/$defs/shapeInput" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "fillet" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "edges": { "$ref": "#/$defs/selector" },
                  "radius": { "$ref": "#/$defs/float" }
                }
              },
              "inputs": { "$ref": "#/$defs/shapeInput" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "chamfer" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "edges": { "$ref": "#/$defs/selector" },
                  "distance": { "$ref": "#/$defs/float" }
                }
              },
              "inputs": { "$ref": "#/$defs/shapeInput" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "shell" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "thickness": { "$ref": "#/$defs/float" },
                  "face": { "$ref": "#/$defs/selector" }
                }
              },
              "inputs": { "$ref": "#/$defs/shapeInput" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "hole" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object", "additionalProperties": false,
                "properties": { "diameter": { "$ref": "#/$defs/float" } }
              },
              "inputs": { "$ref": "#/$defs/shapeInput" }
            }
          }
        }
      ]
    }
  }
}
