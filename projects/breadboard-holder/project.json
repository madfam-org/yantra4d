      "label": {
        "en": "Tray + Power Rails",
        "es": "Bandeja + Rieles"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": [
        "rail_base"
      ],
      "estimate": {
        "base_time": 12,
        "per_unit": 2,
        "per_part": 14
      }
    },
    {
      "id": "angled_holder",
      "label": {
        "en": "Angled Easel",
        "es": "Caballete Inclinado"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
