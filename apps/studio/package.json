{
  "name": "@yantra4d/studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.ci.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "cd ../.. && husky apps/studio/.husky",
    "check-manifest-sync": "node -e \"const fs=require('fs'); const src=JSON.parse(fs.readFileSync('../../projects/gridfinity/project.json','utf8')); const dst=JSON.parse(fs.readFileSync('src/config/fallback-manifest.json','utf8')); if(src.project) delete src.project.force_backend; if(JSON.stringify(src)!==JSON.stringify(dst)){ console.error('fallback manifest out of sync with projects/gridfinity/project.json minus project.force_backend'); process.exit(1); } console.log('fallback manifest sync OK')\"",
    "analyze": "ANALYZE=true vite build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@janua/react-sdk": "^0.1.3",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
