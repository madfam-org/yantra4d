{
  "project": {
    "name": "Prop Guard",
    "slug": "prop-guard",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "An impact and finger guard for FPV / RC propellers. A ring or ducted shroud sized to the propeller diameter, carried on arms that bolt to the standard square motor mount pattern (9x9 M2, 16x16 or 19x19 M3). Protects fingers and props on bump-ins; the ducted variant boosts static thrust.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Un protector de impactos y dedos para helices FPV / RC. Un anillo o carcasa entubada dimensionada al diametro de la helice, sobre brazos que se atornillan al patron cuadrado estandar del motor (9x9 M2, 16x16 o 19x19 M3). Protege dedos y helices en golpes; la variante entubada aumenta el empuje.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/prop-guard.webp",
    "difficulty": "intermediate",
    "tags": [
      "drone",
      "fpv",
      "prop-guard",
      "propeller",
      "duct",
      "safety",
      "rc",
      "motor",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
