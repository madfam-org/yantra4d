      "label": { "en": "Insert Pocket Size (mm)", "es": "Tamaño de Cavidad de Inserto (mm)" },
      "tooltip": { "en": "Square pocket size for indexable inserts (lathe insert family)", "es": "Tamaño de cavidad cuadrada para insertos indexables (familia de torno)" }
    },
    {
      "id": "drill_min", "type": "slider", "default": 2.0, "min": 0.6, "max": 20.0, "step": 0.1,
      "group": "tool", "modes": ["block", "wall_rack", "drawer_insert"], "advanced": true,
      "label": { "en": "Smallest Drill (mm)", "es": "Broca Más Pequeña (mm)" },
