{
  "project": {
    "name": "Servo Horn",
    "slug": "servo-horn",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A replacement servo arm with a real splined bore. The bore is cut with N internal teeth matching the servo output spline standard: 24T (~5.8 mm, Futaba / Savox) or 25T (~6.0 mm, Spektrum / Hitec). Linkage holes sit at a chosen radius. Choose a single arm, a double two-sided arm, or a round wheel horn.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Un brazo de servo de repuesto con barreno estriado real. El barreno se corta con N dientes internos que coinciden con el estandar del estriado del servo: 24T (~5.8 mm, Futaba / Savox) o 25T (~6.0 mm, Spektrum / Hitec). Los agujeros de varillaje van a un radio elegido. Elige un brazo simple, un brazo doble o un horn de rueda.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/servo-horn.webp",
    "difficulty": "advanced",
    "tags": ["servo", "horn", "spline", "rc", "linkage", "futaba", "spektrum", "drone", "hyperobject", "commons"],
    "hyperobject": { "is_hyperobject": true },
    "force_backend": true
  },
  "modes": [
    {
      "id": "single_arm",
      "label": { "en": "Single Arm", "es": "Brazo Simple" },
