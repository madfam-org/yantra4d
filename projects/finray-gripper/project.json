      "label": { "en": "Rib / Wall Width (mm)", "es": "Ancho de Nervadura / Pared (mm)" },
      "tooltip": { "en": "Thickness of the flanks and cross-ribs", "es": "Grosor de los flancos y nervaduras cruzadas" }
    },
    {
      "id": "spline", "type": "select", "default": "24T",
      "group": "mount", "modes": ["finray_servo_mount"],
      "label": { "en": "Servo Spline", "es": "Estriado del Servo" },
      "tooltip": { "en": "Servo output spline (24T Futaba/Savox, 25T Spektrum/Hitec)", "es": "Estriado del servo (24T Futaba/Savox, 25T Spektrum/Hitec)" },
      "options": [
        { "value": "24T", "label": { "en": "24T (Futaba / Savox)", "es": "24T (Futaba / Savox)" } },
        { "value": "25T", "label": { "en": "25T (Spektrum / Hitec)", "es": "25T (Spektrum / Hitec)" } }
      ]
    },
    {
      "id": "hub_d", "type": "slider", "default": 12.0, "min": 8.0, "max": 20.0, "step": 0.5,
      "group": "mount", "modes": ["finray_servo_mount"],
      "label": { "en": "Servo Boss Dia (mm)", "es": "Diametro del Cubo del Servo (mm)" },
      "tooltip": { "en": "Outer diameter of the splined servo boss", "es": "Diametro exterior del cubo estriado del servo" }
    },
    {
      "id": "tooth_h", "type": "slider", "default": 0.35, "min": 0.15, "max": 0.8, "step": 0.05,
      "group": "mount", "modes": ["finray_servo_mount"], "advanced": true,
      "label": { "en": "Spline Tooth Depth (mm)", "es": "Profundidad de Diente (mm)" },
      "tooltip": { "en": "Internal spline ridge depth (fit tuning)", "es": "Profundidad de los dientes internos (ajuste de encaje)" }
    },
    {
      "id": "pin_d", "type": "slider", "default": 4.0, "min": 2.0, "max": 8.0, "step": 0.5,
      "group": "mount", "modes": ["finray_finger"], "advanced": true,
      "label": { "en": "Pivot Pin Bore (mm)", "es": "Barreno de Pasador (mm)" },
      "tooltip": { "en": "Cross bore for the hinge pin (modular finger)", "es": "Barreno transversal para el pasador de bisagra (dedo modular)" }
    }
  ],
  "presets": [
    {
      "id": "standard_jaw", "mode": "finray_jaw",
      "label": { "en": "Standard 70 mm Jaw", "es": "Mordaza Estandar 70 mm" },
      "values": { "fin_len": 70, "fin_base": 34, "rib_count": 6 }
    },
    {
      "id": "servo_24t_jaw", "mode": "finray_servo_mount",
      "label": { "en": "Servo 24T Jaw", "es": "Mordaza Servo 24T" },
      "values": { "spline": "24T", "fin_len": 65, "fin_base": 30, "hub_d": 12 }
    },
    {
      "id": "slim_finger", "mode": "finray_finger",
      "label": { "en": "Slim Modular Finger", "es": "Dedo Modular Delgado" },
