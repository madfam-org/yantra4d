  "constraints": [
    {
      "expression": "wall >= 1.2",
      "severity": "error",
      "message": { "en": "Wall must be at least 1.2 mm", "es": "La pared debe ser de al menos 1.2 mm" }
    },
    {
      "expression": "standoff_h <= inner_h - 1",
      "severity": "warning",
      "message": { "en": "Standoff height is close to the interior height", "es": "La altura del standoff se acerca a la altura interior" }
    }
  ],
