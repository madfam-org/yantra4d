---
import type { Translations } from '../lib/i18n';
import { STUDIO_URL } from '../lib/env';

interface Props {
  t?: Translations;
}

const { t } = Astro.props;
const studioUrl = STUDIO_URL;
---

<footer class="border-t border-border py-8 px-6 pb-safe px-safe">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 sm:flex-row">
    <p class="text-sm text-muted-foreground">&copy; {new Date().getFullYear()} {t?.footer.copyright ?? 'Yantra4D. Código abierto bajo AGPLv3.'}</p>
    <nav class="flex flex-wrap justify-center items-center gap-2 sm:gap-4 text-sm text-muted-foreground">
      <a href="https://github.com/madfam-org/yantra4d/tree/main/docs" target="_blank" rel="noopener noreferrer" class="min-h-[44px] inline-flex items-center px-2 hover:text-foreground transition-colors">{t?.footer.docs ?? 'Docs'}</a>
      <a href={studioUrl} class="min-h-[44px] inline-flex items-center px-2 hover:text-foreground transition-colors">{t?.footer.studio ?? 'Studio'}</a>
      <a href="#gallery" class="min-h-[44px] inline-flex items-center px-2 hover:text-foreground transition-colors">{t?.footer.gallery ?? 'Galería'}</a>
      <a href="https://github.com/madfam-org/yantra4d" target="_blank" rel="noopener noreferrer" class="min-h-[44px] inline-flex items-center px-2 hover:text-foreground transition-colors">GitHub</a>
    </nav>
  </div>
</footer>
