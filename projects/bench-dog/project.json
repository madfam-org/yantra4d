  "constraints": [
    {
      "expression": "fit <= 0.8",
      "severity": "warning",
      "message": {
        "en": "Large clearance may let the dog rock in the hole",
        "es": "Una holgura grande puede dejar que el perro se mueva en el agujero"
      }
    },
    {
      "expression": "shank_len >= 20",
      "severity": "error",
      "message": {
        "en": "Shank must be at least 20 mm to grip the hole",
        "es": "El vástago debe ser de al menos 20 mm para sujetar en el agujero"
      }
    }
