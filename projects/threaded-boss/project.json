      "group": "mount", "modes": ["boss", "boss_ribbed"],
      "label": { "en": "Mount", "es": "Montaje" },
      "tooltip": { "en": "standalone: a round flange with fixing holes to glue/screw down. in_wall: a wall/plate segment the boss sits on.", "es": "standalone: brida redonda con orificios para pegar/atornillar. in_wall: segmento de pared/placa sobre el que se apoya el poste." },
      "options": [
        { "value": "standalone", "label": { "en": "Standalone (flange)", "es": "Independiente (brida)" } },
        { "value": "in_wall", "label": { "en": "In-Wall (plate segment)", "es": "En Pared (segmento de placa)" } }
