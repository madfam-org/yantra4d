      "label": {
        "en": "Hole",
        "es": "Ojal"
      }
    },
    {
      "id": "body",
      "label": {
        "en": "Body",
        "es": "Cuerpo"
      }
    }
  ],
  "parameters": [
    {
      "id": "inner_dia",
      "type": "slider",
      "default": 5.0,
      "min": 3.0,
      "max": 12.0,
      "step": 0.5,
      "group": "hole",
      "modes": [
        "set",
        "eyelet",
        "washer"
      ],
      "label": {
        "en": "Finished hole diameter (mm)",
        "es": "Diámetro del ojal terminado (mm)"
      },
      "tooltip": {
        "en": "Clear bore the lace or drawstring passes through (mm).",
        "es": "Paso libre por el que cruza el cordón o la agujeta (mm)."
      }
    },
    {
      "id": "flange_dia",
      "type": "slider",
      "default": 10.0,
      "min": 8.0,
      "max": 24.0,
      "step": 0.5,
      "group": "body",
      "modes": [
        "set",
        "eyelet",
        "washer"
      ],
      "label": {
        "en": "Flange diameter (mm)",
        "es": "Diámetro de la pestaña (mm)"
      },
      "tooltip": {
        "en": "Outer diameter of the visible face flange and of the washer (mm). Raised automatically to clear the barrel wall.",
        "es": "Diámetro exterior de la pestaña visible y de la arandela (mm). Se amplía automáticamente para librar la pared del cuerpo."
      }
    },
    {
      "id": "barrel_h",
      "type": "slider",
      "default": 3.0,
      "min": 1.5,
      "max": 8.0,
      "step": 0.1,
      "group": "body",
      "modes": [
        "set",
        "eyelet"
      ],
      "label": {
        "en": "Barrel height / fabric stack (mm)",
        "es": "Alto del cuerpo / espesor de tela (mm)"
      },
      "tooltip": {
        "en": "Height of the barrel that passes through the fabric — set it to the compressed thickness of the layers plus the roll allowance (mm).",
        "es": "Alto del cuerpo que atraviesa la tela — ajústalo al espesor comprimido de las capas más el margen de remache (mm)."
      }
    },
    {
      "id": "wall",
      "type": "slider",
      "default": 1.2,
      "min": 0.8,
      "max": 2.5,
      "step": 0.1,
      "group": "body",
      "modes": [
        "set",
        "eyelet",
        "washer"
      ],
      "label": {
        "en": "Barrel wall thickness (mm)",
        "es": "Espesor de pared del cuerpo (mm)"
      },
      "tooltip": {
        "en": "Wall of the barrel tube; the barrel outer diameter is the hole diameter plus twice this (mm).",
        "es": "Pared del tubo; el diámetro exterior del cuerpo es el del ojal más dos veces este valor (mm)."
      }
    },
    {
      "id": "washer_t",
      "type": "slider",
      "default": 1.2,
      "min": 0.8,
      "max": 3.0,
      "step": 0.1,
      "group": "body",
      "modes": [
        "set",
        "eyelet",
        "washer"
      ],
      "label": {
        "en": "Flange / washer thickness (mm)",
        "es": "Espesor de pestaña y arandela (mm)"
      },
      "tooltip": {
        "en": "Thickness of the flat face flange and of the matching washer (mm).",
        "es": "Espesor de la pestaña plana y de la arandela correspondiente (mm)."
      }
    }
  ],
