      "label": { "en": "Plate Width (mm)", "es": "Ancho de Placa (mm)" },
      "tooltip": { "en": "Plate width across the switch", "es": "Ancho de la placa a lo ancho del interruptor" }
    },
    {
      "id": "slot_len", "type": "slider", "default": 12.0, "min": 4.0, "max": 30.0, "step": 1,
      "group": "mount", "modes": ["switch_bracket"],
      "label": { "en": "Adjust Slot (mm)", "es": "Ranura de Ajuste (mm)" },
      "tooltip": { "en": "Adjustment slot travel to set the trigger point", "es": "Recorrido de la ranura de ajuste para fijar el punto de disparo" }
    },
    {
      "id": "mount_d", "type": "slider", "default": 5.2, "min": 3.0, "max": 6.5, "step": 0.1,
      "group": "mount", "modes": ["switch_bracket", "extrusion_endstop"],
      "label": { "en": "Frame Bolt (mm)", "es": "Tornillo de Marco (mm)" },
      "tooltip": { "en": "Frame / extrusion bolt clearance (5.2 = M5 T-nut)", "es": "Holgura del tornillo de marco / extrusion (5.2 = tuerca T M5)" }
    },
    {
      "id": "board_len", "type": "slider", "default": 33.0, "min": 16.0, "max": 50.0, "step": 1,
      "group": "plate", "modes": ["optical_endstop"],
      "label": { "en": "Board Length (mm)", "es": "Largo de Placa PCB (mm)" },
      "tooltip": { "en": "Optical-endstop PCB length (hole spacing)", "es": "Largo del PCB del endstop optico (separacion de agujeros)" }
    },
    {
      "id": "board_hole", "type": "slider", "default": 3.2, "min": 2.0, "max": 4.5, "step": 0.1,
      "group": "plate", "modes": ["optical_endstop"], "advanced": true,
      "label": { "en": "Board Bolt (mm)", "es": "Tornillo de PCB (mm)" },
      "tooltip": { "en": "Optical PCB bolt clearance (3.2 = M3)", "es": "Holgura del tornillo del PCB optico (3.2 = M3)" }
    },
    {
      "id": "foot_len", "type": "slider", "default": 28.0, "min": 20.0, "max": 60.0, "step": 1,
      "group": "mount", "modes": ["extrusion_endstop"],
      "label": { "en": "Foot Length (mm)", "es": "Largo de Pie (mm)" },
      "tooltip": { "en": "Extrusion foot length (T-nut holes on 20 mm centres)", "es": "Largo del pie de extrusion (agujeros de tuerca T a 20 mm)" }
    }
  ],
  "presets": [
    {
      "id": "omron_switch", "mode": "switch_bracket",
      "label": { "en": "Omron Microswitch", "es": "Microinterruptor Omron" },
      "values": { "hole_span": 9.5, "switch_hole": 2.2, "slot_len": 14 }
    },
    {
      "id": "optical_board", "mode": "optical_endstop",
      "label": { "en": "Optical PCB", "es": "PCB Optico" },
      "values": { "board_len": 33, "board_hole": 3.2, "plate_w": 14 }
    },
    {
      "id": "endstop_2020", "mode": "extrusion_endstop",
      "label": { "en": "2020 Endstop Foot", "es": "Pie Endstop 2020" },
      "values": { "foot_len": 40, "hole_span": 9.5, "mount_d": 5.2 }
    }
  ],
  "constraints": [
    {
      "expression": "plate_t >= 2",
      "severity": "error",
      "message": { "en": "Plate must be at least 2 mm thick", "es": "La placa debe tener al menos 2 mm de grosor" }
    },
    {
      "expression": "plate_w >= 10",
      "severity": "warning",
      "message": { "en": "A plate under 10 mm wide crowds the switch holes", "es": "Una placa de menos de 10 mm de ancho aprieta los agujeros del interruptor" }
    }
  ],
  "camera_views": [
    { "id": "iso", "label": { "en": "Isometric", "es": "Isometrico" }, "position": [45, 45, 40] },
    { "id": "top", "label": { "en": "Top", "es": "Superior" }, "position": [0, 0, 70] },
    { "id": "front", "label": { "en": "Front", "es": "Frontal" }, "position": [0, -70, 12] }
  ],
  "export_formats": ["stl", "3mf", "step", "glb", "gltf", "obj"],
  "estimate_constants": {
    "base_time": 11, "per_unit": 3, "per_part": 13,
    "fn_factor": 32, "wasm_multiplier": 4, "warning_threshold_seconds": 90
  },
  "hyperobject": {
    "domain": "industrial",
    "cdg_interfaces": [
      {
        "id": "microswitch_mount",
        "label": { "en": "Microswitch Mount", "es": "Montaje de Microinterruptor" },
