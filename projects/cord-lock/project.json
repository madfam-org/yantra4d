      "id": "spring_toggle",
      "label": {
        "en": "Spring Toggle",
        "es": "Tope de Resorte"
      },
      "scad_file": "main.py",
      "cq_file": "main.py",
      "parts": [
        "spring_toggle"
      ],
      "estimate": {
        "base_time": 7,
