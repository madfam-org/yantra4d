---
import type { Translations } from '../lib/i18n';
import { STUDIO_URL } from '../lib/env';

interface Props {
  t?: Translations;
}

const { t } = Astro.props;
const studioUrl = STUDIO_URL;
---

<footer class="border-t border-border py-8 px-6 pb-safe px-safe">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-4">
    <div class="flex flex-col sm:flex-row items-center justify-between w-full gap-4">
      <p class="text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} Yantra4D. By <a href="https://madfam.io" class="hover:text-foreground transition-colors">Innovaciones MADFAM</a>.
      </p>
      <nav class="flex flex-wrap justify-center items-center gap-2 sm:gap-4 text-sm text-muted-foreground">
        <a href="#gallery" class="min-h-[44px] inline-flex items-center px-2 hover:text-foreground transition-colors">{t?.nav.gallery ?? 'Gallery'}</a>
        <a href="https://github.com/madfam-org/yantra4d/tree/main/docs" target="_blank" rel="noopener noreferrer" class="min-h-[44px] inline-flex items-center px-2 hover:text-foreground transition-colors">{t?.footer.docs ?? 'Docs'}</a>
        <a href={studioUrl} class="min-h-[44px] inline-flex items-center px-2 hover:text-foreground transition-colors">{t?.footer.studio ?? 'Studio'}</a>
        <a href="https://madfam.io/privacy" class="min-h-[44px] inline-flex items-center px-2 hover:text-foreground transition-colors">Privacy</a>
        <a href="https://madfam.io/terms" class="min-h-[44px] inline-flex items-center px-2 hover:text-foreground transition-colors">Terms</a>
        <a href="https://status.madfam.io" class="min-h-[44px] inline-flex items-center px-2 hover:text-foreground transition-colors">Status</a>
        <a href="https://github.com/madfam-org/yantra4d" target="_blank" rel="noopener noreferrer" class="min-h-[44px] inline-flex items-center px-2 hover:text-foreground transition-colors">GitHub</a>
      </nav>
    </div>
  </div>
</footer>
