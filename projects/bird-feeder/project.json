{
  "project": {
    "name": "Bottle-Fed Bird Feeder",
    "slug": "bird-feeder",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "Turns a discarded PET soda bottle into a gravity bird / seed feeder. The feeder cap screws onto a standard PCO-1881 bottle neck; seed flows down through ports onto a catch tray with perches. Threaded cap, tray base, or a standalone tube feeder that needs no bottle.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Convierte una botella PET desechada en un comedero de gravedad para aves o semillas. La tapa se enrosca en un cuello de botella PCO-1881 estándar; la semilla baja por los puertos hasta una bandeja con perchas. Tapa roscada, base con bandeja, o un comedero de tubo autónomo sin botella.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/bird-feeder.webp",
    "difficulty": "intermediate",
    "tags": [
      "bird",
      "feeder",
      "seed",
      "bottle",
      "pco-1881",
      "garden",
      "wildlife",
      "hyperobject",
      "commons"
    ],
