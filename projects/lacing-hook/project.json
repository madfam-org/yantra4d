  "hyperobject": {
    "domain": "wearable",
    "cdg_interfaces": [
      {
        "id": "sew_plate",
        "label": {
          "en": "Sew / Rivet Plate",
          "es": "Placa de costura y remache"
        },
        "geometry_type": "flange",
        "standard": "internal",
        "parameters": [
