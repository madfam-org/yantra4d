      },
      "values": {
        "cols": 6,
        "cell_top": 30,
        "depth": 45
      }
    }
  ],
  "constraints": [
    {
      "expression": "cell_taper < cell_top",
      "severity": "error",
      "message": {
        "en": "Taper cannot exceed the cell top width",
        "es": "La conicidad no puede exceder el ancho superior de la celda"
      }
    },
    {
      "expression": "wall >= 1.2",
      "severity": "warning",
      "message": {
        "en": "Very thin walls between cells may be fragile",
        "es": "Paredes muy delgadas entre celdas pueden ser frágiles"
      }
    }
  ],
