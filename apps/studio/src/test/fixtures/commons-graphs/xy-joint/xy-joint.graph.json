{
  "version": "1.1.0",
  "units": "mm",
  "meta": {
    "title": "XY Joint (graph twin)",
    "notes": "Golden twin of main.py (graph format 1.1): the same parameters, the same derivations and the same operations in the same order. main.py stays the oracle; y4d-spec --parity compares the two at the defaults and at every preset. Clamps are min/max pairs spelled as ternaries. The script's `if mirrored:` branches are ternaries (the boss under the raised element) and a select (the seat ring under the low idler); the right-hand joint is body.mirror('YZ') as reflect YZ chosen by select on mirrored. The D back-slot screw runs along +Y: a z cylinder laid down by rotate x -90 and spun by rotate y -90, which puts the B-rep seam where makeCylinder puts it (x direction +Z). Cited facts as main.py: MGN9H W 20, B 15, C 16 (HIWIN MG); GT2 20T pitch diameter 12.7324 (SDP/SI Table 33); F695 OD 13 (NSK) plus the 0.506 back-side offset (1.52 - 0.76 - 0.254: Pfeifer 2MR, SDP/SI Table 4); 2020 profile 20, lip 2 (MISUMI HFS5); rail setback 15 (guide p. 101); M3 head 5.5 (ISO 4762); pilot 4.2 (MISUMI). Every other number is a labelled convention of main.py."
  },
  "parameters": {
    "idler_width": {"default": 9.0},
    "d_end": {"default": 11.0},
    "mirrored": {"default": false}
  },
  "derived": [
    {"id": "iw_cap", "expr": "idler_width < 10 ? idler_width : 10"},
    {"id": "iw", "expr": "6 > iw_cap ? 6 : iw_cap"},
    {"id": "de_cap", "expr": "d_end < 13 ? d_end : 13"},
    {"id": "de", "expr": "8 > de_cap ? 8 : de_cap"},
    {"id": "z_stack", "expr": "mirrored ? 60 : 44"},
    {"id": "z_idler", "expr": "mirrored ? 44 : 60"},
    {"id": "idler_r", "expr": "12.7324 / 2"},
    {"id": "stack_r", "expr": "13 / 2 + (1.52 - 0.76 - 0.254)"},
    {"id": "y_stack", "expr": "-stack_r"},
    {"id": "y_idler", "expr": "idler_r"},
    {"id": "d_end_x", "expr": "-de"},
    {"id": "d_held_x", "expr": "d_end_x + 15"},
    {"id": "held_in", "expr": "d_held_x - 0.5"},
    {"id": "boss_x", "expr": "mirrored ? -2 : -3"},
    {"id": "boss_y", "expr": "mirrored ? y_stack : y_idler"},
    {"id": "boss_top", "expr": "mirrored ? z_stack - 10 / 2 : z_idler - iw / 2"},
    {"id": "stack_top", "expr": "z_stack + 10 / 2"},
    {"id": "idler_top", "expr": "z_idler + iw / 2"},
    {"id": "post_top", "expr": "(stack_top > idler_top ? stack_top : idler_top) + 3"},
    {"id": "post_x1", "expr": "d_end_x - 0.5 < -12.5 ? d_end_x - 0.5 : -12.5"},
    {"id": "stack_floor", "expr": "z_stack - 10 / 2"},
    {"id": "idler_floor", "expr": "z_idler - iw / 2"},
    {"id": "stack_tip", "expr": "stack_top + 3 - 16"},
    {"id": "idler_tip", "expr": "idler_top + 3 - 16"}
  ],
  "nodes": [
    {"id": "base_blank", "type": "box", "params": {"w": 28.0, "d": 36.0, "h": 8.0}},
    {"id": "base", "type": "translate", "inputs": {"shape": "base_blank"}, "params": {"x": -4.0, "z": 4.0}},
    {"id": "saddle_blank", "type": "box", "params": {"w": {"expr": "held_in - (d_end_x - 0.5)"}, "d": 10.0, "h": 4.5}},
    {"id": "saddle", "type": "translate", "inputs": {"shape": "saddle_blank"}, "params": {"x": {"expr": "((d_end_x - 0.5) + (held_in)) / 2"}, "z": 9.75}},
    {"id": "body_1", "type": "union", "inputs": {"a": "base", "b": "saddle"}},
    {"id": "tongue_blank", "type": "box", "params": {"w": {"expr": "held_in - (d_end_x + 1)"}, "d": 5.8, "h": 2.5}},
    {"id": "tongue", "type": "translate", "inputs": {"shape": "tongue_blank"}, "params": {"x": {"expr": "((d_end_x + 1) + (held_in)) / 2"}, "z": 12.75}},
    {"id": "body_2", "type": "union", "inputs": {"a": "body_1", "b": "tongue"}},
    {"id": "outboard_wall_blank", "type": "box", "params": {"w": {"expr": "d_end_x - 0.5 - (-18.0)"}, "d": 28.0, "h": 25.5}},
    {"id": "outboard_wall", "type": "translate", "inputs": {"shape": "outboard_wall_blank"}, "params": {"x": {"expr": "((-18.0) + (d_end_x - 0.5)) / 2"}, "z": 20.25}},
    {"id": "body_3", "type": "union", "inputs": {"a": "body_2", "b": "outboard_wall"}},
    {"id": "back_wall_blank", "type": "box", "params": {"w": {"expr": "held_in - (-18.0)"}, "d": 4.5, "h": 25.5}},
    {"id": "back_wall", "type": "translate", "inputs": {"shape": "back_wall_blank"}, "params": {"x": {"expr": "((-18.0) + (held_in)) / 2"}, "y": 12.25, "z": 20.25}},
    {"id": "body_4", "type": "union", "inputs": {"a": "body_3", "b": "back_wall"}},
    {"id": "front_wall_blank", "type": "box", "params": {"w": {"expr": "held_in - (-18.0)"}, "d": 4.5, "h": 25.5}},
    {"id": "front_wall", "type": "translate", "inputs": {"shape": "front_wall_blank"}, "params": {"x": {"expr": "((-18.0) + (held_in)) / 2"}, "y": -12.25, "z": 20.25}},
    {"id": "body_5", "type": "union", "inputs": {"a": "body_4", "b": "front_wall"}},
    {"id": "shelf_blank", "type": "box", "params": {"w": 23.5, "d": 33.0, "h": 6.5}},
    {"id": "shelf", "type": "translate", "inputs": {"shape": "shelf_blank"}, "params": {"x": -6.25, "y": -0.5, "z": 35.75}},
    {"id": "body_6", "type": "union", "inputs": {"a": "body_5", "b": "shelf"}},
    {"id": "boss_blank", "type": "cylinder", "params": {"r": 4.5, "h": {"expr": "boss_top - 39 + 0.5"}}},
    {"id": "boss", "type": "translate", "inputs": {"shape": "boss_blank"}, "params": {"x": {"expr": "boss_x"}, "y": {"expr": "boss_y"}, "z": {"expr": "(38.5) + (boss_top - 39 + 0.5) / 2"}}},
    {"id": "body_7", "type": "union", "inputs": {"a": "body_6", "b": "boss"}},
    {"id": "seat_ring_blank", "type": "cylinder", "params": {"r": 4.5, "h": {"expr": "z_idler - iw / 2 - 39 + 0.5"}}},
    {"id": "seat_ring", "type": "translate", "inputs": {"shape": "seat_ring_blank"}, "params": {"x": -3.0, "y": {"expr": "y_idler"}, "z": {"expr": "(38.5) + (z_idler - iw / 2 - 39 + 0.5) / 2"}}},
    {"id": "body_7_seated", "type": "union", "inputs": {"a": "body_7", "b": "seat_ring"}},
    {"id": "body_8", "type": "select", "inputs": {"if_true": "body_7_seated", "if_false": "body_7"}, "params": {"when": {"expr": "mirrored"}}},
    {"id": "m3_clear_1_blank", "type": "cylinder", "params": {"r": {"expr": "(3 + 2 * 0.2) / 2"}, "h": 10.0}},
    {"id": "m3_clear_1", "type": "translate", "inputs": {"shape": "m3_clear_1_blank"}, "params": {"x": -7.5, "y": -8.0, "z": 4.0}},
    {"id": "body_9", "type": "cut", "inputs": {"a": "body_8", "b": "m3_clear_1"}},
    {"id": "m3_counterbore_1_blank", "type": "cylinder", "params": {"r": 3.0, "h": 4.0}},
    {"id": "m3_counterbore_1", "type": "translate", "inputs": {"shape": "m3_counterbore_1_blank"}, "params": {"x": -7.5, "y": -8.0, "z": 7.0}},
    {"id": "body_10", "type": "cut", "inputs": {"a": "body_9", "b": "m3_counterbore_1"}},
    {"id": "m3_clear_2_blank", "type": "cylinder", "params": {"r": {"expr": "(3 + 2 * 0.2) / 2"}, "h": 10.0}},
    {"id": "m3_clear_2", "type": "translate", "inputs": {"shape": "m3_clear_2_blank"}, "params": {"x": -7.5, "y": 8.0, "z": 4.0}},
    {"id": "body_11", "type": "cut", "inputs": {"a": "body_10", "b": "m3_clear_2"}},
    {"id": "m3_counterbore_2_blank", "type": "cylinder", "params": {"r": 3.0, "h": 4.0}},
    {"id": "m3_counterbore_2", "type": "translate", "inputs": {"shape": "m3_counterbore_2_blank"}, "params": {"x": -7.5, "y": 8.0, "z": 7.0}},
    {"id": "body_12", "type": "cut", "inputs": {"a": "body_11", "b": "m3_counterbore_2"}},
    {"id": "m3_clear_3_blank", "type": "cylinder", "params": {"r": {"expr": "(3 + 2 * 0.2) / 2"}, "h": 10.0}},
    {"id": "m3_clear_3", "type": "translate", "inputs": {"shape": "m3_clear_3_blank"}, "params": {"x": 7.5, "y": -8.0, "z": 4.0}},
    {"id": "body_13", "type": "cut", "inputs": {"a": "body_12", "b": "m3_clear_3"}},
    {"id": "m3_counterbore_3_blank", "type": "cylinder", "params": {"r": 3.0, "h": 4.0}},
    {"id": "m3_counterbore_3", "type": "translate", "inputs": {"shape": "m3_counterbore_3_blank"}, "params": {"x": 7.5, "y": -8.0, "z": 7.0}},
    {"id": "body_14", "type": "cut", "inputs": {"a": "body_13", "b": "m3_counterbore_3"}},
    {"id": "m3_clear_4_blank", "type": "cylinder", "params": {"r": {"expr": "(3 + 2 * 0.2) / 2"}, "h": 10.0}},
    {"id": "m3_clear_4", "type": "translate", "inputs": {"shape": "m3_clear_4_blank"}, "params": {"x": 7.5, "y": 8.0, "z": 4.0}},
    {"id": "body_15", "type": "cut", "inputs": {"a": "body_14", "b": "m3_clear_4"}},
    {"id": "m3_counterbore_4_blank", "type": "cylinder", "params": {"r": 3.0, "h": 4.0}},
    {"id": "m3_counterbore_4", "type": "translate", "inputs": {"shape": "m3_counterbore_4_blank"}, "params": {"x": 7.5, "y": 8.0, "z": 7.0}},
    {"id": "body_16", "type": "cut", "inputs": {"a": "body_15", "b": "m3_counterbore_4"}},
    {"id": "d_screw_blank", "type": "cylinder", "params": {"r": 2.75, "h": 6.5}},
    {"id": "d_screw_lay", "type": "rotate", "inputs": {"shape": "d_screw_blank"}, "params": {"axis": "x", "angle": -90.0}},
    {"id": "d_screw_spin", "type": "rotate", "inputs": {"shape": "d_screw_lay"}, "params": {"axis": "y", "angle": -90.0}},
    {"id": "d_screw", "type": "translate", "inputs": {"shape": "d_screw_spin"}, "params": {"x": {"expr": "d_end_x + 10"}, "y": 12.25, "z": 22.0}},
    {"id": "body_17", "type": "cut", "inputs": {"a": "body_16", "b": "d_screw"}},
    {"id": "post_blank", "type": "box", "params": {"w": {"expr": "post_x1 - (-18.0)"}, "d": 24.0, "h": {"expr": "post_top - (38.5)"}}},
    {"id": "post", "type": "translate", "inputs": {"shape": "post_blank"}, "params": {"x": {"expr": "((-18.0) + (post_x1)) / 2"}, "z": {"expr": "((38.5) + (post_top)) / 2"}}},
    {"id": "body_18", "type": "union", "inputs": {"a": "body_17", "b": "post"}},
    {"id": "stack_roof_arm_blank", "type": "box", "params": {"w": 15.5, "d": {"expr": "y_stack + 3 - (y_stack - 3)"}, "h": {"expr": "stack_top + 3 - (stack_top)"}}},
    {"id": "stack_roof_arm", "type": "translate", "inputs": {"shape": "stack_roof_arm_blank"}, "params": {"x": -9.75, "y": {"expr": "((y_stack - 3) + (y_stack + 3)) / 2"}, "z": {"expr": "((stack_top) + (stack_top + 3)) / 2"}}},
    {"id": "body_19", "type": "union", "inputs": {"a": "body_18", "b": "stack_roof_arm"}},
    {"id": "stack_roof_pad_blank", "type": "cylinder", "params": {"r": 5.0, "h": 3.0}},
    {"id": "stack_roof_pad", "type": "translate", "inputs": {"shape": "stack_roof_pad_blank"}, "params": {"x": -2.0, "y": {"expr": "y_stack"}, "z": {"expr": "(stack_top) + (3.0) / 2"}}},
    {"id": "body_20", "type": "union", "inputs": {"a": "body_19", "b": "stack_roof_pad"}},
    {"id": "idler_roof_arm_blank", "type": "box", "params": {"w": 14.5, "d": {"expr": "y_idler + 3 - (y_idler - 3)"}, "h": {"expr": "idler_top + 3 - (idler_top)"}}},
    {"id": "idler_roof_arm", "type": "translate", "inputs": {"shape": "idler_roof_arm_blank"}, "params": {"x": -10.25, "y": {"expr": "((y_idler - 3) + (y_idler + 3)) / 2"}, "z": {"expr": "((idler_top) + (idler_top + 3)) / 2"}}},
    {"id": "body_21", "type": "union", "inputs": {"a": "body_20", "b": "idler_roof_arm"}},
    {"id": "idler_roof_pad_blank", "type": "cylinder", "params": {"r": 5.0, "h": 3.0}},
    {"id": "idler_roof_pad", "type": "translate", "inputs": {"shape": "idler_roof_pad_blank"}, "params": {"x": -3.0, "y": {"expr": "y_idler"}, "z": {"expr": "(idler_top) + (3.0) / 2"}}},
    {"id": "body_22", "type": "union", "inputs": {"a": "body_21", "b": "idler_roof_pad"}},
    {"id": "stack_axle_clear_blank", "type": "cylinder", "params": {"r": 2.75, "h": 4.0}},
    {"id": "stack_axle_clear", "type": "translate", "inputs": {"shape": "stack_axle_clear_blank"}, "params": {"x": -2.0, "y": {"expr": "y_stack"}, "z": {"expr": "(stack_top - 0.5) + (4.0) / 2"}}},
    {"id": "body_23", "type": "cut", "inputs": {"a": "body_22", "b": "stack_axle_clear"}},
    {"id": "stack_axle_pilot_blank", "type": "cylinder", "params": {"r": 2.1, "h": {"expr": "stack_floor - stack_tip + 1"}}},
    {"id": "stack_axle_pilot", "type": "translate", "inputs": {"shape": "stack_axle_pilot_blank"}, "params": {"x": -2.0, "y": {"expr": "y_stack"}, "z": {"expr": "(stack_tip - 0.5) + (stack_floor - stack_tip + 1) / 2"}}},
    {"id": "body_24", "type": "cut", "inputs": {"a": "body_23", "b": "stack_axle_pilot"}},
    {"id": "idler_axle_clear_blank", "type": "cylinder", "params": {"r": 2.75, "h": 4.0}},
    {"id": "idler_axle_clear", "type": "translate", "inputs": {"shape": "idler_axle_clear_blank"}, "params": {"x": -3.0, "y": {"expr": "y_idler"}, "z": {"expr": "(idler_top - 0.5) + (4.0) / 2"}}},
    {"id": "body_25", "type": "cut", "inputs": {"a": "body_24", "b": "idler_axle_clear"}},
    {"id": "idler_axle_pilot_blank", "type": "cylinder", "params": {"r": 2.1, "h": {"expr": "idler_floor - idler_tip + 1"}}},
    {"id": "idler_axle_pilot", "type": "translate", "inputs": {"shape": "idler_axle_pilot_blank"}, "params": {"x": -3.0, "y": {"expr": "y_idler"}, "z": {"expr": "(idler_tip - 0.5) + (idler_floor - idler_tip + 1) / 2"}}},
    {"id": "body_26", "type": "cut", "inputs": {"a": "body_25", "b": "idler_axle_pilot"}},
    {"id": "right_hand", "type": "reflect", "inputs": {"shape": "body_26"}, "params": {"plane": "YZ"}},
    {"id": "xy_joint_part", "type": "select", "inputs": {"if_true": "right_hand", "if_false": "body_26"}, "params": {"when": {"expr": "mirrored"}}}
  ],
  "outputs": {"xy_joint": "xy_joint_part"}
}
