      "label": {
        "en": "Shoe Type",
        "es": "Tipo de Zapata"
      },
      "tooltip": {
        "en": "Male foot (slides into a socket) or female slot (receives a foot)",
        "es": "Pie macho (entra en un receptáculo) o ranura hembra (recibe un pie)"
      },
      "options": [
        {
          "value": "male-shoe",
          "label": {
            "en": "Male Shoe",
            "es": "Zapata Macho"
          }
        },
        {
          "value": "female-shoe-slot",
          "label": {
            "en": "Female Shoe Slot",
            "es": "Ranura Hembra"
          }
        }
      ]
    },
    {
