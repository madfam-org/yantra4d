{
  "project": {
    "name": "Cord-Lock / Toggle Stopper",
    "slug": "cord-lock",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A small toggle that locks drawstrings and cords on apparel, bags, and gear. Single-piece, print-in-place designs: a spring toggle with a printed pincher, a friction bead, or a squeeze cleat. Sized to the cord and holds 1 or 2 cords.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Un pequeño tope que bloquea cordones y cuerdas en ropa, bolsas y equipo. Diseños de una sola pieza impresos en el sitio: un tope de resorte con pinza impresa, una cuenta de fricción o una cuña de apriete. Dimensionado al cordón y sostiene 1 o 2 cordones.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/cord-lock.webp",
    "difficulty": "beginner",
    "tags": [
      "cord-lock",
      "toggle",
      "drawstring",
      "stopper",
      "cleat",
      "apparel",
      "print-in-place",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
  "modes": [
