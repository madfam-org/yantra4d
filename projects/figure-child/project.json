  "constraints": [
    {
      "expression": "hip_girth >= waist_girth * 0.85",
      "message": {
        "en": "A hip much smaller than the waist makes an unnatural seat curve.",
        "es": "Una cadera mucho menor que la cintura crea una curva de asiento poco natural."
      }
    },
    {
      "expression": "knee_girth <= thigh_girth",
      "message": {
        "en": "The knee is narrower than the thigh on every child body.",
        "es": "La rodilla es más estrecha que el muslo en todo cuerpo infantil."
      }
    },
    {
      "expression": "ankle_girth <= knee_girth",
      "message": {
        "en": "The ankle is narrower than the knee on every child body.",
        "es": "El tobillo es más estrecho que la rodilla en todo cuerpo infantil."
      }
