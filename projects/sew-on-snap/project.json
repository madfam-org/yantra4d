    },
    {
      "id": "sewing",
      "label": {
        "en": "Sewing",
        "es": "Costura"
      }
    }
  ],
  "parameters": [
    {
      "id": "snap_dia",
      "type": "slider",
      "default": 12.0,
      "min": 7.0,
      "max": 30.0,
      "step": 0.5,
      "group": "disc",
      "modes": [
        "set",
        "stud",
        "socket"
      ],
      "label": {
        "en": "Snap disc diameter (mm)",
        "es": "Diámetro del disco (mm)"
      },
      "tooltip": {
        "en": "Outside diameter of each snap disc (mm). Sizes 9-12 mm suit bodysuit plackets; 15-20 mm suit varsity plackets and outerwear.",
        "es": "Diámetro exterior de cada disco del broche (mm). De 9 a 12 mm para pañaleros; de 15 a 20 mm para carteras de chamarra y abrigo."
      }
    },
    {
      "id": "disc_t",
      "type": "slider",
      "default": 2.0,
      "min": 1.2,
      "max": 4.0,
      "step": 0.1,
      "group": "disc",
      "modes": [
        "set",
        "stud",
        "socket"
      ],
      "label": {
        "en": "Disc thickness (mm)",
        "es": "Espesor del disco (mm)"
      },
      "tooltip": {
        "en": "Thickness of the flat disc body (mm). Thinner discs sit flatter under a placket; thicker discs resist peeling open.",
        "es": "Espesor del cuerpo plano del disco (mm). Los discos delgados quedan más planos bajo la cartera; los gruesos resisten mejor el despegue."
      }
    },
    {
      "id": "stud_dia",
      "type": "slider",
      "default": 4.0,
      "min": 2.5,
      "max": 8.0,
      "step": 0.1,
      "group": "engagement",
      "modes": [
        "set",
        "stud",
        "socket"
      ],
      "label": {
        "en": "Stud diameter (mm)",
        "es": "Diámetro del macho (mm)"
      },
      "tooltip": {
        "en": "Diameter of the central stud boss (mm). Clamped to at most the disc diameter minus 4 mm so a sewing rim always remains.",
        "es": "Diámetro del saliente central macho (mm). Se limita al diámetro del disco menos 4 mm para conservar siempre un borde de costura."
      }
    },
    {
      "id": "engage_clear",
      "type": "slider",
      "default": 0.3,
      "min": 0.1,
      "max": 0.6,
      "step": 0.05,
      "group": "engagement",
      "modes": [
        "set",
        "stud",
        "socket"
      ],
      "label": {
        "en": "Engagement clearance (mm)",
        "es": "Holgura de acoplamiento (mm)"
      },
      "tooltip": {
        "en": "Diametral gap between stud and socket (mm). Smaller values snap harder; increase for stiff or shrink-prone filaments.",
        "es": "Holgura diametral entre macho y hembra (mm). Un valor menor cierra con más fuerza; auméntalo para filamentos rígidos o que contraen."
      }
    },
    {
      "id": "sew_holes",
      "type": "slider",
      "default": 4,
      "min": 3,
      "max": 8,
      "step": 1,
      "group": "sewing",
      "modes": [
        "set",
        "stud",
        "socket"
      ],
      "label": {
        "en": "Sew holes (count)",
        "es": "Ojales de costura (cantidad)"
      },
      "tooltip": {
        "en": "Number of stitch holes around the rim. Four is the garment-industry standard for a sew-on snap.",
        "es": "Cantidad de ojales de costura alrededor del borde. Cuatro es el estándar de la industria para un broche de coser."
      }
    },
    {
      "id": "hole_dia",
      "type": "slider",
      "default": 1.5,
      "min": 1.0,
      "max": 2.5,
      "step": 0.1,
      "group": "sewing",
      "modes": [
        "set",
        "stud",
        "socket"
      ],
      "label": {
        "en": "Sew hole diameter (mm)",
        "es": "Diámetro del ojal (mm)"
      },
      "tooltip": {
        "en": "Diameter of each stitch hole (mm). 1.5 mm passes a doubled all-purpose thread on a hand needle.",
        "es": "Diámetro de cada ojal de costura (mm). 1.5 mm deja pasar hilo multiuso doble con aguja de mano."
      }
    }
  ],
  "presets": [
