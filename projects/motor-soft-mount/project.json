{
  "project": {
    "name": "Motor Soft-Mount Pod",
    "slug": "motor-soft-mount",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "A vibration-isolating motor pod for FPV / RC brushless motors. Carries the standard square motor bolt pattern (9x9 M2, 16x16 or 19x19 M3) and clamps to the frame arm. Soft mode adds compliant flex slots (print in TPU) to damp airframe vibration; rigid and landing-skid variants included.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Un soporte de motor aislante de vibraciones para motores brushless FPV / RC. Lleva el patron cuadrado estandar de tornillos (9x9 M2, 16x16 o 19x19 M3) y se sujeta al brazo del cuadro. El modo blando agrega ranuras flexibles (imprimir en TPU) para amortiguar la vibracion; se incluyen variantes rigida y con pata de aterrizaje.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/motor-soft-mount.webp",
    "difficulty": "intermediate",
    "tags": [
      "drone",
      "fpv",
      "motor",
      "soft-mount",
      "vibration",
      "brushless",
      "rc",
      "tpu",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
