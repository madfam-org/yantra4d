{
  "project": {
    "name": "Featherboard",
    "slug": "featherboard",
    "version": "1.0.0",
    "engine": "cadquery",
    "description": {
      "en": "An anti-kickback featherboard: a bank of angled, flexible fingers that press a workpiece against a fence or table and act as a one-way ratchet. Choose a T-slot / track version, a 3/4in miter-slot bar version, or a clamp-on version. Sized by finger count, kerf and rake angle.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Un peine anti-retroceso: un banco de dedos flexibles en ángulo que presionan la pieza contra un tope o mesa y actúan como trinquete de un solo sentido. Elige versión para ranura en T / riel, versión con barra para ranura de inglete de 3/4in, o versión de sujeción con prensa. Se dimensiona por número de dedos, kerf y ángulo de ataque.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/featherboard.webp",
    "difficulty": "intermediate",
    "tags": [
      "featherboard",
      "safety",
      "anti-kickback",
      "table-saw",
      "router",
      "fence",
      "woodworking",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
  "modes": [
