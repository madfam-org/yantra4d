  "presets": [
    {
      "id": "elm327_cradle", "mode": "dongle_holder",
      "label": { "en": "ELM327 Dongle Cradle", "es": "Cuna de Dongle ELM327" },
      "values": { "dongle_w": 48, "dongle_h": 25, "dongle_d": 24 }
    },
    {
      "id": "mixed_fuse_box", "mode": "fuse_organizer",
      "label": { "en": "ATO + Mini Fuse Box", "es": "Caja de Fusibles ATO + Mini" },
      "values": { "ato_count": 4, "mini_count": 4 }
    },
    {
      "id": "obd_relocate", "mode": "obd_bracket",
