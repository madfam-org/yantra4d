      "tooltip": { "en": "V-groove width at the rim (auto-clamped to the included angle)", "es": "Ancho de la ranura en V en el aro (limitado al ángulo incluido)" }
    },
    {
      "id": "groove_depth", "type": "slider", "default": 11.0, "min": 2.0, "max": 25.0, "step": 0.5,
